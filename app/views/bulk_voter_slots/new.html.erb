<div class="space-y-6">
  <div class="space-y-2">
    <p><%= link_to "투표자 그룹으로 돌아가기", voter_group_path(@voter_group), class: "text-sm font-medium text-stone-600 underline" %></p>

    <h1 class="text-2xl font-semibold">여러 명 추가</h1>
  </div>

  <% if @errors.present? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-4 text-red-800">
      <h2 class="font-medium">학생 명단을 저장할 수 없습니다.</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% @errors.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
    <% if @count.blank? %>
      <%= form_with url: new_voter_group_bulk_voter_slots_path(@voter_group), method: :get, class: "space-y-4" do |form| %>
        <div class="space-y-1">
          <%= form.label :count, "추가할 학생 수", class: "text-sm font-medium text-stone-700" %>
          <%= form.number_field :count,
                                min: 1,
                                max: BulkVoterSlotsController::MAX_COUNT,
                                class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
        </div>

        <%= form.submit "입력칸 만들기", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
      <% end %>
    <% else %>
      <%= form_with url: voter_group_bulk_voter_slots_path(@voter_group), class: "space-y-4" do |form| %>
        <% start_number = @voter_group.voter_slots.maximum(:number).to_i + 1 %>

        <div class="space-y-3">
          <% @count.times do |index| %>
            <div class="space-y-1">
              <%= label_tag "bulk_voter_slots_names_#{index}", "#{start_number + index}번", class: "text-sm font-medium text-stone-700" %>
              <%= text_field_tag "bulk_voter_slots[names][]",
                                 @names&.[](index),
                                 id: "bulk_voter_slots_names_#{index}",
                                 class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
            </div>
          <% end %>
        </div>

        <%= form.submit "학생 명단 저장", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
      <% end %>
    <% end %>
  </div>
</div>
