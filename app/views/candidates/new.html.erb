<h1>후보자 추가</h1>

<p><%= link_to "선거로 돌아가기", election_path(@election) %></p>

<% if @candidate.errors.any? %>
  <h2>후보자를 추가할 수 없습니다.</h2>
  <ul>
    <% @candidate.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<p><%= @candidate.number %>번 후보를 추가합니다.</p>

<%= form_with model: [@election, @candidate] do |form| %>
  <div>
    <%= form.label :name, "이름" %>
    <%= form.text_field :name %>
  </div>

  <%= form.submit "후보자 추가" %>
<% end %>
