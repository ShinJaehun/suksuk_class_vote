<div class="space-y-6">
  <div class="space-y-2">
    <p><%= link_to "선거로 돌아가기", election_path(@election), class: "text-sm font-medium text-stone-600 underline" %></p>

    <h1 class="text-2xl font-semibold">후보자 추가</h1>
  </div>

  <% if @candidate.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-4 text-red-800">
      <h2 class="font-medium">후보자를 추가할 수 없습니다.</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% @candidate.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
    <p class="text-sm text-stone-600"><%= @candidate.number %>번 후보를 추가합니다.</p>

    <%= form_with model: [@election, @candidate], class: "space-y-4" do |form| %>
      <div class="space-y-1">
        <%= form.label :name, "이름", class: "text-sm font-medium text-stone-700" %>
        <%= form.text_field :name, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
      </div>

      <%= form.submit "후보자 추가", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  </div>
</div>
