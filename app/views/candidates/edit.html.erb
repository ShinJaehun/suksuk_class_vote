<div class="space-y-6">
  <div class="space-y-2">
    <p><%= link_to "투표로 돌아가기", poll_path(@poll), class: "text-sm font-medium text-stone-600 underline" %></p>

    <h1 class="text-2xl font-semibold"><%= @poll.choice_label %> 수정</h1>
  </div>

  <% if @candidate.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-4 text-red-800">
      <h2 class="font-medium"><%= @poll.election? ? "후보자를" : "#{@poll.choice_label}을" %> 수정할 수 없습니다.</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% @candidate.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
    <p class="text-sm text-stone-600"><%= @candidate.number %>번 <%= @poll.choice_label %>입니다.</p>

    <%= render "form", poll: @poll, candidate: @candidate, submit_label: "저장" %>
  </div>
</div>
