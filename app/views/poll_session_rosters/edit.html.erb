<div class="mx-auto max-w-3xl space-y-6">
  <%= link_to "투표 실행으로 돌아가기",
              poll_poll_session_path(@poll_session.poll, @poll_session),
              class: "text-sm font-medium text-stone-700 underline" %>
  <div>
    <h1 class="text-2xl font-semibold">투표자 명단 수정</h1>
    <p class="mt-1 text-sm text-stone-600">빈 행은 제외되며 명단 전체를 한 번에 저장합니다.</p>
  </div>

  <%= form_with url: poll_poll_session_roster_path(@poll_session.poll, @poll_session),
                method: :patch,
                class: "space-y-5 rounded-xl border border-stone-200 bg-white p-6 shadow-sm" do %>
    <div class="space-y-3">
      <% row_count = [@rows.size + 5, 30].min %>
      <% row_count.times do |index| %>
        <% row = @rows[index] || {} %>
        <div class="grid grid-cols-[7rem_1fr] gap-3">
          <%= number_field_tag "roster[participants][#{index}][number]",
                               row[:number],
                               min: 1,
                               placeholder: "번호",
                               class: "w-full rounded-md border-stone-300" %>
          <%= text_field_tag "roster[participants][#{index}][name]",
                             row[:name],
                             placeholder: "이름",
                             class: "w-full rounded-md border-stone-300" %>
        </div>
      <% end %>
    </div>
    <%= submit_tag "투표자 명단 저장",
                   class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  <% end %>
</div>
