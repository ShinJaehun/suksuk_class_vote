<% if roster_errors.present? %>
  <div class="rounded-md border border-rose-200 bg-rose-50 p-4 text-rose-800">
    <h2 class="font-medium">학생 명단을 저장할 수 없습니다.</h2>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
      <% roster_errors.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with url: submit_path,
              method: :patch,
              scope: :roster,
              class: "space-y-4",
              data: { controller: "participant-group-roster" } do |form| %>
  <div class="divide-y divide-stone-100 rounded-md border border-stone-200 bg-white">
    <% slot_rows.each_with_index do |row, index| %>
      <div class="grid grid-cols-[6rem_minmax(0,1fr)_auto] items-center gap-2 p-3"
           data-participant-group-roster-target="row"
           <%= "hidden" if row["_destroy"] == "1" %>>
        <%= hidden_field_tag "roster[slots][#{index}][id]", row["id"] %>
        <%= hidden_field_tag "roster[slots][#{index}][_destroy]",
                             row["_destroy"],
                             data: { participant_group_roster_target: "destroy" } %>
        <%= number_field_tag "roster[slots][#{index}][number]",
                             row["number"],
                             min: 1,
                             aria: { label: "학생 번호" },
                             class: "w-24 rounded-md border border-stone-300 px-3 py-2" %>
        <%= text_field_tag "roster[slots][#{index}][name]",
                           row["name"],
                           aria: { label: "학생 이름" },
                           class: "min-w-0 w-full rounded-md border border-stone-300 px-3 py-2" %>
        <% if allow_destroy %>
          <button type="button"
                  class="text-sm font-medium text-rose-700 underline"
                  data-action="participant-group-roster#removeRow">
            삭제
          </button>
        <% end %>
      </div>
    <% end %>

    <% new_slot_rows.each_with_index do |row, index| %>
      <div class="grid grid-cols-[6rem_minmax(0,1fr)_auto] items-center gap-2 bg-indigo-50/30 p-3"
           data-participant-group-roster-target="row">
        <%= number_field_tag "roster[new_slots][#{index}][number]",
                             row["number"],
                             min: 1,
                             aria: { label: "추가 학생 번호" },
                             class: "w-24 rounded-md border border-stone-300 px-3 py-2" %>
        <%= text_field_tag "roster[new_slots][#{index}][name]",
                           row["name"],
                           placeholder: "학생 이름",
                           aria: { label: "추가 학생 이름" },
                           class: "min-w-0 w-full rounded-md border border-stone-300 px-3 py-2" %>
        <% if allow_destroy %>
          <button type="button"
                  class="text-sm font-medium text-rose-700 underline"
                  data-action="participant-group-roster#removeRow">
            삭제
          </button>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= form.submit "저장", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <%= link_to "취소", cancel_path, class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
  </div>
<% end %>
