<div class="space-y-6">
  <p><%= link_to "투표자 명단으로 돌아가기",
                 participant_group_path(@participant_group, return_to: @safe_return_to),
                 class: "text-sm font-medium text-stone-600 underline" %></p>
  <h1 class="text-2xl font-semibold"><%= @participant_group.display_name %> 명단 수정</h1>

  <%= render "participant_group_rosters/form",
             participant_group: @participant_group,
             slot_rows: @slot_rows,
             new_slot_rows: @new_slot_rows,
             roster_errors: @roster_errors,
             submit_path: participant_group_roster_path(@participant_group, return_to: @safe_return_to),
             cancel_path: participant_group_path(@participant_group, return_to: @safe_return_to),
             allow_destroy: true %>
</div>
