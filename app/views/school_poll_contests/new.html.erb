<%= turbo_frame_tag "school_poll_modal" do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-stone-950/40 p-4">
    <%= render "poll_definitions/contest_form",
               poll: @poll, contest: @contest,
               form_url: school_poll_contests_path(@poll), heading_action: "추가",
               submit_label: "추가", cancel_path: school_poll_path(@poll) %>
  </div>
<% end %>
