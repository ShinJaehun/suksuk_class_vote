<section class="mx-auto max-w-2xl rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
  <h1 class="text-2xl font-semibold"><%= @poll.contest_label %> 추가</h1>

  <% if @contest.errors.any? %>
    <ul class="mt-4 list-disc pl-5 text-sm text-red-700">
      <% @contest.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with model: @contest,
                url: school_poll_contests_path(@poll),
                class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :title, "항목 이름", class: "block text-sm font-medium" %>
      <%= form.text_field :title, class: "mt-1 w-full rounded-md border-stone-300" %>
    </div>

    <%= form.submit "추가", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <%= link_to "취소", school_poll_path(@poll), class: "ml-3 text-sm underline" %>
  <% end %>
</section>
