<h1><%= @voter_group.name %></h1>

<p><%= link_to "투표자 그룹 목록으로 돌아가기", voter_groups_path %></p>
<p>
  <%= link_to "투표자 그룹 수정", edit_voter_group_path(@voter_group) %>
  <%= button_to "투표자 그룹 삭제", voter_group_path(@voter_group), method: :delete %>
</p>

<h2>학생 명단</h2>

<% if @voter_group.voter_slots.any? %>
  <ol>
    <% @voter_group.voter_slots.order(:number).each do |voter_slot| %>
      <li>
        <%= voter_slot.number %>번 <%= voter_slot.name %>
        <%= link_to "수정", edit_voter_group_voter_slot_path(@voter_group, voter_slot) %>
        <%= button_to "삭제", voter_group_voter_slot_path(@voter_group, voter_slot), method: :delete %>
      </li>
    <% end %>
  </ol>
<% else %>
  <p>아직 등록된 학생이 없습니다.</p>
<% end %>

<p>
  <%= link_to "학생 1명 추가", new_voter_group_voter_slot_path(@voter_group) %>
  <%= link_to "여러 명 추가", new_voter_group_bulk_voter_slots_path(@voter_group) %>
</p>
