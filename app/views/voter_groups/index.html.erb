<div class="flex items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold">참여자 그룹</h1>

  <%= link_to "새 참여자 그룹 만들기",
              new_voter_group_path,
              class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
</div>

<ul class="space-y-3">
  <% @voter_groups.each do |voter_group| %>
    <li class="rounded-md border border-stone-200 bg-white p-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="space-y-1">
          <h2 class="font-medium"><%= voter_group.name %></h2>
          <p class="text-sm text-stone-600">학생 <%= voter_group.voter_slots.size %>명</p>
        </div>

        <%= link_to "상세",
                    voter_group_path(voter_group),
                    class: "text-sm font-medium text-stone-700 underline" %>
      </div>
    </li>
  <% end %>
</ul>
