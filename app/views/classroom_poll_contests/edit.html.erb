<% if turbo_frame_request? %>
  <%= turbo_frame_tag @contest do %>
    <%= render "poll_sessions/contest_form", poll_session: @poll_session, contest: @contest, form_url: poll_poll_session_contest_path(@poll, @poll_session, @contest), submit_label: "저장", cancel_path: poll_poll_session_path(@poll, @poll_session), frame_id: dom_id(@contest) %>
  <% end %>
<% else %>
  <%= render "poll_definitions/contest_form", poll: @poll, contest: @contest, form_url: poll_poll_session_contest_path(@poll, @poll_session, @contest), heading_action: "수정", submit_label: "저장", cancel_path: poll_poll_session_path(@poll, @poll_session) %>
<% end %>
