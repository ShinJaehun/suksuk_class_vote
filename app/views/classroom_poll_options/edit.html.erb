<% if turbo_frame_request? %>
  <%= turbo_frame_tag dom_id(@option) do %>
    <%= render "poll_sessions/option_form", poll_session: @poll_session, contest: @contest, option: @option, form_url: poll_poll_session_contest_option_path(@poll, @poll_session, @contest, @option), submit_label: "저장", cancel_path: poll_poll_session_path(@poll, @poll_session), frame_id: dom_id(@option) %>
  <% end %>
<% else %>
  <%= render "poll_definitions/option_form", poll: @poll, contest: @contest, option: @option, form_url: poll_poll_session_contest_option_path(@poll, @poll_session, @contest, @option), heading_action: "수정", submit_label: "저장", cancel_path: poll_poll_session_path(@poll, @poll_session), photo_management_allowed: false %>
<% end %>
