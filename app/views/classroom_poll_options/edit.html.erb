<% if turbo_frame_request? %>
  <%= turbo_frame_tag "school_poll_modal" do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-stone-950/40 p-4">
      <%= render "poll_definitions/option_form", poll: @poll, contest: @contest, option: @option,
                 form_url: poll_poll_session_contest_option_path(@poll, @poll_session, @contest, @option), heading_action: "수정",
                 submit_label: "저장", cancel_path: poll_poll_session_path(@poll, @poll_session),
                 photo_management_allowed: false %>
    </div>
  <% end %>
<% else %>
  <%= render "poll_definitions/option_form", poll: @poll, contest: @contest, option: @option, form_url: poll_poll_session_contest_option_path(@poll, @poll_session, @contest, @option), heading_action: "수정", submit_label: "저장", cancel_path: poll_poll_session_path(@poll, @poll_session), photo_management_allowed: false %>
<% end %>
