<h1><%= @election.title %></h1>

<p><%= link_to "선거 목록으로 돌아가기", elections_path %></p>

<dl>
  <dt>상태</dt>
  <dd><%= @election.status %></dd>

  <dt>투표자 그룹</dt>
  <dd><%= @election.voter_group.name %></dd>

  <dt>학생 수</dt>
  <dd><%= @election.voter_group.voter_slots.count %>명</dd>
</dl>

<%= render "candidates", election: @election %>
<%= render "progress", election: @election, result_summary: @result_summary %>
<%= render "election_voters", election: @election %>
