<div class="space-y-6">
  <% if @election.in_progress? %>
    <%= turbo_stream_from @election, :operation_screen %>
  <% end %>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="space-y-2">
      <p><%= link_to "선거 목록으로 돌아가기", elections_path, class: "text-sm font-medium text-stone-600 underline" %></p>

      <h1 class="text-3xl font-semibold"><%= @election.title %></h1>
    </div>

    <% if @election.in_progress? %>
      <%= link_to "투표 화면 열기",
                  ballot_election_path(@election),
                  target: "_blank",
                  rel: "noopener",
                  class: "inline-flex rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  </div>

  <dl class="grid gap-4 rounded-md border border-stone-200 bg-white p-4 sm:grid-cols-3">
    <div class="space-y-1">
      <dt class="text-sm font-medium text-stone-500">상태</dt>
      <dd class="font-medium"><%= @election.display_status %></dd>
    </div>

    <div class="space-y-1">
      <dt class="text-sm font-medium text-stone-500">투표자 그룹</dt>
      <dd class="font-medium"><%= @election.voter_group_display_name || "-" %></dd>
    </div>

    <div class="space-y-1">
      <dt class="text-sm font-medium text-stone-500">학생 수</dt>
      <dd class="font-medium">
        <%= @election.election_voters.exists? ? @election.election_voters.count : @election.readiness_voter_count %>명
      </dd>
    </div>
  </dl>

  <% if @election.draft? %>
    <%= render "readiness", election: @election %>
  <% end %>

  <%= render "integrity_report", election: @election, integrity_report: @integrity_report %>
  <%= render "candidates", election: @election unless @election.closed? %>
  <% if @election.closed? %>
    <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
      <%= render "closed_result", result_summary: @result_summary %>
    </section>
  <% else %>
    <%= render "progress", election: @election %>
  <% end %>
  <%= render "election_voters", election: @election %>
  <%= render "event_log", election_events: @election_events %>
</div>
