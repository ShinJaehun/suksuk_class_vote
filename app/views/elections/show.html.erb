<h1><%= @election.title %></h1>

<p><%= link_to "선거 목록으로 돌아가기", elections_path %></p>

<dl>
  <dt>상태</dt>
  <dd><%= @election.status %></dd>

  <dt>투표자 그룹</dt>
  <dd><%= @election.voter_group.name %></dd>

  <dt>학생 수</dt>
  <dd><%= @election.voter_group.voter_slots.count %>명</dd>
</dl>

<h2>후보자</h2>

<% if @election.draft? %>
  <p><%= link_to "후보자 추가", new_election_candidate_path(@election) %></p>
<% end %>

<% if @election.candidates.any? %>
  <table>
    <thead>
      <tr>
        <th>기호</th>
        <th>이름</th>
        <th>관리</th>
      </tr>
    </thead>
    <tbody>
      <% @election.candidates.order(:number).each do |candidate| %>
        <tr>
          <td><%= candidate.number %>번</td>
          <td><%= candidate.name %></td>
          <td>
            <% if @election.draft? %>
              <%= link_to "수정", edit_election_candidate_path(@election, candidate) %>
              <%= button_to "삭제", election_candidate_path(@election, candidate), method: :delete %>
            <% else %>
              후보자 관리가 종료되었습니다.
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>아직 등록된 후보자가 없습니다.</p>
<% end %>

<h2>선거 진행</h2>

<% if @election.draft? %>
  <%= button_to "선거 시작", start_election_path(@election), method: :post %>
  <% unless @election.election_voters.exists? %>
    <p>아직 생성된 선거용 명단이 없습니다.</p>
  <% end %>
<% elsif @election.in_progress? %>
  <p>선거가 진행 중입니다.</p>
  <% if @election.polling_station.present? %>
    <% current_voter = @election.polling_station.current_election_voter %>
    <% if current_voter.present? %>
      <p>현재 투표자: <%= current_voter.number %>번 <%= current_voter.name %></p>
      <% if current_voter.election_voter_participation.present? %>
        <p>현재 투표자는 투표를 완료했습니다.</p>
        <% next_voter = @election.election_voters.where("number > ?", current_voter.number).order(:number).first %>
        <% if next_voter.present? %>
          <%= button_to "다음 학생으로", advance_current_voter_election_path(@election), method: :post %>
        <% else %>
          <%= button_to "선거 종료", close_election_path(@election), method: :post %>
        <% end %>
      <% else %>
        <h3>후보 선택</h3>
        <% @election.candidates.order(:number).each do |candidate| %>
          <%= button_to "#{candidate.number}번 #{candidate.name}",
                        submit_vote_election_path(@election),
                        method: :post,
                        params: { candidate_id: candidate.id } %>
        <% end %>
      <% end %>
    <% else %>
      <p>현재 투표자를 찾을 수 없습니다.</p>
    <% end %>
  <% else %>
    <p>투표 진행 정보를 찾을 수 없습니다.</p>
  <% end %>
<% elsif @election.closed? %>
  <p>선거가 종료되었습니다.</p>

  <h2>선거 결과</h2>

  <table>
    <thead>
      <tr>
        <th>기호</th>
        <th>후보</th>
        <th>득표수</th>
      </tr>
    </thead>
    <tbody>
      <% @election.candidates.order(:number).each do |candidate| %>
        <% candidate_tally = @election.candidate_tallies.find_by(candidate: candidate) %>
        <tr>
          <td><%= candidate.number %>번</td>
          <td><%= candidate.name %></td>
          <td><%= candidate_tally&.votes_count.to_i %>표</td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @election.election_voters.exists? %>
  <h2>선거용 명단</h2>

  <table>
    <thead>
      <tr>
        <th>번호</th>
        <th>이름</th>
      </tr>
    </thead>
    <tbody>
      <% @election.election_voters.order(:number).each do |election_voter| %>
        <tr>
          <td><%= election_voter.number %>번</td>
          <td><%= election_voter.name %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
