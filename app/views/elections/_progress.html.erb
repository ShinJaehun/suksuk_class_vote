<%= turbo_frame_tag dom_id(election, :progress), class: "block" do %>
  <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
    <h2 class="text-xl font-semibold">선거 진행</h2>

    <% if election.draft? %>
      <% if election.startable_by_configuration? %>
        <%= button_to "선거 시작",
                      start_election_path(election),
                      method: :post,
                      data: { turbo_frame: "_top" },
                      class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
      <% else %>
        <p class="text-stone-600">후보자 등록이 필요합니다.</p>
      <% end %>
      <% unless election.election_voters.exists? %>
        <p class="text-stone-600">아직 생성된 선거용 명단이 없습니다.</p>
      <% end %>
    <% elsif election.in_progress? %>
      <p class="text-stone-600">선거가 진행 중입니다.</p>
      <% if election.polling_station.present? %>
        <% current_voter = election.polling_station.current_election_voter %>
        <% if current_voter.present? %>
          <div class="rounded-md border border-stone-200 bg-stone-50 p-4">
            <p class="font-medium">현재 투표자: <%= current_voter.number %>번 <%= current_voter.name %></p>
          </div>
          <% participation = current_voter.election_voter_participation %>
          <% if participation.present? %>
            <div class="space-y-3">
              <% if participation.completed? %>
                <p class="text-stone-700">현재 투표자는 투표를 완료했습니다.</p>
              <% elsif participation.absent? %>
                <p class="text-stone-700">현재 투표자는 미참여 처리되었습니다.</p>
              <% elsif participation.abstained? %>
                <p class="text-stone-700">현재 투표자는 기권 처리되었습니다.</p>
              <% end %>
              <% next_voter = election.election_voters.where("number > ?", current_voter.number).order(:number).first %>
              <% unless next_voter.present? %>
                <%= button_to "선거 종료",
                              close_election_path(election),
                              method: :post,
                              data: { turbo_frame: "_top", turbo_confirm: "선거를 종료할까요?" },
                              class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
              <% end %>
            </div>
          <% else %>
            <p class="text-stone-700">투표 화면에서 선택을 진행하세요.</p>
          <% end %>
        <% else %>
          <p class="text-stone-600">현재 투표자를 찾을 수 없습니다.</p>
        <% end %>
      <% else %>
        <p class="text-stone-600">투표 진행 정보를 찾을 수 없습니다.</p>
      <% end %>
    <% end %>
  </section>
<% end %>
