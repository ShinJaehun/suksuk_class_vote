<div class="space-y-4">
  <p class="text-stone-600">선거가 종료되었습니다.</p>

  <h2 class="text-xl font-semibold">참여 요약</h2>

  <dl class="grid gap-3 sm:grid-cols-5">
    <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
      <dt class="text-sm font-medium text-stone-500">전체 투표자 수</dt>
      <dd class="mt-1 font-semibold"><%= result_summary.total_voters %>명</dd>
    </div>

    <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
      <dt class="text-sm font-medium text-stone-500">투표 완료 수</dt>
      <dd class="mt-1 font-semibold"><%= result_summary.completed_count %>명</dd>
    </div>

    <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
      <dt class="text-sm font-medium text-stone-500">미참여 수</dt>
      <dd class="mt-1 font-semibold"><%= result_summary.absent_count %>명</dd>
    </div>

    <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
      <dt class="text-sm font-medium text-stone-500">기권 수</dt>
      <dd class="mt-1 font-semibold"><%= result_summary.abstained_count %>명</dd>
    </div>

    <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
      <dt class="text-sm font-medium text-stone-500">미처리 수</dt>
      <dd class="mt-1 font-semibold"><%= result_summary.unprocessed_count %>명</dd>
    </div>
  </dl>

  <% if result_summary.top_candidate_results.any? %>
    <p class="rounded-md bg-stone-100 p-3 font-medium">
      최다 득표:
      <%= result_summary.top_candidate_results.map { |result| "#{result.candidate.number}번 #{result.candidate.name}" }.join(", ") %>
    </p>
  <% else %>
    <p class="rounded-md bg-stone-100 p-3 font-medium">최다 득표 후보 없음</p>
  <% end %>

  <h2 class="text-xl font-semibold">선거 결과</h2>

  <div class="overflow-x-auto">
    <table class="min-w-full text-left text-sm">
      <thead class="border-b border-stone-200 text-stone-500">
      <tr>
        <th class="px-3 py-2 font-medium">기호</th>
        <th class="px-3 py-2 font-medium">후보</th>
        <th class="px-3 py-2 font-medium">득표수</th>
      </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        <% result_summary.candidate_results.each do |result| %>
          <tr>
            <td class="px-3 py-3"><%= result.candidate.number %>번</td>
            <td class="px-3 py-3 font-medium"><%= result.candidate.name %></td>
            <td class="px-3 py-3"><%= result.votes_count %>표</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
