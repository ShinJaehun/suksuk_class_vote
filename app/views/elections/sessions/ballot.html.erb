<% content_for :hide_navigation, true %>
<% content_for :ballot_screen_layout, true %>

<div class="space-y-2">
  <%= turbo_stream_from @election_session, :ballot_screen %>

  <%= render "ballot_content",
             election_session: @election_session,
             progress: @progress,
             current_voter: @current_voter,
             contests: @contests %>
</div>
