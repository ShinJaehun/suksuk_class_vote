<div class="space-y-6">
  <%= turbo_stream_from @election_session, :ballot_screen %>

  <header class="space-y-2">
    <p class="text-sm font-medium text-stone-600">학생 투표 화면</p>
    <h1 class="text-3xl font-semibold"><%= @election.title %></h1>
  </header>

  <%= render "ballot_content",
             election_session: @election_session,
             progress: @progress,
             current_voter: @current_voter,
             contests: @contests %>
</div>
