<div class="space-y-6">
  <header class="space-y-2">
    <p class="text-sm font-medium text-stone-600">학생 투표 화면</p>
    <h1 class="text-3xl font-semibold"><%= @election.title %></h1>
  </header>

  <section class="rounded-md border border-stone-200 bg-white p-4">
    <h2 class="text-xl font-semibold">현재 학생</h2>
    <p class="mt-2 text-2xl font-semibold text-stone-900">
      <%= [("#{@current_voter.number}번" if @current_voter.number.present?), @current_voter.name.presence].compact.join(" ") %>
    </p>
  </section>

  <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
    <h2 class="text-xl font-semibold">선거 항목</h2>

    <% @contests.each do |contest| %>
      <div class="rounded-md border border-stone-200 p-4">
        <h3 class="text-lg font-medium"><%= contest.title %></h3>
        <ul class="mt-3 space-y-1 text-sm text-stone-700">
          <% contest.election_candidates.order(:number).each do |candidate| %>
            <li>
              <%= candidate.number %>번 <%= candidate.name %>
              <%= "(#{candidate.affiliation_label})" if candidate.affiliation_label.present? %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>

  <p class="text-sm text-stone-600">투표 제출 기능은 다음 단계에서 연결됩니다.</p>
</div>
