<section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
  <div class="space-y-1">
    <h2 class="text-xl font-semibold">투표자 명단</h2>
    <p class="text-sm text-stone-600">
      <%= election_session.participant_group&.name || "선택된 투표자 명단이 없습니다." %>
      · 투표자 <%= participant_slots.size %>명
    </p>
  </div>

  <% if participant_slots.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="border-b border-stone-200 text-stone-500">
        <tr>
          <th class="px-3 py-2 font-medium">번호</th>
          <th class="px-3 py-2 font-medium">이름</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% participant_slots.each do |participant| %>
            <tr>
              <td class="px-3 py-3"><%= participant.number %>번</td>
              <td class="px-3 py-3 font-medium"><%= participant.name %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-stone-600">등록된 투표자가 없습니다.</p>
  <% end %>
</section>
