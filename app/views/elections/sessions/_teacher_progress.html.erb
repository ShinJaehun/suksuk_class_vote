<%= turbo_frame_tag dom_id(election_session, :teacher_progress), class: "block space-y-6" do %>
  <% display_status = { "draft" => "준비 중", "in_progress" => "진행 중", "closed" => "종료됨", "stopped" => "중단됨" }.fetch(election_session.status, election_session.status) %>
  <% parent_status_label = { "draft" => "선거 준비 중", "in_progress" => "선거 진행 중", "closed" => "선거 종료" }.fetch(election_session.election.status, election_session.election.status) %>
  <% participation = current_voter&.election_participation %>
  <% total_voter_count = election_session.draft? ? election_session.participant_group.participant_slots.count : election_session.election_voters.count %>
  <% completed_count = election_session.election_voters.includes(:election_participation).count { |voter| voter.election_participation&.completed? || voter.election_participation&.abstained? } %>
  <% absent_count = election_session.election_voters.includes(:election_participation).count { |voter| voter.election_participation&.absent? } %>
  <% pending_count = [ total_voter_count - completed_count - absent_count, 0 ].max %>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="space-y-2">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-3xl font-semibold"><%= election_session.election.title %></h1>
        <span class="rounded-full bg-sky-50 px-2 py-1 text-xs font-medium text-sky-700">선거</span>
        <span class="rounded-full bg-stone-100 px-2 py-1 text-xs font-medium text-stone-700"><%= parent_status_label %></span>
        <span class="rounded-full bg-stone-100 px-2 py-1 text-xs font-medium text-stone-700"><%= display_status %></span>
      </div>
      <p class="text-sm text-stone-600"><%= election_session.participant_group&.name || "명단 없음" %></p>
    </div>

    <div class="flex flex-wrap gap-2">
      <% if election_session.in_progress? && progress.present? && current_voter.present? %>
        <%= link_to "투표 화면 열기",
                    ballot_elections_session_path(election_session),
                    target: "_blank",
                    rel: "noopener",
                    data: { turbo: false },
                    class: "inline-flex rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
      <% end %>
    </div>
  </div>

  <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
    <h2 class="text-xl font-semibold">투표 정보</h2>
    <div class="grid gap-3 sm:grid-cols-4">
      <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
        <p class="text-xs font-medium text-stone-500">전체 투표자</p>
        <p class="mt-1 text-2xl font-semibold"><%= total_voter_count %>명</p>
      </div>
      <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
        <p class="text-xs font-medium text-stone-500">완료/기권</p>
        <p class="mt-1 text-2xl font-semibold"><%= completed_count %>명</p>
      </div>
      <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
        <p class="text-xs font-medium text-stone-500">대기</p>
        <p class="mt-1 text-2xl font-semibold"><%= pending_count %>명</p>
      </div>
      <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
        <p class="text-xs font-medium text-stone-500">미참여</p>
        <p class="mt-1 text-2xl font-semibold"><%= absent_count %>명</p>
      </div>
    </div>

    <% if election_session.closed? %>
      <p class="rounded-md border border-stone-200 bg-stone-50 p-3 text-sm text-stone-700">이 학급 투표는 완료되었습니다. 추가 투표는 불가능하며, 전체 결과는 관리자 결과 집계 화면에서 확인합니다.</p>
    <% elsif election_session.stopped? %>
      <p class="rounded-md border border-rose-200 bg-rose-50 p-3 text-sm text-rose-800">이 학급 투표는 중단되었습니다. 중단된 세션은 다시 시작하지 않습니다.</p>
    <% elsif election_session.in_progress? %>
      <p class="rounded-md border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800">현재 학급 투표가 진행 중입니다. 새로고침하거나 다시 접속해도 서버에 저장된 진행 위치에서 이어집니다.</p>
    <% elsif election_session.election.draft? %>
      <p class="rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">아직 전체 선거가 시작되지 않았습니다. 관리자가 Election을 시작한 뒤 학급 투표를 시작할 수 있습니다.</p>
    <% elsif election_session.draft? %>
      <p class="rounded-md border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800">이 학급 투표를 시작할 수 있습니다. 아래 선거 항목을 확인한 뒤 투표를 시작하세요.</p>
    <% end %>
  </section>

  <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
    <h2 class="text-xl font-semibold">투표 진행</h2>

    <% if election_session.draft? %>
      <div class="space-y-3">
        <% if election_session.election.draft? %>
          <div class="rounded-md border border-amber-200 bg-amber-50 p-4">
            <h3 class="font-medium text-amber-900">전체 선거가 아직 시작되지 않았습니다.</h3>
            <p class="mt-1 text-sm text-amber-800">관리자가 Election을 시작해야 교사가 이 학급 투표를 시작할 수 있습니다.</p>
          </div>
        <% else %>
          <div class="rounded-md border border-emerald-200 bg-emerald-50 p-4">
            <h3 class="font-medium text-emerald-900">이 학급 투표를 시작할 수 있습니다.</h3>
            <p class="mt-1 text-sm text-emerald-800">선거명, 학급명, 후보 구성을 확인한 뒤 시작하세요.</p>
          </div>
          <%= button_to "선거 시작",
                        start_elections_session_path(election_session),
                        method: :post,
                        data: { turbo_frame: "_top" },
                        class: "rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
        <% end %>
      </div>
    <% elsif election_session.in_progress? %>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-stone-600">현재 순번을 확인하고 학생 투표 화면을 열어 진행하세요.</p>
      </div>

      <% if progress.present? && current_voter.present? %>
        <% current_voter_label = [("#{current_voter.number}번" if current_voter.number.present?), current_voter.name.presence].compact.join(" ").presence || "현재 투표자" %>
        <% current_position = current_voter.position || current_voter.number %>

        <% if participation&.pending? %>
          <div class="space-y-2 rounded-md border border-stone-200 bg-white p-4">
            <% if progress.open? %>
              <div class="rounded-md border border-stone-200 bg-stone-50 p-5">
                <p class="text-sm font-medium text-stone-500">현재 투표자</p>
                <p class="mt-2 text-3xl font-semibold text-stone-900"><%= current_voter_label %></p>
                <p class="mt-1 text-sm text-stone-500">순번 <%= current_position %>/<%= total_voter_count %></p>
              </div>
              <p class="text-lg font-medium text-stone-800"><%= current_voter.name %> 학생이 투표중입니다.</p>
            <% else %>
              <p class="text-lg font-medium text-stone-800">투표를 시작합니다.</p>
              <p class="text-sm text-stone-600">다음 투표자: <%= current_voter_label %> · 순번 <%= current_position %>/<%= total_voter_count %></p>
              <% if progress.locked? %>
                <div class="flex flex-wrap gap-2">
                  <%= button_to "다음 투표자는 #{current_voter_label}입니다.",
                                open_ballot_elections_session_path(election_session),
                                method: :post,
                                data: { turbo_frame: "_top", turbo_submits_with: "여는 중..." },
                                class: "rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
                  <%= button_to "미참여 처리",
                                mark_absent_elections_session_path(election_session),
                                method: :post,
                                data: { turbo_frame: "_top", turbo_submits_with: "처리 중..." },
                                class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
                </div>
              <% end %>
            <% end %>
          </div>
        <% elsif participation.present? %>
          <div class="rounded-md border border-stone-200 bg-white p-4">
            <% if participation.completed? %>
              <p class="text-lg font-medium text-stone-800"><%= current_voter_label %>은 투표를 완료했습니다.</p>
            <% elsif participation.abstained? %>
              <p class="text-lg font-medium text-stone-800"><%= current_voter_label %>은 기권 처리되었습니다.</p>
            <% elsif participation.absent? %>
              <p class="text-lg font-medium text-stone-800"><%= current_voter_label %>은 미참여 처리되었습니다.</p>
            <% end %>

            <% next_voter = election_session.election_voters.joins(:election_participation).where("election_voters.position > ?", current_voter.position).where(election_participations: { status: ElectionParticipation.statuses[:pending] }).order(:position).first %>
            <% can_advance = progress.locked? && (participation.completed? || participation.abstained? || participation.absent?) && next_voter.present? %>
            <% can_close = election_session.in_progress? && progress.locked? && (participation.completed? || participation.abstained? || participation.absent?) && next_voter.blank? %>
            <% if can_advance %>
              <% next_voter_label = [("#{next_voter.number}번" if next_voter.number.present?), next_voter.name.presence].compact.join(" ").presence || "다음 투표자" %>
              <%= button_to "다음 투표자는 #{next_voter_label}입니다.",
                            advance_voter_elections_session_path(election_session),
                            method: :post,
                            data: { turbo_frame: "_top", turbo_submits_with: "이동 중..." },
                            class: "mt-3 rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
            <% elsif can_close %>
              <%= button_to "투표 종료",
                            close_elections_session_path(election_session),
                            method: :post,
                            data: { turbo_frame: "_top", turbo_confirm: "투표를 종료할까요?", turbo_submits_with: "종료 중..." },
                            class: "mt-3 rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
            <% else %>
              <p class="mt-4 text-sm text-stone-600">모든 학생의 처리가 끝났습니다.</p>
            <% end %>
          </div>
        <% else %>
          <p class="text-stone-600">현재 학생의 투표 정보를 찾을 수 없습니다.</p>
        <% end %>
      <% elsif progress.present? %>
        <% all_voters_final = election_session.election_voters.includes(:election_participation).all? do |voter|
             voter.election_participation&.completed? || voter.election_participation&.abstained? || voter.election_participation&.absent?
           end %>
        <% can_close = progress.locked? && progress.current_election_voter.nil? && all_voters_final %>
        <div class="space-y-3 rounded-md border border-stone-200 bg-white p-4">
          <% if can_close %>
            <p class="text-lg font-medium text-stone-800">투표 진행을 마무리합니다.</p>
            <%= button_to "투표 종료",
                          close_elections_session_path(election_session),
                          method: :post,
                          data: { turbo_frame: "_top", turbo_confirm: "투표를 종료할까요?", turbo_submits_with: "종료 중..." },
                          class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
          <% else %>
            <p class="text-lg font-medium text-stone-800">모든 학생의 투표 처리가 끝났습니다.</p>
          <% end %>
        </div>
      <% else %>
        <p class="text-stone-600">투표 진행 정보를 찾을 수 없습니다.</p>
      <% end %>
    <% elsif election_session.closed? %>
      <div class="space-y-2 rounded-md border border-stone-200 bg-stone-50 p-4">
        <h3 class="text-lg font-medium text-stone-800">학급 투표 완료</h3>
        <p class="text-sm text-stone-600">이 학급의 투표가 완료되었습니다. 추가 투표는 할 수 없습니다.</p>
      </div>
    <% elsif election_session.stopped? %>
      <div class="space-y-2 rounded-md border border-rose-200 bg-rose-50 p-4">
        <h3 class="text-lg font-medium text-rose-900">중단된 세션</h3>
        <p class="text-sm text-rose-800">이 학급 투표는 중단되었습니다. 가능한 작업만 화면에 표시됩니다.</p>
      </div>
    <% end %>
  </section>
<% end %>
