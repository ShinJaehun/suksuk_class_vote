<% polling_data =
  if election_session.in_progress?
    {
      controller: "election-session-progress",
      election_session_progress_interval_value: 2500,
      election_session_progress_url_value: elections_session_path(election_session)
    }
  else
    {}
  end %>
<%= turbo_frame_tag dom_id(election_session, :teacher_progress), class: "block space-y-6", data: polling_data do %>
  <% display_status = { "draft" => "준비", "in_progress" => "진행", "closed" => "종료", "stopped" => "중단" }.fetch(election_session.status, election_session.status) %>
  <% status_class =
    if election_session.draft?
      "border-amber-200 bg-amber-50 text-amber-700"
    elsif election_session.in_progress?
      "border-emerald-200 bg-emerald-50 text-emerald-700"
    elsif election_session.closed?
      "border-stone-300 bg-stone-100 text-stone-700"
    elsif election_session.stopped?
      "border-rose-200 bg-rose-50 text-rose-700"
    else
      "border-stone-200 bg-stone-50 text-stone-700"
    end %>
  <% participation = current_voter&.election_participation %>
  <% participant_slots = election_session.participant_group.participant_slots.order(:number) %>
  <% roster_count = participant_slots.count %>
  <% total_voter_count = election_session.draft? ? roster_count : election_session.election_voters.count %>
  <% candidate_count = election_session.election.election_candidates.count %>
  <% completed_count = election_session.election_voters.includes(:election_participation).count { |voter| voter.election_participation&.completed? || voter.election_participation&.abstained? } %>
  <% absent_count = election_session.election_voters.includes(:election_participation).count { |voter| voter.election_participation&.absent? } %>
  <% pending_count = [ total_voter_count - completed_count - absent_count, 0 ].max %>
  <% startable = election_session.draft? && election_session.election.in_progress? %>
  <% can_open_ballot_screen = election_session.in_progress? && progress.present? && current_voter.present? && participation&.pending? %>
  <% absent_button_class = "rounded-md border border-amber-300 bg-amber-50 px-4 py-2 text-sm font-medium text-amber-900 hover:bg-amber-100" %>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="space-y-2">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-3xl font-semibold"><%= election_session.election.title %></h1>
        <%= election_kind_badge(election_session.election) %>
        <span class="rounded-md border px-2 py-1 text-sm font-medium <%= status_class %>"><%= display_status %></span>
      </div>
      <p class="text-sm text-stone-600"><%= election_session.participant_group&.name || "명단 없음" %></p>
    </div>

    <% if can_open_ballot_screen %>
      <% ballot_window_name = "election_session_#{election_session.id}_ballot" %>
      <div data-controller="election-ballot-window"
           data-election-ballot-window-url-value="<%= ballot_elections_session_path(election_session) %>"
           data-election-ballot-window-window-name-value="<%= ballot_window_name %>">
        <%= link_to "투표 화면 열기",
                    ballot_elections_session_path(election_session),
                    target: ballot_window_name,
                    data: {
                      turbo: false,
                      action: "click->election-ballot-window#open"
                    },
                    class: "inline-flex rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        <p hidden
           data-election-ballot-window-target="notice"
           class="mt-2 max-w-sm rounded-md border border-blue-200 bg-blue-50 px-3 py-2 text-sm text-blue-700"></p>
      </div>
    <% end %>
  </div>

  <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
    <div class="space-y-2">
      <% if election_session.draft? && !startable %>
        <h2 class="text-lg font-semibold">상태 점검: 확인 필요</h2>
        <p class="text-sm text-stone-600">관리자가 선거를 시작한 뒤 학급 투표를 시작할 수 있습니다.</p>
      <% elsif election_session.draft? %>
        <h2 class="text-lg font-semibold">상태 점검: 이상 없음</h2>
        <p class="text-sm text-stone-600">투표를 시작할 수 있습니다.</p>
      <% elsif election_session.in_progress? %>
        <h2 class="text-lg font-semibold">상태 점검: 이상 없음</h2>
        <p class="text-sm text-stone-600">진행 상태가 정상입니다.</p>
      <% elsif election_session.closed? %>
        <h2 class="text-lg font-semibold">상태 점검: 종료됨</h2>
        <p class="text-sm text-stone-600">이 학급 투표는 완료되었습니다.</p>
      <% elsif election_session.stopped? %>
        <h2 class="text-lg font-semibold">상태 점검: 중단됨</h2>
        <p class="text-sm text-stone-600">이 학급 투표는 중단되었습니다.</p>
      <% end %>
    </div>

    <% if election_session.draft? %>
      <dl class="grid gap-2 text-sm sm:grid-cols-3">
        <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
          <dt class="text-stone-500">투표자</dt>
          <dd class="mt-1 font-semibold"><%= roster_count %>명</dd>
        </div>
        <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
          <dt class="text-stone-500">후보자</dt>
          <dd class="mt-1 font-semibold"><%= candidate_count %>명</dd>
        </div>
        <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
          <dt class="text-stone-500">시작 가능 여부</dt>
          <dd class="mt-1 font-semibold"><%= startable ? "시작 가능" : "시작 불가" %></dd>
        </div>
      </dl>
    <% else %>
      <dl class="grid gap-2 text-sm sm:grid-cols-4">
        <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
          <dt class="text-stone-500">전체 투표자</dt>
          <dd class="mt-1 font-semibold"><%= total_voter_count %>명</dd>
        </div>
        <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
          <dt class="text-stone-500">투표 완료</dt>
          <dd class="mt-1 font-semibold"><%= completed_count %>명</dd>
        </div>
        <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
          <dt class="text-stone-500">미참여</dt>
          <dd class="mt-1 font-semibold"><%= absent_count %>명</dd>
        </div>
        <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
          <dt class="text-stone-500">대기</dt>
          <dd class="mt-1 font-semibold"><%= pending_count %>명</dd>
        </div>
      </dl>
    <% end %>
  </section>

  <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
    <h2 class="text-xl font-semibold">투표 진행</h2>

    <% if election_session.draft? %>
      <div class="space-y-3">
        <% if election_session.election.draft? %>
          <p class="text-stone-600">선거가 아직 시작되지 않았습니다.</p>
        <% else %>
          <%= button_to "선거 시작",
                        start_elections_session_path(election_session),
                        method: :post,
                        data: { turbo_frame: "_top" },
                        class: "rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
        <% end %>
      </div>
    <% elsif election_session.in_progress? %>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-stone-600">투표가 진행 중입니다.</p>
      </div>

      <% if progress.present? && current_voter.present? %>
        <% current_voter_label = [("#{current_voter.number}번" if current_voter.number.present?), current_voter.name.presence].compact.join(" ").presence || "현재 투표자" %>
        <% current_position = current_voter.position || current_voter.number %>

        <% if participation&.pending? %>
          <div class="space-y-2 rounded-md border border-stone-200 bg-white p-4">
            <% if progress.open? %>
              <div class="rounded-md border border-stone-200 bg-stone-50 p-5">
                <p class="text-sm font-medium text-stone-500">현재 투표자</p>
                <p class="mt-2 text-3xl font-semibold text-stone-900"><%= current_voter_label %></p>
              </div>
              <p class="text-lg font-medium text-stone-800"><%= current_voter.name %> 학생이 투표중입니다.</p>
            <% else %>
              <p class="text-lg font-medium text-stone-800">투표를 시작합니다.</p>
              <% if progress.locked? %>
                <div class="flex flex-wrap gap-5">
                  <%= button_to "다음 투표자는 #{current_voter_label}입니다.",
                                open_ballot_elections_session_path(election_session),
                                method: :post,
                                data: { turbo_frame: "_top", turbo_submits_with: "여는 중..." },
                                class: "rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
                  <%= button_to "미참여 처리",
                                mark_absent_elections_session_path(election_session),
                                method: :post,
                                data: { turbo_frame: "_top", turbo_confirm: "현재 투표자를 미참여 처리할까요?", turbo_submits_with: "처리 중..." },
                                class: absent_button_class %>
                </div>
              <% end %>
            <% end %>
          </div>
        <% elsif participation.present? %>
          <div class="rounded-md border border-stone-200 bg-white p-4">
            <% if participation.completed? %>
              <p class="text-lg font-medium text-stone-800"><%= current_voter_label %>은 투표를 완료했습니다.</p>
            <% elsif participation.abstained? %>
              <p class="text-lg font-medium text-stone-800"><%= current_voter_label %>은 기권 처리되었습니다.</p>
            <% elsif participation.absent? %>
              <p class="text-lg font-medium text-stone-800"><%= current_voter_label %>은 미참여 처리되었습니다.</p>
            <% end %>

            <% next_voter = election_session.election_voters.joins(:election_participation).where("election_voters.position > ?", current_voter.position).where(election_participations: { status: ElectionParticipation.statuses[:pending] }).order(:position).first %>
            <% can_advance = progress.locked? && (participation.completed? || participation.abstained? || participation.absent?) && next_voter.present? %>
            <% can_close = election_session.in_progress? && progress.locked? && (participation.completed? || participation.abstained? || participation.absent?) && next_voter.blank? %>
            <% if can_advance %>
              <% next_voter_label = [("#{next_voter.number}번" if next_voter.number.present?), next_voter.name.presence].compact.join(" ").presence || "다음 투표자" %>
              <div class="mt-3 flex flex-wrap gap-5">
                <%= button_to "다음 투표자는 #{next_voter_label}입니다.",
                              advance_voter_elections_session_path(election_session),
                              method: :post,
                              data: { turbo_frame: "_top", turbo_submits_with: "이동 중..." },
                              class: "rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
                <%= button_to "미참여 처리",
                              mark_next_absent_elections_session_path(election_session),
                              method: :post,
                              params: { current_election_voter_id: current_voter.id },
                              data: { turbo_frame: "_top", turbo_confirm: "다음 투표자를 미참여 처리할까요?", turbo_submits_with: "처리 중..." },
                              class: absent_button_class %>
              </div>
            <% elsif can_close %>
              <div class="mt-4 space-y-3 rounded-md border border-amber-300 bg-amber-50 p-4">
                <div>
                  <p class="text-base font-semibold text-amber-950">모든 학생의 투표가 끝났다면 반드시 투표 종료를 눌러 주세요.</p>
                  <p class="mt-1 text-sm text-amber-900">종료 후에는 이 세션의 투표가 마감됩니다.</p>
                </div>
                <%= button_to "투표 종료",
                              close_elections_session_path(election_session),
                              method: :post,
                              data: { turbo_frame: "_top", turbo_confirm: "투표를 종료하면 이 세션의 투표가 마감됩니다. 종료하시겠습니까?", turbo_submits_with: "종료 중..." },
                              class: "rounded-md bg-amber-600 px-5 py-3 text-base font-semibold text-white shadow-sm hover:bg-amber-700 focus:outline-none focus:ring-2 focus:ring-amber-500" %>
              </div>
            <% else %>
              <p class="mt-4 text-sm text-stone-600">모든 학생의 처리가 끝났습니다.</p>
            <% end %>
          </div>
        <% else %>
          <p class="text-stone-600">현재 학생의 투표 정보를 찾을 수 없습니다.</p>
        <% end %>
      <% elsif progress.present? %>
        <% all_voters_final = election_session.election_voters.includes(:election_participation).all? do |voter|
             voter.election_participation&.completed? || voter.election_participation&.abstained? || voter.election_participation&.absent?
           end %>
        <% can_close = progress.locked? && progress.current_election_voter.nil? && all_voters_final %>
        <div class="space-y-3 rounded-md border border-stone-200 bg-white p-4">
          <% if can_close %>
            <div class="space-y-3 rounded-md border border-amber-300 bg-amber-50 p-4">
              <div>
                <p class="text-base font-semibold text-amber-950">모든 학생의 투표가 끝났다면 반드시 투표 종료를 눌러 주세요.</p>
                <p class="mt-1 text-sm text-amber-900">종료 후에는 이 세션의 투표가 마감됩니다.</p>
              </div>
              <%= button_to "투표 종료",
                            close_elections_session_path(election_session),
                            method: :post,
                            data: { turbo_frame: "_top", turbo_confirm: "투표를 종료하면 이 세션의 투표가 마감됩니다. 종료하시겠습니까?", turbo_submits_with: "종료 중..." },
                            class: "rounded-md bg-amber-600 px-5 py-3 text-base font-semibold text-white shadow-sm hover:bg-amber-700 focus:outline-none focus:ring-2 focus:ring-amber-500" %>
            </div>
          <% else %>
            <p class="text-lg font-medium text-stone-800">모든 학생의 투표 처리가 끝났습니다.</p>
          <% end %>
        </div>
      <% else %>
        <p class="text-stone-600">투표 진행 정보를 찾을 수 없습니다.</p>
      <% end %>
    <% elsif election_session.closed? %>
      <div class="space-y-2 rounded-md border border-stone-200 bg-stone-50 p-4">
        <h3 class="text-lg font-medium text-stone-800">학급 투표 완료</h3>
        <p class="text-sm text-stone-600">이 학급의 투표가 완료되었습니다. 추가 투표는 할 수 없습니다.</p>
      </div>
    <% elsif election_session.stopped? %>
      <div class="space-y-2 rounded-md border border-rose-200 bg-rose-50 p-4">
        <h3 class="text-lg font-medium text-rose-900">중단된 세션</h3>
        <p class="text-sm text-rose-800">이 학급 투표는 중단되었습니다. 가능한 작업만 화면에 표시됩니다.</p>
      </div>
    <% end %>
  </section>

  <%= render "elections/sessions/event_log", election_session: election_session %>
  <%= render "elections/sessions/voter_roster", election_session: election_session, participant_slots: participant_slots %>  
<% end %>
