<%= turbo_frame_tag frame_id do %>
  <p><%= message %></p>
  <script>
    (() => {
      const redirectPath = <%= raw redirect_path.to_json %>

      if (window.Turbo) {
        window.Turbo.visit(redirectPath, { action: "replace" })
      } else {
        window.location.href = redirectPath
      }
    })()
  </script>
<% end %>
