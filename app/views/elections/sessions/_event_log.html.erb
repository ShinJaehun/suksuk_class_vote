<% event_labels = {
  "session_started" => "투표 시작",
  "ballot_submitted" => "투표 완료",
  "voter_marked_abstained" => "투표 완료",
  "voter_marked_absent" => "미참여",
  "session_closed" => "투표 종료"
} %>
<% election_events = election_session.election_events
  .includes(:actor, :election_voter)
  .where(event_type: event_labels.keys)
  .order(occurred_at: :desc, id: :desc)
  .limit(20) %>

<section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
  <h2 class="text-xl font-semibold">투표 진행 상황</h2>

  <% if election_events.any? %>
    <ul class="divide-y divide-stone-200">
      <% election_events.each do |event| %>
        <% target =
          if event.election_voter.present?
            [("#{event.election_voter.number}번" if event.election_voter.number.present?), event.election_voter.name.presence].compact.join(" ")
          else
            event.actor&.name.presence || event.actor&.email
          end
        %>

        <li class="grid gap-2 py-4 text-base sm:grid-cols-[11rem_1fr_1fr]">
          <time class="text-stone-500" datetime="<%= event.occurred_at.iso8601 %>">
            <%= kst_datetime(event.occurred_at) %>
          </time>
          <span class="text-stone-600"><%= target.presence || "시스템" %></span>
          <span class="font-medium"><%= event_labels.fetch(event.event_type, "이벤트 기록") %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-stone-600">아직 표시할 투표 진행 상황이 없습니다.</p>
  <% end %>
</section>
