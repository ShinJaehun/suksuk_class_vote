<div class="space-y-5 rounded-md border border-stone-200 bg-white p-5">
  <div class="rounded-md border border-stone-200 bg-stone-50 p-5">
    <p class="text-sm font-medium text-stone-500">현재 투표자</p>
    <p class="mt-2 text-4xl font-semibold"><%= current_voter.number %>번 <%= current_voter.name %></p>
  </div>

  <%= form_with url: submit_ballot_elections_session_path(election_session), method: :post, class: "space-y-4" do %>
    <% contests.each do |contest| %>
      <fieldset class="space-y-3">
        <legend class="text-xl font-semibold"><%= contest.title %> 선택</legend>

        <div class="grid gap-3 sm:grid-cols-2">
          <% contest.election_candidates.order(:number).each do |candidate| %>
            <label class="flex cursor-pointer items-center gap-3 rounded-md bg-stone-900 px-4 py-5 text-xl font-medium text-white">
              <% if contest.max_selections == 1 %>
                <%= radio_button_tag "ballot[contest_choices][#{contest.id}]", "candidate:#{candidate.id}" %>
              <% else %>
                <%= check_box_tag "ballot[contest_choices][#{contest.id}][]", "candidate:#{candidate.id}" %>
              <% end %>
              <span>
                <%= candidate.number %>번 <%= candidate.name %><%= " (#{candidate.affiliation_label})" if candidate.affiliation_label.present? %>
              </span>
            </label>
          <% end %>

          <% if contest.allow_abstain? %>
            <label class="flex cursor-pointer items-center gap-3 rounded-md border border-stone-300 px-4 py-3 text-sm font-medium text-stone-700">
              <% if contest.max_selections == 1 %>
                <%= radio_button_tag "ballot[contest_choices][#{contest.id}]", "abstain" %>
              <% else %>
                <%= check_box_tag "ballot[contest_choices][#{contest.id}][]", "abstain" %>
              <% end %>
              <span>기권 처리</span>
            </label>
          <% end %>
        </div>
      </fieldset>
    <% end %>

    <%= button_tag "투표 제출",
                   type: :submit,
                   class: "rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700",
                   data: { turbo_submits_with: "제출 중..." } %>
  <% end %>
</div>
