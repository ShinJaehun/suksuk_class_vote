<div class="space-y-6">
  <header class="space-y-2">
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="text-3xl font-semibold"><%= election_session.election.title %></h1>
      <span class="rounded-full bg-stone-100 px-2 py-1 text-xs font-medium text-stone-700">종료</span>
    </div>
    <p class="text-stone-600">투표가 종료되었습니다.</p>
  </header>

  <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
    <h2 class="text-xl font-semibold"><%= election_kind_label(election_session.election) %> 결과</h2>

    <% contests.each do |contest| %>
      <% candidates = contest.election_candidates.order(:number) %>
      <% candidate_rows = candidates.map { |candidate| [candidate, candidate_tallies_by_candidate_id[candidate.id]&.votes_count.to_i] } %>
      <% highest_votes = candidate_rows.map(&:second).max %>
      <% leading_rows = highest_votes.present? ? candidate_rows.select { |(_candidate, votes_count)| votes_count == highest_votes } : [] %>
      <% contest_tally = contest_tallies_by_contest_id[contest.id] %>

      <article class="space-y-4 rounded-md border border-stone-200 p-4">
        <h3 class="text-lg font-medium"><%= contest.title %></h3>

        <% if leading_rows.any? %>
          <% leading_labels = leading_rows.map { |candidate, _votes_count| "#{candidate.number}번 #{candidate.name}" }.join(", ") %>
          <p class="text-sm font-medium text-stone-800">
            <%= leading_rows.one? ? "최다 득표 후보" : "공동 최다 득표 후보" %>: <%= leading_labels %>
          </p>
        <% else %>
          <p class="text-sm text-stone-600">집계된 후보가 없습니다.</p>
        <% end %>

        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-stone-200 text-left text-stone-600">
              <th class="py-2 pr-3 font-medium">기호</th>
              <th class="py-2 pr-3 font-medium">후보자</th>
              <th class="py-2 font-medium">득표수</th>
            </tr>
          </thead>
          <tbody>
            <% candidate_rows.each do |candidate, votes_count| %>
              <tr class="border-b border-stone-100">
                <td class="py-2 pr-3"><%= candidate.number %></td>
                <td class="py-2 pr-3"><%= candidate.name %></td>
                <td class="py-2"><%= votes_count %>표</td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <% if contest_tally&.abstentions_count.to_i.positive? %>
          <p class="text-sm text-stone-600">기권 <%= contest_tally.abstentions_count %>표</p>
        <% end %>
      </article>
    <% end %>
  </section>
</div>
