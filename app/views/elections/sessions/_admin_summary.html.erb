<p><%= link_to "선거 상세로 돌아가기", admin_election_path(election_session.election), class: "text-sm font-medium text-stone-600 underline" %></p>

<section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
  <% display_status = { "draft" => "준비", "in_progress" => "진행", "closed" => "종료", "stopped" => "중단" }.fetch(election_session.status, election_session.status) %>
  <% status_class =
    if election_session.draft?
      "border-amber-200 bg-amber-50 text-amber-700"
    elsif election_session.in_progress?
      "border-emerald-200 bg-emerald-50 text-emerald-700"
    elsif election_session.closed?
      "border-stone-300 bg-stone-100 text-stone-700"
    else
      "border-rose-200 bg-rose-50 text-rose-700"
    end %>
  <% participant_slots = election_session.participant_group.participant_slots.order(:number) %>

  <h2 class="text-xl font-semibold">세션 상태</h2>
  <dl class="grid gap-3 text-sm sm:grid-cols-2">
    <div>
      <dt class="font-medium text-stone-500">상태</dt>
      <dd class="mt-1">
        <span class="rounded-md border px-2 py-1 text-xs font-medium <%= status_class %>"><%= display_status %></span>
      </dd>
    </div>
    <div>
      <dt class="font-medium text-stone-500">명단</dt>
      <dd class="mt-1 text-stone-900"><%= election_session.participant_group&.name || "명단 없음" %></dd>
    </div>
    <div>
      <dt class="font-medium text-stone-500">담당 교사</dt>
      <dd class="mt-1 text-stone-900"><%= [election_session.teacher&.name, election_session.teacher&.email].compact.join(" / ") %></dd>
    </div>
    <div>
      <dt class="font-medium text-stone-500">투표자 수</dt>
      <dd class="mt-1 text-stone-900"><%= participant_slots.size %>명</dd>
    </div>
    <% session_time_labels = election_session_status_time_labels(election_session) %>
    <% if session_time_labels.any? %>
      <div class="sm:col-span-2">
        <dt class="font-medium text-stone-500">진행 시간</dt>
        <dd class="mt-1 text-stone-900"><%= session_time_labels.join(" · ") %></dd>
      </div>
    <% end %>
  </dl>
</section>

<% if election_session.closed? %>
  <%= render "result_summary",
             election_session: election_session,
             integrity_report: integrity_report,
             contests: contests,
             participation_counts: participation_counts,
             candidate_tallies_by_candidate_id: candidate_tallies_by_candidate_id,
             contest_tallies_by_contest_id: contest_tallies_by_contest_id %>
<% elsif election_session.stopped? %>
  <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
    <h2 class="text-xl font-semibold">중단된 세션</h2>
    <p class="text-sm text-stone-600">중단된 세션은 결과 확정 상태가 아니므로 확정 결과를 표시하지 않습니다.</p>
  </section>
<% end %>

<section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
  <h2 class="text-xl font-semibold">투표 대상 학생</h2>
  <% if participant_slots.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-stone-200 text-sm">
        <thead>
          <tr class="text-left text-stone-500">
            <th class="py-2 pr-4 font-medium">번호</th>
            <th class="py-2 pr-4 font-medium">이름</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% participant_slots.each do |participant_slot| %>
            <tr>
              <td class="py-2 pr-4"><%= participant_slot.number %></td>
              <td class="py-2 pr-4"><%= participant_slot.name %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-stone-600">등록된 투표 대상 학생이 없습니다.</p>
  <% end %>
</section>
