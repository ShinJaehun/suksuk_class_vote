<section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
  <% primary_button_class = "rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
  <% secondary_button_class = "rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
  <% close_button_class = "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  <% current_voter_label = [("#{current_voter.number}번" if current_voter&.number.present?), current_voter&.name.presence].compact.join(" ").presence || "현재 투표자" %>
  <% participation = current_voter&.election_participation %>
  <% next_voter = if current_voter.present?
                    election_session.election_voters
                      .joins(:election_participation)
                      .where("election_voters.position > ?", current_voter.position)
                      .where(election_participations: { status: ElectionParticipation.statuses[:pending] })
                      .order(:position)
                      .first
                  end %>
  <% next_voter_label = [("#{next_voter.number}번" if next_voter&.number.present?), next_voter&.name.presence].compact.join(" ").presence || "다음 투표자" %>

  <h2 class="text-xl font-semibold">투표 진행</h2>

  <% if election_session.draft? %>
    <div class="space-y-3">
      <p class="text-stone-600">투표를 시작할 수 있습니다.</p>
      <%= button_to "투표 시작", start_elections_session_path(election_session), method: :post, class: primary_button_class %>
    </div>
  <% elsif election_session.in_progress? %>
    <% if current_voter.present? && participation&.pending? && progress&.open? %>
      <%= render "ballot_form",
                 election_session: election_session,
                 current_voter: current_voter,
                 contests: contests %>
    <% elsif current_voter.present? && participation&.pending? %>
      <div class="space-y-3 rounded-md border border-stone-200 bg-white p-4">
        <p class="text-lg font-medium text-stone-800">투표를 시작합니다.</p>
        <div class="flex flex-wrap gap-2">
          <%= button_to "다음 투표자는 #{current_voter_label}입니다.",
                        open_ballot_elections_session_path(election_session),
                        method: :post,
                        data: { turbo_submits_with: "여는 중..." },
                        class: primary_button_class %>
          <%= button_to "미참여 처리",
                        mark_absent_elections_session_path(election_session),
                        method: :post,
                        data: { turbo_submits_with: "처리 중..." },
                        class: secondary_button_class %>
        </div>
      </div>
    <% elsif current_voter.present? && participation.present? %>
      <div class="rounded-md border border-stone-200 bg-white p-4">
        <% if participation.completed? || participation.abstained? %>
          <p class="text-lg font-medium text-stone-800"><%= current_voter_label %>은 투표를 완료했습니다.</p>
        <% elsif participation.absent? %>
          <p class="text-lg font-medium text-stone-800"><%= current_voter_label %>은 미참여 처리되었습니다.</p>
        <% end %>

        <div class="mt-4 flex flex-wrap gap-2">
          <%= button_to next_voter.present? ? "다음 투표자는 #{next_voter_label}입니다." : "투표 진행을 마무리합니다",
                        advance_voter_elections_session_path(election_session),
                        method: :post,
                        data: { turbo_submits_with: "여는 중..." },
                        class: primary_button_class %>
        </div>
      </div>
    <% else %>
      <div class="space-y-3 rounded-md border border-stone-200 bg-white p-4">
        <p class="text-stone-600">모든 학생의 투표 처리가 끝났습니다.</p>
        <%= button_to "투표 종료",
                      close_elections_session_path(election_session),
                      method: :post,
                      data: { turbo_confirm: "투표를 종료할까요?", turbo_submits_with: "종료 중..." },
                      class: close_button_class %>
      </div>
    <% end %>
  <% elsif election_session.closed? %>
    <section class="space-y-2">
      <h2 class="text-xl font-semibold">종료된 세션</h2>
      <p class="text-sm text-stone-600">이 세션은 종료되었습니다.</p>
    </section>
  <% elsif election_session.stopped? %>
    <section class="space-y-2">
      <h2 class="text-xl font-semibold">중단된 세션</h2>
      <p class="text-sm text-stone-600">이 세션은 중단되었습니다.</p>
    </section>
  <% end %>
</section>
