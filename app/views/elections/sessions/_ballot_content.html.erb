<%= turbo_frame_tag dom_id(election_session, :ballot), class: "block space-y-6" do %>
  <% if current_voter.present? %>
    <section class="rounded-md border border-stone-200 bg-white p-4">
      <h2 class="text-xl font-semibold">현재 학생</h2>
      <p class="mt-2 text-2xl font-semibold text-stone-900">
        <%= [("#{current_voter.number}번" if current_voter.number.present?), current_voter.name.presence].compact.join(" ") %>
      </p>
    </section>

    <% participation = current_voter.election_participation %>

    <% if participation&.completed? || participation&.abstained? %>
      <section class="rounded-md border border-emerald-200 bg-emerald-50 p-4">
        <h2 class="text-xl font-semibold text-emerald-900">투표가 제출되었습니다.</h2>
        <p class="mt-2 text-sm text-emerald-800">선생님의 안내를 기다려 주세요.</p>
      </section>
    <% elsif !progress&.open? %>
      <section class="rounded-md border border-stone-200 bg-white p-4">
        <p class="text-stone-600">선생님이 투표를 시작할 때까지 기다려 주세요.</p>
      </section>
    <% else %>
      <%= form_with url: submit_ballot_elections_session_path(election_session, return_to: "ballot"),
                    scope: :ballot,
                    data: { controller: "election-ballot" } do |form| %>
        <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
          <h2 class="text-xl font-semibold">선거 항목</h2>

          <% contests.each_with_index do |contest, index| %>
            <% candidates = contest.election_candidates.order(:number) %>
            <% card_count = candidates.size %>
            <% grid_class, fieldset_padding_class, grid_gap_class, card_padding_class, placeholder_class, name_class, meta_class =
              case card_count
              when 1..4
                [ "grid-cols-2", "p-4", "gap-3", "p-3", "aspect-[4/3]", "mt-3 text-lg", "mt-1 text-sm" ]
              when 5..6
                [ "grid-cols-3", "p-3", "gap-3", "p-3", "aspect-[5/3]", "mt-2 text-base", "mt-1 text-sm" ]
              when 7..9
                [ "grid-cols-3", "p-3", "gap-2", "p-2", "aspect-[8/3]", "mt-2 text-base", "mt-0.5 text-xs" ]
              when 10..12
                [ "grid-cols-4", "p-2", "gap-2", "p-2", "aspect-[10/3]", "mt-1.5 text-sm", "mt-0.5 text-xs" ]
              else
                [ "grid-cols-5", "p-2", "gap-1.5", "p-1.5", "aspect-[12/3]", "mt-1 text-sm", "mt-0.5 text-xs" ]
              end %>
            <fieldset class="rounded-md border border-stone-200 <%= fieldset_padding_class %>"
                      data-election-ballot-target="contest"
                      data-election-ballot-index="<%= index %>"
                      <%= "hidden" unless index.zero? %>>
              <legend class="text-lg font-medium"><%= contest.title %></legend>
              <p class="mt-1 text-sm text-stone-500"><%= index + 1 %> / <%= contests.size %></p>
              <div class="mt-3 grid <%= grid_class %> <%= grid_gap_class %>">
                <% candidates.each do |candidate| %>
                  <% choice_id = "ballot_contest_#{contest.id}_candidate_#{candidate.id}" %>
                  <%= radio_button_tag "ballot[contest_choices][#{contest.id}]",
                                       "candidate:#{candidate.id}",
                                       false,
                                       id: choice_id,
                                       class: "sr-only",
                                       data: { election_ballot_target: "choice" } %>
                  <button type="button"
                          class="rounded-md border border-stone-200 bg-white <%= card_padding_class %> text-left shadow-sm hover:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                          data-action="election-ballot#choose"
                          data-election-ballot-choice-id-param="<%= choice_id %>">
                    <span class="candidate-photo-placeholder block <%= placeholder_class %> rounded-md bg-stone-100" aria-hidden="true"></span>
                    <span class="<%= name_class %> block font-semibold text-stone-900">
                      <%= candidate.number %>번 <%= candidate.name %>
                    </span>
                    <% if candidate.affiliation_label.present? %>
                      <span class="<%= meta_class %> block text-stone-600"><%= candidate.affiliation_label %></span>
                    <% end %>
                  </button>
                <% end %>
              </div>

              <% if contest.allow_abstain? %>
                <% abstain_id = "ballot_contest_#{contest.id}_abstain" %>
                <div class="mt-3">
                  <%= radio_button_tag "ballot[contest_choices][#{contest.id}]",
                                       "abstain",
                                       false,
                                       id: abstain_id,
                                       class: "sr-only",
                                       data: { election_ballot_target: "choice" } %>
                  <button type="button"
                          class="rounded-md border border-stone-200 bg-white px-3 py-2 text-sm font-medium text-stone-700 shadow-sm hover:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                          data-action="election-ballot#choose"
                          data-election-ballot-choice-id-param="<%= abstain_id %>">
                    기권
                  </button>
                </div>
              <% end %>
            </fieldset>
          <% end %>
        </section>

        <%= form.submit "투표 제출",
                        class: "sr-only",
                        data: { election_ballot_target: "submit" } %>
      <% end %>
    <% end %>
  <% else %>
    <section class="rounded-md border border-stone-200 bg-white p-4">
      <p class="text-stone-600">현재 학생을 찾을 수 없습니다.</p>
    </section>
  <% end %>
<% end %>
