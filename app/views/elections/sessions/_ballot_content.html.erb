<%= turbo_frame_tag dom_id(election_session, :ballot), class: "block space-y-3" do %>
  <% if election_session.stopped? %>
    <section class="mx-auto max-w-4xl rounded-md border border-rose-300 bg-rose-50 p-8 text-center">
      <h1 class="text-3xl font-semibold text-rose-900">이전 투표가 중단되었습니다.</h1>
      <p class="mt-4 text-xl font-medium text-rose-800">이 창을 닫고 새로 시작한 투표 화면을 열어 주세요.</p>
      <p class="mt-3 text-sm text-rose-700">재투표가 시작되면 교사 화면에서 새 투표 화면을 다시 열 수 있습니다.</p>
    </section>
  <% else %>

    <header class="mx-auto flex max-w-6xl items-end justify-between gap-4 rounded-md border border-stone-200 bg-white px-3 py-2">
    <section>
      <p class="text-xs font-medium text-stone-600">학생 투표 화면</p>
      <h1 class="text-2xl font-semibold"><%= election_session.election.title %></h1>
    </section>
    <section class="shrink-0 text-right">
      <p class="text-xs font-medium text-stone-600">현재 투표자</p>
      <p class="text-2xl font-semibold text-stone-900">
        <%= current_voter.present? ? [("#{current_voter.number}번" if current_voter.number.present?), current_voter.name.presence].compact.join(" ") : "" %>
      </p>
    </section>
    </header>

    <% if current_voter.present? %>
    <% participation = current_voter.election_participation %>

    <% if participation&.completed? || participation&.abstained? %>
      <section class="mx-auto max-w-6xl rounded-md border border-emerald-200 bg-emerald-50 p-4">
        <h2 class="text-xl font-semibold text-emerald-900">투표가 제출되었습니다.</h2>
        <p class="mt-2 text-sm text-emerald-800">선생님의 안내를 기다려 주세요.</p>
      </section>
    <% elsif !progress&.open? %>
      <section class="mx-auto max-w-6xl rounded-md border border-stone-200 bg-white p-4">
        <p class="text-stone-600">선생님이 투표를 시작할 때까지 기다려 주세요.</p>
      </section>
    <% else %>
      <%= form_with url: submit_ballot_elections_session_path(election_session, return_to: "ballot"),
                    scope: :ballot,
                    data: {
                      controller: "election-ballot",
                      action: "submit->election-ballot#submit"
                    } do |form| %>
        <section class="bg-stone-50">
          <% contests.each_with_index do |contest, index| %>
            <% candidates = contest.election_candidates.order(:number) %>
            <% card_count = candidates.size %>
            <% grid_class, content_width_class, fieldset_padding_class, grid_gap_class, card_padding_class, placeholder_class, name_class =
              case card_count
              when 1
                [ "grid-cols-1", "max-w-lg mx-auto", "p-0", "gap-2", "p-2", "aspect-[3/2]", "mt-1.5 text-lg leading-tight break-keep" ]
              when 2
                [ "grid-cols-2", "max-w-4xl mx-auto", "p-0", "gap-2", "p-2", "aspect-[3/2]", "mt-1.5 text-lg leading-tight break-keep" ]
              when 3
                [ "grid-cols-3", "max-w-5xl mx-auto", "p-0", "gap-2", "p-2", "aspect-[3/2]", "mt-1.5 text-base leading-tight break-keep" ]
              when 4
                [ "grid-cols-4", "max-w-6xl mx-auto", "p-0", "gap-2", "p-2", "aspect-[3/2]", "mt-1.5 text-base leading-tight break-keep" ]
              when 5..8
                [ "grid-cols-4", "max-w-6xl mx-auto", "p-0", "gap-2", "p-1.5", "aspect-[3/2]", "mt-1 text-base leading-tight break-keep" ]
              when 9..12
                [ "grid-cols-6", "max-w-[1440px] mx-auto", "p-0", "gap-1.5", "p-1.5", "aspect-[3/2]", "mt-1 text-base leading-tight break-keep" ]
              when 13..18
                [ "grid-cols-6", "max-w-[1500px] mx-auto", "p-0", "gap-1.5", "p-1.5", "aspect-[3/2]", "mt-1 text-base leading-tight break-keep" ]
              else
                [ "grid-cols-7", "max-w-[1760px] mx-auto", "p-0", "gap-1.5", "p-1.5", "aspect-[3/2]", "mt-1 text-sm leading-tight break-keep" ]
              end %>
            <fieldset class="<%= fieldset_padding_class %>"
                      data-election-ballot-target="contest"
                      data-election-ballot-index="<%= index %>"
                      <%= "hidden" unless index.zero? %>>
              <div class="<%= content_width_class %>">
                <h2 class="px-1 text-xl font-semibold leading-tight"><%= contest.title %></h2>
                <div class="mt-1 grid <%= grid_class %> <%= grid_gap_class %>">
                  <% candidates.each do |candidate| %>
                    <% choice_id = "ballot_contest_#{contest.id}_candidate_#{candidate.id}" %>
                    <% unless candidate.photo.attached? %>
                      <% avatar_index = ((contest.id.to_i * 7) + (candidate.id.to_i * 11) + candidate.number.to_i) % 30 %>
                      <% avatar_prefix = avatar_index.even? ? "boy" : "girl" %>
                      <% avatar_number = ((avatar_index / 2) % 15) + 1 %>
                      <% avatar_path = "avatars/#{avatar_prefix}#{avatar_number.to_s.rjust(2, "0")}.png" %>
                    <% end %>
                    <%= radio_button_tag "ballot[contest_choices][#{contest.id}]",
                                         "candidate:#{candidate.id}",
                                         false,
                                         id: choice_id,
                                         class: "sr-only",
                                         data: { election_ballot_target: "choice" } %>
                    <button type="button"
                            class="rounded-md border border-stone-200 bg-white <%= card_padding_class %> text-left shadow-sm transition duration-150 ease-out hover:-translate-y-0.5 hover:border-emerald-500 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-emerald-500 disabled:cursor-not-allowed disabled:opacity-50"
                            data-action="election-ballot#choose"
                            data-election-ballot-target="card"
                            data-election-ballot-choice-id-param="<%= choice_id %>">
                      <span class="candidate-photo-placeholder relative block <%= placeholder_class %> overflow-hidden rounded-md bg-stone-100">
                        <% if candidate.photo.attached? %>
                          <%= image_tag rails_blob_path(candidate.photo, only_path: true),
                                        alt: "#{candidate.name} 후보 사진",
                                        class: "h-full w-full object-cover",
                                        loading: "lazy" %>
                        <% else %>
                          <%= image_tag avatar_path,
                                        alt: "",
                                        class: "h-full w-full object-contain",
                                        loading: "lazy" %>
                        <% end %>
                        <%= image_tag "election_vote_stamp.svg",
                                      alt: "",
                                      class: "pointer-events-none absolute bottom-1 right-1 h-[32%] w-[32%] origin-center scale-75 opacity-0 drop-shadow-md transition duration-200 ease-out",
                                      data: { election_ballot_target: "stamp" },
                                      aria: { hidden: true } %>
                      </span>
                      <span class="<%= name_class %> block min-w-0 break-words font-semibold text-stone-900 [overflow-wrap:anywhere]">
                        <%= candidate.number %>번 <%= candidate.name %>
                      </span>
                    </button>
                  <% end %>
                </div>

                <p class="mt-2 hidden rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-sm font-medium text-amber-900"
                   data-election-ballot-target="warning">
                  후보 또는 기권을 선택한 뒤 제출해 주세요.
                </p>

                <div class="mt-2 flex items-center justify-between gap-2">
                  <% if contest.allow_abstain? %>
                    <% abstain_id = "ballot_contest_#{contest.id}_abstain" %>
                    <div>
                      <%= radio_button_tag "ballot[contest_choices][#{contest.id}]",
                                           "abstain",
                                           false,
                                           id: abstain_id,
                                           class: "sr-only",
                                           data: { election_ballot_target: "choice" } %>
                      <button type="button"
                              class="rounded-md border-2 border-amber-300 bg-amber-50 px-4 py-2 text-sm font-semibold text-amber-900 shadow-sm transition duration-150 ease-out hover:border-amber-500 hover:bg-amber-100 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-amber-500 disabled:cursor-not-allowed disabled:opacity-50"
                              data-action="election-ballot#choose"
                              data-election-ballot-target="card"
                              data-election-ballot-choice-id-param="<%= abstain_id %>">
                        기권
                      </button>
                    </div>
                  <% else %>
                    <span aria-hidden="true"></span>
                  <% end %>

                  <button type="button"
                          class="rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 disabled:cursor-not-allowed disabled:opacity-50"
                          data-action="election-ballot#submitContest">
                    <%= index == contests.size - 1 ? "최종제출" : "제출" %>
                  </button>
                </div>
              </div>
            </fieldset>
          <% end %>
        </section>

        <%= form.submit "투표 제출",
                        class: "sr-only",
                        data: { election_ballot_target: "submit" } %>
      <% end %>
    <% end %>
    <% else %>
      <section class="mx-auto max-w-6xl rounded-md border border-stone-200 bg-white p-4">
        <p class="text-stone-600">현재 학생을 찾을 수 없습니다.</p>
      </section>
    <% end %>
  <% end %>
<% end %>
