<%= turbo_frame_tag dom_id(election_session, :ballot), class: "block space-y-3" do %>

  <header class="mx-auto flex max-w-6xl items-end justify-between gap-4 rounded-md border border-stone-200 bg-white px-3 py-2">
    <section>
      <p class="text-xs font-medium text-stone-600">학생 투표 화면</p>
      <h1 class="text-2xl font-semibold"><%= election_session.election.title %></h1>
    </section>
    <section class="shrink-0 text-right">
      <p class="text-xs font-medium text-stone-600">현재 투표자</p>
      <p class="text-2xl font-semibold text-stone-900">
        <%= current_voter.present? ? [("#{current_voter.number}번" if current_voter.number.present?), current_voter.name.presence].compact.join(" ") : "" %>
      </p>
    </section>
  </header>

  <% if current_voter.present? %>
    <% participation = current_voter.election_participation %>

    <% if participation&.completed? || participation&.abstained? %>
      <section class="mx-auto max-w-6xl rounded-md border border-emerald-200 bg-emerald-50 p-4">
        <h2 class="text-xl font-semibold text-emerald-900">투표가 제출되었습니다.</h2>
        <p class="mt-2 text-sm text-emerald-800">선생님의 안내를 기다려 주세요.</p>
      </section>
    <% elsif !progress&.open? %>
      <section class="mx-auto max-w-6xl rounded-md border border-stone-200 bg-white p-4">
        <p class="text-stone-600">선생님이 투표를 시작할 때까지 기다려 주세요.</p>
      </section>
    <% else %>
      <%= form_with url: submit_ballot_elections_session_path(election_session, return_to: "ballot"),
                    scope: :ballot,
                    data: { controller: "election-ballot" } do |form| %>
        <section class="bg-stone-50">
          <% contests.each_with_index do |contest, index| %>
            <% candidates = contest.election_candidates.order(:number) %>
            <% card_count = candidates.size %>
            <% grid_class, content_width_class, fieldset_padding_class, grid_gap_class, card_padding_class, placeholder_class, name_class =
              case card_count
              when 1..2
                [ "grid-cols-2", "max-w-2xl mx-auto", "p-0", "gap-2", "p-2", "aspect-[4/3]", "mt-2 text-base" ]
              when 3
                [ "grid-cols-3", "max-w-3xl mx-auto", "p-0", "gap-2", "p-2", "aspect-[4/3]", "mt-2 text-base" ]
              when 1..4
                [ "grid-cols-4", "max-w-5xl mx-auto", "p-0", "gap-2", "p-2", "aspect-[4/3]", "mt-2 text-base" ]
              when 5..6
                [ "grid-cols-6", "", "p-0", "gap-2", "p-1.5", "aspect-square", "mt-1.5 text-sm" ]
              when 7..9
                [ "grid-cols-5", "", "p-0", "gap-1.5", "p-1.5", "aspect-square", "mt-1 text-sm" ]
              when 10..12
                [ "grid-cols-6", "", "p-0", "gap-1.5", "p-1.5", "aspect-square", "mt-1 text-xs" ]
              else
                [ "grid-cols-7", "", "p-0", "gap-1", "p-1", "aspect-square", "mt-1 text-xs" ]
              end %>
            <fieldset class="<%= fieldset_padding_class %>"
                      data-election-ballot-target="contest"
                      data-election-ballot-index="<%= index %>"
                      <%= "hidden" unless index.zero? %>>
              <div class="<%= content_width_class %>">
                <h2 class="px-1 text-2xl font-semibold"><%= contest.title %></h2>
                <div class="mt-2 grid <%= grid_class %> <%= grid_gap_class %>">
                  <% candidates.each do |candidate| %>
                    <% choice_id = "ballot_contest_#{contest.id}_candidate_#{candidate.id}" %>
                    <% unless candidate.photo.attached? %>
                      <% avatar_index = ((contest.id.to_i * 7) + (candidate.id.to_i * 11) + candidate.number.to_i) % 30 %>
                      <% avatar_prefix = avatar_index.even? ? "boy" : "girl" %>
                      <% avatar_number = ((avatar_index / 2) % 15) + 1 %>
                      <% avatar_path = "avatars/#{avatar_prefix}#{avatar_number.to_s.rjust(2, "0")}.png" %>
                    <% end %>
                    <%= radio_button_tag "ballot[contest_choices][#{contest.id}]",
                                         "candidate:#{candidate.id}",
                                         false,
                                         id: choice_id,
                                         class: "sr-only",
                                         data: { election_ballot_target: "choice" } %>
                    <button type="button"
                            class="rounded-md border border-stone-200 bg-white <%= card_padding_class %> text-left shadow-sm hover:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                            data-action="election-ballot#choose"
                            data-election-ballot-choice-id-param="<%= choice_id %>">
                      <span class="candidate-photo-placeholder block <%= placeholder_class %> overflow-hidden rounded-md bg-stone-100">
                        <% if candidate.photo.attached? %>
                          <%= image_tag candidate.photo,
                                        alt: "#{candidate.name} 후보 사진",
                                        class: "h-full w-full object-cover",
                                        loading: "lazy" %>
                        <% else %>
                          <%= image_tag avatar_path,
                                        alt: "",
                                        class: "h-full w-full object-contain",
                                        loading: "lazy" %>
                        <% end %>
                      </span>
                      <span class="<%= name_class %> block font-semibold text-stone-900">
                        <%= candidate.number %>번 <%= candidate.name %>
                      </span>
                    </button>
                  <% end %>
                </div>

                <% if contest.allow_abstain? %>
                  <% abstain_id = "ballot_contest_#{contest.id}_abstain" %>
                  <div class="mt-2">
                    <%= radio_button_tag "ballot[contest_choices][#{contest.id}]",
                                         "abstain",
                                         false,
                                         id: abstain_id,
                                         class: "sr-only",
                                         data: { election_ballot_target: "choice" } %>
                    <button type="button"
                            class="rounded-md border border-stone-200 bg-white px-2.5 py-1.5 text-xs font-medium text-stone-700 shadow-sm hover:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                            data-action="election-ballot#choose"
                            data-election-ballot-choice-id-param="<%= abstain_id %>">
                      기권
                    </button>
                  </div>
                <% end %>
              </div>
            </fieldset>
          <% end %>
        </section>

        <%= form.submit "투표 제출",
                        class: "sr-only",
                        data: { election_ballot_target: "submit" } %>
      <% end %>
    <% end %>
  <% else %>
    <section class="mx-auto max-w-6xl rounded-md border border-stone-200 bg-white p-4">
      <p class="text-stone-600">현재 학생을 찾을 수 없습니다.</p>
    </section>
  <% end %>
<% end %>
