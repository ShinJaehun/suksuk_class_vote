<div class="space-y-6">
  <% if @election_session.in_progress? %>
    <%= turbo_stream_from @election_session, :operation_screen %>
  <% end %>

  <% if policy(@election_session).revote? && (@election_session.in_progress? || @election_session.closed?) %>
    <div class="flex justify-end">
      <%= button_to "재투표",
                    revote_admin_election_election_session_path(@election, @election_session),
                    method: :post,
                    class: "inline-flex rounded-md border border-rose-600 px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-50",
                    form: {
                      data: {
                        turbo_confirm: "이 학급의 기존 투표를 중단 처리하고 재투표를 준비할까요?"
                      }
                    } %>
    </div>
  <% end %>

  <% if current_user.admin? %>
    <div class="space-y-2">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-3xl font-semibold"><%= @election.title %></h1>
        <%= election_kind_badge(@election) %>
      </div>
    </div>

    <%= render "admin_summary",
               election_session: @election_session,
               progress: @progress,
               current_voter: @current_voter,
               voters: @voters,
               contests: @contests,
               integrity_report: @integrity_report,
               participation_counts: @participation_counts,
               candidate_tallies_by_candidate_id: @candidate_tallies_by_candidate_id,
               contest_tallies_by_contest_id: @contest_tallies_by_contest_id %>

  <% elsif @election_session.closed? %>
    <%= render "teacher_progress",
               election_session: @election_session,
               progress: @progress,
               current_voter: @current_voter %>

    <div class="flex justify-end">
      <button type="button"
              onclick="window.print()"
              class="election-session-result-print-button inline-flex rounded-md border border-stone-300 px-3 py-2 text-sm font-medium text-stone-700">
        결과 인쇄
      </button>
    </div>

    <%= render "closed_results",
               election_session: @election_session,
               contests: @contests,
               candidate_tallies_by_candidate_id: @candidate_tallies_by_candidate_id,
               contest_tallies_by_contest_id: @contest_tallies_by_contest_id %>
  <% else %>
    <%= render "teacher_progress",
               election_session: @election_session,
               progress: @progress,
               current_voter: @current_voter %>

    <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
      <h2 class="text-xl font-semibold">선거 항목</h2>
      <div class="space-y-4">
        <% @contests.each do |contest| %>
          <div class="rounded-md border border-stone-200 p-4">
            <h3 class="text-lg font-medium"><%= contest.title %></h3>
            <ul class="mt-3 space-y-1 text-sm text-stone-700">
              <% contest.election_candidates.order(:number).each do |candidate| %>
                <li><%= candidate.number %>번 <%= candidate.name %><%= " (#{candidate.affiliation_label})" if candidate.affiliation_label.present? %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
