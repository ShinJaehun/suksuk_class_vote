<% total_voter_count = participation_counts.values.sum %>
<% completed_count = participation_counts.fetch("completed", 0) %>
<% not_participated_count = total_voter_count - completed_count %>

<section class="space-y-5 rounded-md border border-stone-200 bg-white p-4">
  <header class="space-y-2">
    <div class="flex flex-wrap items-center gap-2">
      <h2 class="text-2xl font-semibold text-stone-900">투표 결과</h2>
    </div>
  </header>

  <dl class="grid gap-2 text-sm sm:grid-cols-3">
    <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
      <dt class="text-stone-500">전체 투표자</dt>
      <dd class="mt-1 font-semibold text-stone-900"><%= total_voter_count %>명</dd>
    </div>
    <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
      <dt class="text-stone-500">투표 완료</dt>
      <dd class="mt-1 font-semibold text-stone-900"><%= completed_count %>명</dd>
    </div>
    <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
      <dt class="text-stone-500">미참여</dt>
      <dd class="mt-1 font-semibold text-stone-900"><%= not_participated_count %>명</dd>
    </div>
  </dl>

  <div class="grid gap-3 lg:grid-cols-2">
    <% contests.each do |contest| %>
      <% candidates = contest.election_candidates.order(:number) %>
      <% candidate_rows = candidates.map { |candidate| [ candidate, candidate_tallies_by_candidate_id[candidate.id]&.votes_count.to_i ] } %>
      <% contest_tally = contest_tallies_by_contest_id[contest.id] %>
      <% abstentions_count = contest_tally&.abstentions_count.to_i %>

      <article class="space-y-3 rounded-md border border-stone-200 bg-stone-50 p-3">
        <div class="space-y-1">
          <h3 class="text-lg font-semibold text-stone-900"><%= contest.title %></h3>
        </div>

        <div class="grid gap-1 md:grid-cols-2">
          <% candidate_rows.each do |candidate, votes_count| %>
            <div class="flex items-center gap-2 rounded-md border border-stone-200 bg-white px-3 py-2 text-sm">
              <span class="w-14 shrink-0 whitespace-nowrap font-medium text-stone-500">기호 <%= candidate.number %></span>
              <span class="min-w-0 flex-1 font-medium text-stone-900"><%= candidate.name %><%= " (#{candidate.affiliation_label})" if candidate.affiliation_label.present? %></span>
              <span class="w-12 shrink-0 text-right font-semibold tabular-nums text-stone-900"><%= votes_count %>표</span>
            </div>
          <% end %>
        </div>

        <div class="border-t border-stone-200 pt-2 text-sm">
          <p class="font-medium text-stone-700">기권 <%= abstentions_count %>표</p>
        </div>
      </article>
    <% end %>
  </div>
</section>
