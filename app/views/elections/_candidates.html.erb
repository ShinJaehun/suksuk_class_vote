<section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <h2 class="text-xl font-semibold">후보자</h2>

    <% if election.draft? %>
      <p><%= link_to "후보자 추가", new_election_candidate_path(election), class: "inline-flex rounded-md bg-stone-900 px-3 py-2 text-sm font-medium text-white" %></p>
    <% end %>
  </div>

  <% if election.candidates.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="border-b border-stone-200 text-stone-500">
          <tr>
            <th class="px-3 py-2 font-medium">기호</th>
            <th class="px-3 py-2 font-medium">이름</th>
            <th class="px-3 py-2 font-medium">관리</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% election.candidates.order(:number).each do |candidate| %>
            <tr>
              <td class="px-3 py-3"><%= candidate.number %>번</td>
              <td class="px-3 py-3 font-medium"><%= candidate.name %></td>
              <td class="px-3 py-3">
                <% if election.draft? %>
                  <div class="flex flex-wrap items-center gap-2">
                    <%= link_to "수정", edit_election_candidate_path(election, candidate), class: "text-sm font-medium text-stone-700 underline" %>
                    <%= button_to "삭제",
                                  election_candidate_path(election, candidate),
                                  method: :delete,
                                  class: "text-sm font-medium text-stone-700 underline" %>
                  </div>
                <% else %>
                  <span class="text-stone-600">후보자 관리가 종료되었습니다.</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-stone-600">아직 등록된 후보자가 없습니다.</p>
  <% end %>
</section>
