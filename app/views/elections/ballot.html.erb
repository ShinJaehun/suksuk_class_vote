<div class="mx-auto max-w-2xl space-y-6">
  <div class="space-y-2">
    <h1 class="text-3xl font-semibold"><%= @election.title %></h1>
    <p class="text-stone-600">투표 화면</p>
  </div>

  <% if @current_election_voter.present? %>
    <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
      <div class="rounded-md border border-stone-200 bg-stone-50 p-4">
        <p class="text-sm font-medium text-stone-500">현재 투표자</p>
        <p class="mt-1 text-2xl font-semibold"><%= @current_election_voter.number %>번 <%= @current_election_voter.name %></p>
      </div>

      <% if @current_election_voter.election_voter_participation.present? %>
        <p class="text-stone-600">현재 투표자는 이미 처리되었습니다.</p>
        <% if @next_election_voter.present? %>
          <%= button_to "다음 투표자는 #{@next_election_voter.number}번 #{@next_election_voter.name}입니다",
                        advance_current_voter_election_path(@election),
                        method: :post,
                        params: { return_to: "ballot" },
                        class: "rounded-md bg-stone-900 px-4 py-3 text-sm font-medium text-white" %>
        <% else %>
          <p class="text-stone-600">모든 투표자가 처리되었습니다. 창을 닫아주세요.</p>
        <% end %>
      <% else %>
        <div class="space-y-3">
          <h2 class="text-xl font-semibold">후보 선택</h2>
          <div class="grid gap-3 sm:grid-cols-2">
            <% @election.candidates.order(:number).each do |candidate| %>
              <%= button_to "#{candidate.number}번 #{candidate.name}",
                            submit_vote_election_path(@election),
                            method: :post,
                            params: { candidate_id: candidate.id, return_to: "ballot" },
                            class: "rounded-md bg-stone-900 px-4 py-4 text-lg font-medium text-white" %>
            <% end %>
          </div>

          <%= button_to "기권 처리",
                        record_participation_outcome_election_path(@election),
                        method: :post,
                        params: { status: "abstained", return_to: "ballot" },
                        class: "rounded-md border border-stone-300 px-4 py-3 text-sm font-medium text-stone-700" %>
          <%= button_to "미참여 처리",
                        record_participation_outcome_election_path(@election),
                        method: :post,
                        params: { status: "absent", return_to: "ballot" },
                        class: "rounded-md border border-stone-300 px-4 py-3 text-sm font-medium text-stone-700" %>
        </div>
      <% end %>
    </section>
  <% else %>
    <section class="rounded-md border border-stone-200 bg-white p-4">
      <p class="text-stone-600">현재 투표자를 찾을 수 없습니다.</p>
    </section>
  <% end %>
</div>
