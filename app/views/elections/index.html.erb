<div class="flex items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold">선거</h1>

  <%= link_to "새 선거 만들기",
              new_election_path,
              class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
</div>

<% if @elections.any? %>
  <ul class="space-y-3">
    <% @elections.each do |election| %>
      <li class="rounded-md border border-stone-200 bg-white p-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="space-y-1">
            <h2 class="font-medium"><%= election.title %></h2>
            <p class="text-sm text-stone-600">
              <%= election.status %>
              · <%= election.voter_group.name %>
              · 학생 <%= election.voter_group.voter_slots.size %>명
            </p>
          </div>

          <%= link_to "상세",
                      election_path(election),
                      class: "text-sm font-medium text-stone-700 underline" %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="rounded-md border border-stone-200 bg-white p-4 text-stone-600">아직 만든 선거가 없습니다.</p>
<% end %>
