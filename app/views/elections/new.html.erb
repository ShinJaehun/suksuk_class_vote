<h1>새 선거 만들기</h1>

<p>학생이 등록된 투표자 그룹만 사용할 수 있습니다.</p>

<% if @election.errors.any? %>
  <h2>선거를 만들 수 없습니다.</h2>
  <ul>
    <% @election.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @election do |form| %>
  <div>
    <%= form.label :title, "선거 이름" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :voter_group_id, "투표자 그룹" %>
    <%= form.select :voter_group_id,
                    @selectable_voter_groups.map { |voter_group| ["#{voter_group.name} (학생 #{voter_group.voter_slots.size}명)", voter_group.id] },
                    { prompt: "투표자 그룹을 선택하세요" } %>
  </div>

  <%= form.submit "선거 만들기" %>
<% end %>

<p><%= link_to "목록으로 돌아가기", elections_path %></p>
