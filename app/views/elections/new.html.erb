<div class="space-y-6">
  <div class="space-y-2">
    <h1 class="text-2xl font-semibold">새 선거 만들기</h1>

    <p class="text-sm text-stone-600">학생이 등록된 투표자 그룹만 사용할 수 있습니다.</p>
  </div>

  <% if @election.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-4 text-red-800">
      <h2 class="font-medium">선거를 만들 수 없습니다.</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% @election.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @election, class: "space-y-4 rounded-md border border-stone-200 bg-white p-4" do |form| %>
    <div class="space-y-1">
      <%= form.label :title, "선거 이름", class: "text-sm font-medium text-stone-700" %>
      <%= form.text_field :title, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>

    <div class="space-y-1">
      <%= form.label :kind, "활동 유형", class: "text-sm font-medium text-stone-700" %>
      <%= form.select :kind,
                      [["선거", "election"], ["토의", "discussion"]],
                      {},
                      class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
      <p class="text-sm text-stone-600">선거 또는 토의 중 하나를 선택하세요.</p>
    </div>

    <div class="space-y-1">
      <%= form.label :voter_group_id, "투표자 그룹", class: "text-sm font-medium text-stone-700" %>
      <%= form.select :voter_group_id,
                      @selectable_voter_groups.map { |voter_group| ["#{voter_group.name} (학생 #{voter_group.voter_slots.size}명)", voter_group.id] },
                      { prompt: "투표자 그룹을 선택하세요" },
                      class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>

    <%= form.submit "선거 만들기", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  <% end %>

  <p><%= link_to "목록으로 돌아가기", elections_path, class: "text-sm font-medium text-stone-700 underline" %></p>
</div>
