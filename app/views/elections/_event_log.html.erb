<section class="space-y-3 rounded-md border border-stone-200 bg-white p-4" data-testid="election-event-log">
  <h2 class="text-xl font-semibold">운영 기록</h2>

  <% if election_events.any? %>
    <ul class="divide-y divide-stone-200">
      <% election_events.each do |event| %>
        <% target =
          if event.election_level_event?
            event.actor&.name.presence || event.actor&.email
          elsif event.voter_level_event? && event.election_voter.present?
            "#{event.election_voter.number}번 #{event.election_voter.name}"
          end
        %>

        <li class="grid gap-2 py-3 text-sm sm:grid-cols-[10rem_1fr_1fr]">
          <time class="text-stone-500" datetime="<%= event.occurred_at.iso8601 %>">
            <%= l(event.occurred_at, format: :short) %>
          </time>
          <span class="text-stone-600"><%= target %></span>
          <span class="font-medium"><%= event.display_label %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-stone-600">아직 운영 기록이 없습니다.</p>
  <% end %>
</section>
