<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "쑥쑥교실투표" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="쑥쑥교실투표">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "suksuk_logo.png" %>
    <%= favicon_link_tag "suksuk_logo.png", rel: "apple-touch-icon" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-stone-50 text-stone-900">
    <% unless content_for?(:hide_navigation) %>
      <header class="border-b border-stone-200 bg-white">
        <nav class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
          <div class="flex flex-wrap items-center gap-4">
            <%= link_to root_path, class: "inline-flex items-center gap-2 font-semibold" do %>
              <%= image_tag "suksuk_logo.png", alt: "", class: "h-7 w-7 object-contain" %>
              <span>쑥쑥교실투표</span>
            <% end %>
            <% if user_signed_in? %>
              <% if current_user.teacher? %>
                <% unless current_user.admin? %>
                  <%= link_to "내 투표",
                              polls_path,
                              class: "text-sm text-stone-600 hover:text-stone-900" %>

                  <% if current_user.active_classroom %>
                    <%= link_to "내 교실",
                                classroom_students_path(current_user.active_classroom),
                                class: "text-sm text-stone-600 hover:text-stone-900" %>
                  <% end %>              
                <% end %>
              <% end %>
              <% if current_user.admin? || current_user.school_membership&.manager? %>
                <% if current_user.teacher? %>
                  <% unless current_user.admin? %>
                    <span class="mx-1 hidden h-5 border-l border-stone-300 sm:inline-block"
                          data-testid="navigation-divider"></span>
                  <% end %>                
                <% end %>
                <%= link_to "전교투표",
                            school_polls_path,
                            class: "text-sm text-stone-600 hover:text-stone-900" %>
                <% if current_user.admin? %>
                  <%= link_to "학급투표",
                              admin_classroom_poll_sessions_path,
                              class: "text-sm text-stone-600 hover:text-stone-900" %>
                <% end %>
                <span class="mx-1 hidden h-5 border-l border-stone-300 sm:inline-block" data-testid="navigation-divider"></span>
                <%= link_to "학교",
                            schools_path,
                            class: "text-sm text-stone-600 hover:text-stone-900" %>
                <%= link_to "교실",
                            classrooms_path,
                            class: "text-sm text-stone-600 hover:text-stone-900" %>
                <%= link_to "선생님",
                            teachers_path,
                            class: "text-sm text-stone-600 hover:text-stone-900" %>
              <% end %>
            <% end %>
          </div>

          <div class="flex flex-wrap items-center gap-3 text-sm text-stone-600">
            <% if user_signed_in? %>
              <%= link_to current_user.login_id,
                          edit_password_change_path,
                          class: "font-medium text-stone-700 underline",
                          data: { testid: "current-user-account-link" } %>
              <%= button_to "로그아웃",
                            destroy_user_session_path,
                            method: :delete,
                            class: "font-medium text-stone-700 underline" %>
            <% else %>
              <%= link_to "로그인", new_user_session_path, class: "font-medium text-stone-700 underline" %>
            <% end %>
          </div>
        </nav>
      </header>
    <% end %>

    <main class="<%= content_for?(:ballot_screen_layout) ? "min-h-screen px-2 py-2" : "mx-auto max-w-5xl space-y-6 px-4 py-8 sm:px-6 lg:px-8" %>">
      <% inactive_school_message =
           if user_signed_in? && current_user.admin? && @school.present? && !@school.active?
             "현재 비활성 학교입니다. 투표 운영은 중단되며, 학교 정보와 구성원은 관리할 수 있습니다."
           elsif user_signed_in? && current_user.school_membership&.school && !current_user.school_membership.school.active?
             "현재 학교가 비활성 상태입니다. 기존 정보는 조회할 수 있지만 운영 내용은 변경할 수 없습니다."
           end %>
      <% if inactive_school_message.present? %>
        <p class="rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-800">
          <%= inactive_school_message %>
        </p>
      <% end %>

      <div id="application_flash">
        <% if !content_for?(:hide_ballot_flash) && (notice.present? || alert.present?) %>
          <div class="<%= content_for?(:ballot_screen_layout) ? "mx-auto mb-3 max-w-5xl space-y-2" : "space-y-2" %>">
            <% if notice.present? %>
              <p class="rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800">
                <%= notice %>
              </p>
            <% end %>

            <% if alert.present? %>
              <p class="rounded-md border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-800">
                <%= alert %>
              </p>
            <% end %>
          </div>
        <% end %>
      </div>

      <%= yield %>
    </main>
  </body>
</html>
