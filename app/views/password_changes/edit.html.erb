<div class="mx-auto max-w-md space-y-6">
  <div class="space-y-1">
    <h1 class="text-3xl font-semibold">비밀번호 변경</h1>
    <p class="text-sm text-stone-600">현재 비밀번호를 확인한 뒤 새 비밀번호로 변경합니다.</p>
  </div>

  <% if current_user.errors.any? %>
    <section class="rounded-md border border-rose-200 bg-rose-50 p-4 text-rose-800">
      <ul class="list-disc space-y-1 pl-5 text-sm">
        <% current_user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= form_with model: current_user, url: password_change_path, method: :patch, class: "space-y-4 rounded-md border border-stone-200 bg-white p-6" do |form| %>
    <div class="space-y-1">
      <%= form.label :current_password, "현재 비밀번호", class: "text-sm font-medium text-stone-700" %>
      <%= form.password_field :current_password, autocomplete: "current-password", class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>
    <div class="space-y-1">
      <%= form.label :password, "새 비밀번호", class: "text-sm font-medium text-stone-700" %>
      <%= form.password_field :password, autocomplete: "new-password", class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>
    <div class="space-y-1">
      <%= form.label :password_confirmation, "새 비밀번호 확인", class: "text-sm font-medium text-stone-700" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>
    <%= form.submit "비밀번호 변경", class: "w-full rounded-md bg-stone-900 px-4 py-2.5 text-sm font-medium text-white" %>
  <% end %>
</div>
