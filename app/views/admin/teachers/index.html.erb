<div class="space-y-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="space-y-1">
      <p><%= link_to "대시보드로 돌아가기", dashboard_path, class: "text-sm font-medium text-stone-600 underline" %></p>
      <h1 class="text-3xl font-semibold">교사 계정 관리</h1>
      <p class="text-sm text-stone-600">실전 운영 전 교사 계정을 미리 생성하고 확인합니다.</p>
    </div>

    <%= link_to "교사 추가",
                new_admin_teacher_path,
                class: "inline-flex justify-center rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  </div>

  <% if @teachers.any? %>
    <ul class="space-y-3">
      <% @teachers.each do |teacher| %>
        <li class="rounded-md border border-stone-200 bg-white p-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="space-y-1">
              <h2 class="text-lg font-semibold"><%= teacher.name.presence || "이름 없음" %></h2>
              <p class="text-sm text-stone-600"><%= teacher.email %></p>
            </div>
            <p class="text-sm text-stone-500">생성일 <%= teacher.created_at.to_date %></p>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="rounded-md border border-stone-200 bg-white p-4 text-stone-600">아직 등록된 교사 계정이 없습니다.</p>
  <% end %>
</div>
