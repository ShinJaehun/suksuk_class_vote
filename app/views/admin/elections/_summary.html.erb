<%= tag.section id: dom_id(election, :admin_summary), class: "space-y-4 rounded-md border border-stone-200 bg-white p-4" do %>
  <% contests = election.election_contests.to_a %>
  <% persisted_sessions = election.election_sessions.to_a.select(&:persisted?) %>
  <% sessions = election.stopped? ? persisted_sessions : persisted_sessions.reject(&:stopped?) %>
  <% closed_session_count = sessions.count(&:closed?) %>
  <% contest_candidate_summaries = contests.map { |contest| "#{contest.title} #{contest.election_candidates.size}명" } %>
  <% status_label = { "draft" => "준비", "in_progress" => "진행", "closed" => "종료", "stopped" => "중단" }.fetch(election.status, election.status) %>
  <% status_class =
    if election.draft?
      "border-amber-200 bg-amber-50 text-amber-700"
    elsif election.in_progress?
      "border-emerald-200 bg-emerald-50 text-emerald-700"
    elsif election.stopped?
      "border-rose-200 bg-rose-50 text-rose-700"
    else
      "border-stone-300 bg-stone-100 text-stone-700"
    end %>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="space-y-2">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-3xl font-semibold"><%= election.title %></h1>
        <%= election_kind_badge(election) %>
        <span class="rounded-md border px-2 py-1 text-sm font-medium <%= status_class %>"><%= status_label %></span>
      </div>
    </div>

    <div class="flex flex-wrap gap-2">
      <% if local_assigns.fetch(:show_settings_link, true) %>
        <%= link_to "선거 설정",
                    edit_admin_election_path(election),
                    class: "inline-flex rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
      <% end %>

      <% if election.closed? %>
        <%= link_to "결과 집계 보기",
                    results_admin_election_path(election),
                    class: "inline-flex rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
      <% end %>

    </div>
  </div>

  <div class="grid gap-3 sm:grid-cols-5">
    <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
      <p class="text-xs font-medium text-stone-500">대상 학교</p>
      <p class="mt-1 text-sm font-semibold text-stone-900"><%= election.school&.name || "미지정" %></p>
    </div>
    <div class="rounded-md border border-stone-200 bg-stone-50 p-3 sm:col-span-2">
      <p class="text-xs font-medium text-stone-500">후보 구성</p>
      <p class="mt-1 text-sm font-semibold text-stone-900">
        <% if contest_candidate_summaries.any? %>
          <%= contest_candidate_summaries.join(" · ") %>
        <% else %>
          등록된 투표 항목 없음
        <% end %>
      </p>
    </div>
    <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
      <p class="text-xs font-medium text-stone-500">학급 세션</p>
      <p class="mt-1 text-2xl font-semibold"><%= sessions.size %></p>
    </div>
    <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
      <p class="text-xs font-medium text-stone-500">완료 세션</p>
      <p class="mt-1 text-2xl font-semibold"><%= closed_session_count %>/<%= sessions.size %></p>
    </div>
  </div>
<% end %>
