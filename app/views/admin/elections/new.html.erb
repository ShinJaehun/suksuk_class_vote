<div class="space-y-6">
  <div class="space-y-1">
    <p><%= link_to "선거 목록으로 돌아가기", admin_elections_path, class: "text-sm font-medium text-stone-600 underline" %></p>
    <h1 class="text-3xl font-semibold">전교임원선거 만들기</h1>
    <p class="text-sm text-stone-600">전교임원선거를 만든 뒤 후보/선거구/학급 세션을 구성합니다.</p>
  </div>

  <% if @election.errors.any? %>
    <section class="rounded-md border border-rose-200 bg-rose-50 p-4 text-rose-800">
      <h2 class="font-semibold">선거를 만들 수 없습니다.</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% @election.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="rounded-md border border-stone-200 bg-white p-4">
    <%= form_with model: [:admin, @election], class: "space-y-4" do |form| %>
      <%= form.hidden_field :kind, value: "school_council" %>

      <div class="space-y-1">
        <%= form.label :title, "선거 이름", class: "text-sm font-medium text-stone-700" %>
        <%= form.text_field :title, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
      </div>

      <div class="flex flex-wrap gap-2">
        <%= form.submit "전교임원선거 만들기", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
        <%= link_to "취소", admin_elections_path, class: "inline-flex rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
      </div>
    <% end %>
  </section>
</div>
