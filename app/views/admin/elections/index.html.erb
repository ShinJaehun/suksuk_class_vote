<h1>선거 관리</h1>

<p><%= link_to "대시보드로 돌아가기", dashboard_path %></p>
<p><%= link_to "선거 만들기", new_admin_election_path %></p>

<% if @elections.any? %>
  <table>
    <thead>
      <tr>
        <th>이름</th>
        <th>종류</th>
        <th>상태</th>
        <th>생성일</th>
      </tr>
    </thead>
    <tbody>
      <% @elections.each do |election| %>
        <tr>
          <td><%= link_to election.title, admin_election_path(election) %></td>
          <td><%= election.kind %></td>
          <td><%= election.status %></td>
          <td><%= l election.created_at.to_date %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>아직 만든 선거가 없습니다.</p>
<% end %>
