<div class="space-y-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="space-y-1">
      <p><%= link_to "대시보드로 돌아가기", dashboard_path, class: "text-sm font-medium text-stone-600 underline" %></p>
      <h1 class="text-3xl font-semibold">선거 관리</h1>
    </div>

    <%= link_to "선거 만들기",
                new_admin_election_path,
                class: "inline-flex rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  </div>

  <% if @elections.any? %>
    <ul class="space-y-3">
      <% @elections.each do |election| %>
        <% contests = election.election_contests.to_a %>
        <% sessions = election.election_sessions.to_a %>
        <% closed_session_count = sessions.count(&:closed?) %>
        <% contest_candidate_summaries = contests.map { |contest| "#{contest.title} #{contest.election_candidates.size}명" } %>
        <% status_label = { "draft" => "준비 중", "in_progress" => "진행 중", "closed" => "종료됨" }.fetch(election.status, election.status) %>
        <% status_class =
          if election.draft?
            "border-amber-200 bg-amber-50 text-amber-700"
          elsif election.in_progress?
            "border-emerald-200 bg-emerald-50 text-emerald-700"
          else
            "border-stone-300 bg-stone-100 text-stone-700"
          end %>
        <% action_label = election.draft? ? "관리/시작 준비" : (election.in_progress? ? "운영 현황/결과 확인" : "결과 보기") %>

        <li class="rounded-md border border-stone-200 bg-white p-4">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div class="space-y-2">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-lg font-semibold"><%= link_to election.title, admin_election_path(election), class: "hover:underline" %></h2>
                <span class="rounded-md border px-2 py-1 text-xs font-medium <%= status_class %>"><%= status_label %></span>
              </div>
              <p class="text-sm text-stone-600">
                <%= election.kind %>
              </p>
            </div>

            <div class="grid grid-cols-2 gap-2 text-sm sm:grid-cols-[minmax(18rem,1fr)_6rem_6rem] lg:min-w-[34rem]">
              <div class="col-span-2 rounded-md border border-stone-200 bg-stone-50 px-3 py-2 sm:col-span-1">
                <p class="text-xs text-stone-500">후보 구성</p>
                <p class="font-semibold">
                  <% if contest_candidate_summaries.any? %>
                    <%= contest_candidate_summaries.join(" · ") %>
                  <% else %>
                    등록된 선거 항목 없음
                  <% end %>
                </p>
              </div>            
              <div class="rounded-md border border-stone-200 bg-stone-50 px-3 py-2 text-center">
                <p class="text-xs text-stone-500">학급</p>
                <p class="font-semibold"><%= sessions.size %>개</p>
              </div>
              <div class="rounded-md border border-stone-200 bg-stone-50 px-3 py-2 text-center">
                <p class="text-xs text-stone-500">완료</p>
                <p class="font-semibold"><%= closed_session_count %>/<%= sessions.size %></p>
              </div>
            </div>

            <%= link_to action_label,
                        election.closed? ? results_admin_election_path(election) : admin_election_path(election),
                        class: "inline-flex justify-center rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="rounded-md border border-stone-200 bg-white p-4 text-stone-600">아직 만든 선거가 없습니다.</p>
  <% end %>
</div>
