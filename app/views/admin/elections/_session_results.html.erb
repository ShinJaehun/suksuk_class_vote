<section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
  <div>
    <h2 class="text-xl font-semibold">학급별 집계</h2>
    <p class="text-sm text-stone-600">종료되어 전체 결과에 반영된 학급별 집계를 확인합니다.</p>
  </div>

  <% if session_result_summaries.any? %>
    <div class="space-y-3">
      <% session_result_summaries.each do |summary| %>
        <% session = summary[:session] %>
        <article class="space-y-3 rounded-md border border-stone-200 bg-stone-50 p-4">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h3 class="font-medium"><%= session.participant_group.name %></h3>
              <p class="text-sm text-stone-600">담당 교사: <%= session.teacher.name.presence || session.teacher.email %></p>
            </div>
            <span class="rounded-md border border-emerald-200 bg-emerald-50 px-2 py-1 text-sm font-medium text-emerald-700">집계 포함</span>
          </div>

          <div class="grid gap-2 text-sm sm:grid-cols-3">
            <div class="rounded-md border border-stone-200 bg-white p-3">전체 투표자 <span class="font-semibold"><%= summary[:participation_counts].values.sum %>명</span></div>
            <div class="rounded-md border border-stone-200 bg-white p-3">투표 완료 <span class="font-semibold"><%= summary[:participation_counts][:completed].to_i + summary[:participation_counts][:abstained].to_i %>명</span></div>
            <div class="rounded-md border border-stone-200 bg-white p-3">미참여 <span class="font-semibold"><%= summary[:participation_counts][:absent] %>명</span></div>
          </div>

          <details class="rounded-md border border-stone-200 bg-white p-3">
            <summary class="cursor-pointer text-sm font-medium text-stone-700">학급 상세 결과 보기</summary>
            <div class="mt-3 grid gap-3 lg:grid-cols-2">
              <% summary[:contest_results].each do |contest_result| %>
                <section class="space-y-3 rounded-md border border-stone-200 bg-stone-50 p-3">
                  <h4 class="font-medium"><%= contest_result[:contest].title %></h4>
                  <div class="grid gap-1 md:grid-cols-2">
                    <% contest_result[:candidate_results].each do |candidate_result| %>
                      <div class="flex items-center gap-2 rounded-md border border-stone-200 bg-white px-3 py-2 text-sm">
                        <span class="w-14 shrink-0 whitespace-nowrap font-medium text-stone-500">기호 <%= candidate_result[:candidate].number %></span>
                        <span class="min-w-0 flex-1 font-medium text-stone-900"><%= candidate_result[:candidate].name %></span>
                        <span class="w-12 shrink-0 text-right font-semibold tabular-nums text-stone-900"><%= candidate_result[:votes_count] %>표</span>
                      </div>
                    <% end %>
                  </div>
                  <div class="border-t border-stone-200 pt-2 text-sm">
                    <p class="font-medium text-stone-700">기권 <%= contest_result[:abstentions_count] %>표</p>
                  </div>
                </section>
              <% end %>
            </div>
          </details>
      </article>
    <% end %>
    </div>
  <% else %>
    <p class="rounded-md border border-dashed border-stone-300 bg-stone-50 p-3 text-sm text-stone-600">집계할 종료 학급 세션이 없습니다.</p>
  <% end %>
</section>
