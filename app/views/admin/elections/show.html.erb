<h1><%= @election.title %></h1>

<p><%= link_to "선거 목록으로 돌아가기", admin_elections_path %></p>

<dl>
  <dt>종류</dt>
  <dd><%= @election.kind %></dd>
  <dt>상태</dt>
  <dd><%= @election.status %></dd>
</dl>

<% if @aggregate_status_counts && @aggregate_results && @session_result_summaries %>
  <%= render "admin/elections/aggregate_results",
             aggregate_status_counts: @aggregate_status_counts,
             aggregate_results: @aggregate_results,
             aggregate_partial: @aggregate_partial %>

  <%= render "admin/elections/session_results",
             session_result_summaries: @session_result_summaries %>
<% end %>

<section>
  <h2>선거 항목</h2>

  <% if @election_contests.any? %>
    <ul>
      <% @election_contests.each do |contest| %>
        <li>
          <%= contest.position %>. <%= contest.title %>
          /
          <%= contest.vote_method %>
          /
          최대 <%= contest.max_selections %>명 선택
          /
          후보 <%= contest.election_candidates.size %>명
          <%= link_to "후보 등록",
                      new_admin_election_election_contest_election_candidate_path(@election, contest) %>

          <% candidates = contest.election_candidates.sort_by(&:number) %>
          <% if candidates.any? %>
            <ul>
              <% candidates.each do |candidate| %>
                <li>
                  기호 <%= candidate.number %>번
                  <%= candidate.name %>
                  <% if candidate.affiliation_label.present? %>
                    (<%= candidate.affiliation_label %>)
                  <% end %>
                  <%= link_to "수정",
                              edit_admin_election_election_contest_election_candidate_path(@election, contest, candidate) %>
                  <%= button_to "삭제",
                                admin_election_election_contest_election_candidate_path(@election, contest, candidate),
                                method: :delete,
                                data: { turbo_confirm: "후보를 삭제할까요?" } %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p>등록된 후보가 없습니다.</p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>아직 선거 항목이 없습니다.</p>
  <% end %>
</section>

<section>
  <h2>학급 세션</h2>

  <% if @election_session.errors.any? %>
    <h3>학급 세션을 배정할 수 없습니다.</h3>
    <ul>
      <% @election_session.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with model: [:admin, @election, @election_session] do |form| %>
    <div>
      <%= form.label :teacher_id, "담당 교사" %>
      <%= form.collection_select :teacher_id,
                                 @teachers,
                                 :id,
                                 ->(teacher) { "#{teacher.name}/#{teacher.email}" },
                                 prompt: "담당 교사를 선택하세요" %>
    </div>

    <div>
      <%= form.label :participant_group_id, "학급/그룹" %>
      <%= form.collection_select :participant_group_id,
                                 @participant_groups,
                                 :id,
                                 ->(group) { "#{group.user.name}/#{group.user.email} - #{group.name}" },
                                 prompt: "학급/그룹을 선택하세요" %>
    </div>

    <%= form.submit "학급 세션 배정" %>
  <% end %>

  <% if @election_sessions.any? %>
    <table>
      <thead>
        <tr>
          <th>학급/그룹</th>
          <th>담당 교사</th>
          <th>상태</th>
          <th>작업</th>
        </tr>
      </thead>
      <tbody>
        <% @election_sessions.each do |session| %>
          <tr>
            <td><%= session.participant_group.name %></td>
            <td><%= session.teacher.name.presence || session.teacher.email %></td>
            <td><%= session.status %></td>
            <td>
              <%= button_to "삭제",
                            admin_election_election_session_path(@election, session),
                            method: :delete,
                            data: { turbo_confirm: "학급 세션을 삭제할까요?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>아직 배정된 학급 세션이 없습니다.</p>
  <% end %>
</section>
