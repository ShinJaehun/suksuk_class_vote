<h1><%= @election.title %></h1>

<p><%= link_to "선거 목록으로 돌아가기", admin_elections_path %></p>

<dl>
  <dt>종류</dt>
  <dd><%= @election.kind %></dd>
  <dt>상태</dt>
  <dd><%= @election.status %></dd>
</dl>

<section class="rounded-md border border-stone-200 bg-white p-4">
  <h2>시작 상태 점검</h2>
  <p>상태 점검: <%= @election_start_report[:startable] ? "시작 가능" : "확인 필요" %></p>
  <p><%= @election_start_report[:startable] ? "선거를 시작할 수 있습니다." : "선거를 시작할 수 없습니다." %></p>

  <dl>
    <dt>학급 세션 수</dt>
    <dd><%= @election_start_report[:session_count] %></dd>
    <dt>선거 항목 수</dt>
    <dd><%= @election_start_report[:contest_count] %></dd>
    <dt>후보자 수</dt>
    <dd><%= @election_start_report[:candidate_count] %></dd>
    <dt>시작 가능 여부</dt>
    <dd><%= @election_start_report[:startable] ? "시작 가능" : "시작 불가" %></dd>
  </dl>

  <% if @election_start_report[:blockers].any? %>
    <ul>
      <% @election_start_report[:blockers].each do |blocker| %>
        <li><%= blocker %></li>
      <% end %>
    </ul>
  <% end %>

  <% if @election.draft? && @election_start_report[:startable] %>
    <%= button_to "선거 시작",
                  start_admin_election_path(@election),
                  method: :post,
                  class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  <% end %>
</section>

<p><%= link_to "결과 집계 보기", results_admin_election_path(@election) %></p>

<section>
  <h2>선거 항목</h2>

  <% if @election_contests.any? %>
    <ul>
      <% @election_contests.each do |contest| %>
        <li>
          <%= contest.position %>. <%= contest.title %>
          /
          <%= contest.vote_method %>
          /
          최대 <%= contest.max_selections %>명 선택
          /
          후보 <%= contest.election_candidates.size %>명
          <%= link_to "후보 등록",
                      new_admin_election_election_contest_election_candidate_path(@election, contest) %>

          <% candidates = contest.election_candidates.sort_by(&:number) %>
          <% if candidates.any? %>
            <ul>
              <% candidates.each do |candidate| %>
                <li>
                  기호 <%= candidate.number %>번
                  <%= candidate.name %>
                  <% if candidate.affiliation_label.present? %>
                    (<%= candidate.affiliation_label %>)
                  <% end %>
                  <%= link_to "수정",
                              edit_admin_election_election_contest_election_candidate_path(@election, contest, candidate) %>
                  <%= button_to "삭제",
                                admin_election_election_contest_election_candidate_path(@election, contest, candidate),
                                method: :delete,
                                data: { turbo_confirm: "후보를 삭제할까요?" } %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p>등록된 후보가 없습니다.</p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>아직 선거 항목이 없습니다.</p>
  <% end %>
</section>

<section>
  <h2>학급 세션</h2>

  <% if @election_session.errors.any? %>
    <h3>학급 세션을 배정할 수 없습니다.</h3>
    <ul>
      <% @election_session.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with model: [:admin, @election, @election_session] do |form| %>
    <div>
      <%= form.label :teacher_id, "담당 교사" %>
      <%= form.collection_select :teacher_id,
                                 @teachers,
                                 :id,
                                 ->(teacher) { "#{teacher.name}/#{teacher.email}" },
                                 prompt: "담당 교사를 선택하세요" %>
    </div>

    <div>
      <%= form.label :participant_group_id, "학급/그룹" %>
      <%= form.collection_select :participant_group_id,
                                 @participant_groups,
                                 :id,
                                 ->(group) { "#{group.user.name}/#{group.user.email} - #{group.name}" },
                                 prompt: "학급/그룹을 선택하세요" %>
    </div>

    <%= form.submit "학급 세션 배정" %>
  <% end %>

  <% if @election_sessions.any? %>
    <table>
      <thead>
        <tr>
          <th>학급/그룹</th>
          <th>담당 교사</th>
          <th>상태</th>
          <th>작업</th>
        </tr>
      </thead>
      <tbody>
        <% session_deletion_allowed = @election.draft? && @election_sessions.none? { |election_session| !election_session.draft? } %>
        <% @election_sessions.each do |session| %>
          <tr>
            <td><%= session.participant_group.name %></td>
            <td><%= session.teacher.name.presence || session.teacher.email %></td>
            <td><%= session.status %></td>
            <td>
              <% if session_deletion_allowed && session.draft? %>
                <%= button_to "삭제",
                              admin_election_election_session_path(@election, session),
                              method: :delete,
                              data: { turbo_confirm: "학급 세션을 삭제할까요?" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>아직 배정된 학급 세션이 없습니다.</p>
  <% end %>
</section>
