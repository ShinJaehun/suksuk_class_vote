<div class="space-y-6">
  <%= turbo_stream_from @election, :admin_overview %>

  <p><%= link_to "선거 목록으로 돌아가기", admin_elections_path, class: "text-sm font-medium text-stone-600 underline" %></p>

  <%= render "admin/elections/summary",
             election: @election,
             show_settings_link: policy(@election).edit? %>

  <%= render "admin/elections/status_report",
             election: @election,
             election_status_report: @election_status_report %>

  <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
  <h2 class="text-xl font-semibold">선거 항목</h2>

  <% if @election_contests.any? %>
    <div class="space-y-4">
      <% @election_contests.each do |contest| %>
        <article class="space-y-3 rounded-md border border-stone-200 bg-stone-50 p-4">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h3 class="text-lg font-medium"><%= contest.position %>. <%= contest.title %></h3>
            </div>
            <% if @election.draft? %>
              <%= link_to "후보 등록",
                          new_admin_election_election_contest_election_candidate_path(@election, contest),
                          class: "inline-flex rounded-md bg-stone-900 px-3 py-2 text-sm font-medium text-white" %>
            <% end %>
          </div>

          <% candidates = contest.election_candidates.sort_by(&:number) %>
          <% if candidates.any? %>
            <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
              <% candidates.each do |candidate| %>
                <li class="flex items-center gap-3 rounded-md border border-stone-200 bg-white p-3">
                  <% if candidate.photo.attached? %>
                    <%= image_tag rails_blob_path(candidate.photo, only_path: true),
                                  alt: "#{candidate.name} 후보 사진",
                                  class: "h-12 w-12 rounded-md object-cover" %>
                  <% end %>
                  <div class="min-w-0 flex-1">
                    <p class="font-medium">기호 <%= candidate.number %>번 <%= candidate.name %></p>
                    <% if candidate.affiliation_label.present? %>
                      <p class="text-sm text-stone-600"><%= candidate.affiliation_label %></p>
                    <% end %>
                    <% if @election.draft? %>
                      <div class="mt-2 flex flex-wrap items-center gap-2">
                        <%= link_to "수정",
                                    edit_admin_election_election_contest_election_candidate_path(@election, contest, candidate),
                                    class: "text-sm font-medium text-stone-700 underline" %>
                        <%= button_to "삭제",
                                      admin_election_election_contest_election_candidate_path(@election, contest, candidate),
                                      method: :delete,
                                      data: { turbo_confirm: "후보를 삭제할까요?" },
                                      class: "text-sm font-medium text-rose-700 underline" %>
                      </div>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="rounded-md border border-dashed border-stone-300 bg-white p-3 text-sm text-stone-600">등록된 후보가 없습니다.</p>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="rounded-md border border-stone-200 bg-stone-50 p-3 text-stone-600">아직 선거 항목이 없습니다.</p>
  <% end %>
  </section>

  <%= render "admin/elections/sessions",
             election: @election,
             election_sessions: @election_sessions,
             election_session: @election_session,
             participant_groups: @participant_groups %>

</div>
