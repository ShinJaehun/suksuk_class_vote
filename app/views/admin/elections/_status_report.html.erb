<%= tag.section id: dom_id(election, :admin_status_report), class: "space-y-4 rounded-md border border-stone-200 bg-white p-4" do %>
  <% report_blockers = election_status_report[:display_blockers] %>
  <% report_blockers = [] if report_blockers.blank? %>
  <% badge_label =
    if election.draft?
      election_status_report[:startable] ? "시작 가능" : "확인 필요"
    elsif election.in_progress?
      { "진행 중" => "진행" }.fetch(election_status_report[:status_label], election_status_report[:status_label])
    elsif election.closed?
      "종료"
    elsif election.stopped?
      "중단"
    else
      election_status_report[:status_label]
    end %>
  <% badge_class =
    if election.draft? && election_status_report[:startable]
      "border-emerald-200 bg-emerald-50 text-emerald-700"
    elsif election.draft?
      "border-amber-200 bg-amber-50 text-amber-700"
    elsif election.in_progress?
      "border-emerald-200 bg-emerald-50 text-emerald-700"
    elsif election.closed?
      "border-stone-300 bg-stone-100 text-stone-700"
    elsif election.stopped?
      "border-rose-200 bg-rose-50 text-rose-700"
    else
      "border-stone-200 bg-stone-50 text-stone-700"
    end %>
  <% guidance =
    if election.draft? && election_status_report[:startable]
      "투표를 시작할 수 있습니다."
    elsif election.draft?
      "선거를 시작하려면 아래 항목을 먼저 보완하세요."
    elsif election.in_progress?
      election_status_report[:message]
    elsif election.closed?
      "투표가 종료되었습니다."
    elsif election.stopped?
      "전교임원선거가 중단되었습니다."
    else
      election_status_report[:message]
    end %>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="space-y-1">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="text-xl font-semibold">상태점검</h2>
        <span class="rounded-md border px-2 py-1 text-sm font-medium <%= badge_class %>"><%= badge_label %></span>
      </div>
      <p class="text-sm text-stone-600"><%= guidance %></p>
      <% if election_status_report[:detail].present? %>
        <p class="text-sm font-medium text-stone-800"><%= election_status_report[:detail] %></p>
      <% end %>
    </div>

    <% if election.draft? && election_status_report[:startable] %>
      <%= button_to "선거 시작",
                    start_admin_election_path(election),
                    method: :post,
                    class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% elsif election.in_progress? && election_status_report[:all_sessions_closed] %>
      <%= button_to "선거 종료",
                    close_admin_election_path(election),
                    method: :post,
                    data: { turbo_confirm: "모든 학급 투표 결과를 확정하고 선거를 종료할까요?" },
                    class: "rounded-md bg-amber-600 px-5 py-3 text-base font-semibold text-white shadow-sm hover:bg-amber-700 focus:outline-none focus:ring-2 focus:ring-amber-500" %>
    <% elsif election.in_progress? %>
      <%= button_to "전교임원선거 중단",
                    stop_admin_election_path(election),
                    method: :post,
                    data: { turbo_confirm: "전교임원선거를 중단할까요? 운영 중인 학급 세션이 함께 중단되며, 이미 종료된 학급 세션 결과는 보존됩니다." },
                    class: "rounded-md bg-rose-600 px-4 py-2 text-sm font-medium text-white hover:bg-rose-700" %>
    <% end %>
  </div>

  <% if report_blockers.any? %>
    <div class="rounded-md border border-amber-200 bg-amber-50 p-4">
      <h3 class="text-sm font-semibold text-amber-900">보완 항목</h3>
      <ul class="mt-2 space-y-1 text-sm text-amber-800">
        <% report_blockers.each do |blocker| %>
          <li class="flex gap-2">
            <span aria-hidden="true">-</span>
            <span><%= blocker %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% elsif election.draft? && election_status_report[:startable] %>
    <div class="rounded-md border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800">
      필요한 후보와 학급 세션 구성이 준비되었습니다.
    </div>
  <% end %>
<% end %>
