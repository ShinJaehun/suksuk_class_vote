<style>
  @media print {
    body * {
      visibility: hidden;
    }

    .admin-election-result-print-area,
    .admin-election-result-print-area * {
      visibility: visible;
    }

    .admin-election-result-print-area {
      background: #fff !important;
      border-color: #000 !important;
      font-size: 12px !important;
      left: 0;
      padding: 10mm !important;
      position: absolute;
      top: 0;
      width: 100%;
    }

    .admin-election-result-print-area header {
      margin-bottom: 8px !important;
    }

    .admin-election-result-print-area dl {
      gap: 6px !important;
      margin-bottom: 10px !important;
    }

    .admin-election-result-print-area dl > div {
      padding: 6px !important;
    }

    .admin-election-result-contests {
      display: grid !important;
      gap: 8px !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }

    .admin-election-result-contest {
      padding: 8px !important;
    }

    .admin-election-result-candidates {
      column-gap: 8px !important;
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      row-gap: 3px !important;
    }

    .admin-election-result-candidate {
      align-items: center !important;
      column-gap: 4px !important;
      display: grid !important;
      font-size: 10px !important;
      grid-template-columns: 2.4rem max-content max-content !important;
      justify-content: start !important;
      line-height: 1.15 !important;
      padding: 3px 4px !important;
    }

    .admin-election-result-candidate span,
    .admin-election-result-candidate strong {
      white-space: nowrap !important;
    }

    .admin-election-result-candidate strong {
      text-align: right !important;
    }

    .admin-election-result-print-button {
      display: none !important;
    }
  }
</style>

<div class="space-y-3">
  <div class="flex justify-end">
    <button type="button"
            onclick="window.print()"
            class="admin-election-result-print-button inline-flex rounded-md border border-stone-300 px-3 py-2 text-sm font-medium text-stone-700">
      결과 인쇄
    </button>
  </div>

  <section class="admin-election-result-print-area space-y-5 rounded-md border border-stone-200 bg-white p-4">
    <header class="space-y-2">
      <h1 class="text-2xl font-semibold text-stone-900"><%= election.title %> 투표 결과</h1>
      <p class="text-lg font-semibold text-stone-700"><%= printable_aggregate_summary[:vote_date] %> 시행</p>
    </header>

    <dl class="grid gap-2 text-sm sm:grid-cols-3">
      <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
        <dt class="text-stone-500">전체 투표자</dt>
        <dd class="mt-1 font-semibold text-stone-900"><%= printable_aggregate_summary[:total_voter_count] %>명</dd>
      </div>
      <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
        <dt class="text-stone-500">투표 완료</dt>
        <dd class="mt-1 font-semibold text-stone-900"><%= printable_aggregate_summary[:completed_count] %>명</dd>
      </div>
      <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
        <dt class="text-stone-500">미참여</dt>
        <dd class="mt-1 font-semibold text-stone-900"><%= printable_aggregate_summary[:not_participated_count] %>명</dd>
      </div>
    </dl>

    <div class="admin-election-result-contests grid gap-3 lg:grid-cols-2">
      <% aggregate_results.each do |contest_result| %>
        <article class="admin-election-result-contest space-y-3 rounded-md border border-stone-200 bg-stone-50 p-3">
          <div class="space-y-1">
            <h2 class="text-lg font-semibold text-stone-900"><%= contest_result[:contest].title %></h2>
          </div>

          <div class="admin-election-result-candidates grid gap-1 md:grid-cols-2">
            <% contest_result[:candidate_results].each do |candidate_result| %>
              <% candidate = candidate_result[:candidate] %>
              <div class="admin-election-result-candidate flex items-center gap-2 rounded-md border border-stone-200 bg-white px-3 py-2 text-sm">
                <span class="w-14 shrink-0 whitespace-nowrap font-medium text-stone-500">기호 <%= candidate.number %></span>
                <span class="min-w-0 flex-1 font-medium text-stone-900"><%= candidate.name %></span>
                <strong class="w-12 shrink-0 text-right font-semibold tabular-nums text-stone-900"><%= candidate_result[:votes_count].to_i %>표</strong>
              </div>
            <% end %>
          </div>

          <div class="border-t border-stone-200 pt-2 text-sm">
            <p class="font-medium text-stone-700">기권 <%= contest_result[:abstentions_count].to_i %>표</p>
          </div>
        </article>
      <% end %>
    </div>
  </section>
</div>
