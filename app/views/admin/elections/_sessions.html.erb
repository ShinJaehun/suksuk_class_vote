<% current_sessions = election.stopped? ? election_sessions : election_sessions.reject(&:stopped?) %>
<% stopped_history_sessions = election.stopped? ? [] : election_sessions.select(&:stopped?) %>
<%= tag.section id: dom_id(election, :admin_sessions), class: "space-y-4 rounded-md border border-stone-200 bg-white p-4" do %>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-xl font-semibold">학급 세션</h2>
    </div>
  </div>

   
  <% if election_session&.errors&.any? %>
    <div class="rounded-md border border-rose-200 bg-rose-50 p-4">
      <p class="font-medium text-rose-800">학급 세션을 배정할 수 없습니다.</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-rose-700">
        <% election_session.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>


  <% if election.draft? %>
    <% if election_session.errors.any? %>
      <div class="rounded-md border border-rose-200 bg-rose-50 p-3 text-rose-800">
      <h3 class="font-medium">학급 세션을 배정할 수 없습니다.</h3>
      <ul class="mt-2 list-disc pl-5 text-sm">
        <% election_session.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
      </div>
    <% end %>

    <% if participant_groups.any? %>
      <%= form_with url: bulk_create_admin_election_election_sessions_path(election),
                    method: :post,
                    data: { controller: "election-session-picker" },
                    class: "grid gap-4 lg:grid-cols-[minmax(0,1fr)_18rem]" do %>
        <section class="space-y-4">
          <h3 class="font-semibold">배정 가능 학급</h3>
          <% participant_groups.group_by(&:grade).sort_by { |grade, _classrooms| grade.to_i }.each do |grade, grade_classrooms| %>
            <section class="space-y-2 rounded-md border border-stone-200 bg-stone-50 p-3">
              <label class="flex items-center gap-2 font-medium">
                <%= check_box_tag "grade_#{grade}",
                                  "1",
                                  false,
                                  data: {
                                    election_session_picker_target: "gradeCheckbox",
                                    action: "election-session-picker#toggleGrade",
                                    grade: grade
                                  },
                                  class: "h-4 w-4 rounded border-stone-300" %>
                <span><%= grade %>학년 전체</span>
              </label>
              <div class="space-y-2">
                <% grade_classrooms.each do |classroom| %>
                  <% teacher = classroom.teacher %>
                  <% voter_count = classroom.students.count(&:active?) %>
                  <label class="flex gap-3 rounded-md border border-indigo-100 bg-indigo-50/30 p-3">
                    <%= check_box_tag "classroom_ids[]",
                                      classroom.id,
                                      false,
                                      data: {
                                        election_session_picker_target: "classCheckbox",
                                        action: "election-session-picker#toggleClass",
                                        grade: grade
                                      },
                                      class: "mt-1 h-4 w-4 rounded border-stone-300" %>
                    <span class="space-y-1">
                      <span class="block font-medium"><%= classroom.school_year %>학년도 <%= classroom.grade %>학년 <%= classroom.formatted_class_label %></span>
                      <span class="block text-sm text-stone-600">
                        담당 교사 <%= teacher.name.presence || teacher.email %>
                        · 투표자 <%= voter_count %>명
                      </span>
                    </span>
                  </label>
                <% end %>
              </div>
            </section>
          <% end %>
        </section>

        <aside class="space-y-3 rounded-md border border-stone-200 bg-stone-50 p-4 lg:sticky lg:top-4 lg:self-start">
          <% assigned_voter_count = current_sessions.sum do |session|
            if session.draft?
              session.classroom ? session.classroom.students.count(&:active?) : session.participant_group.participant_slots.size
            else
              session.election_voters.size
            end
          end %>
          <h3 class="font-semibold">배정 현황</h3>
          <dl class="grid grid-cols-2 gap-3 text-sm">
            <div>
              <dt class="text-stone-500">배정 학급</dt>
              <dd class="mt-1 text-2xl font-semibold"><%= current_sessions.size %></dd>
            </div>
            <div>
              <dt class="text-stone-500">배정 투표 인원</dt>
              <dd class="mt-1 text-2xl font-semibold"><%= assigned_voter_count %></dd>
            </div>
          </dl>
          <%= submit_tag "선택한 학급 세션 배정", class: "w-full rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
        </aside>
      <% end %>
    <% else %>
      <p class="rounded-md border border-dashed border-stone-300 bg-stone-50 p-3 text-sm text-stone-600">배정 가능한 학급이 없습니다.</p>
    <% end %>
  <% else %>
    <p class="rounded-md border border-stone-200 bg-stone-50 p-3 text-sm text-stone-600">선거 시작 후에는 구성을 변경할 수 없습니다.</p>
  <% end %>

  <% if current_sessions.any? %>
    <% session_deletion_allowed = election.draft? && current_sessions.all?(&:draft?) %>
    <div class="space-y-2">
      <h3 class="font-semibold">이미 배정된 학급 세션</h3>
      <% current_sessions.group_by { |session| (session.classroom || session.participant_group).grade }.sort_by { |grade, _sessions| grade.to_i }.each do |grade, grade_sessions| %>
        <section class="space-y-2 rounded-md border border-stone-200 p-3">
          <div class="flex items-center justify-between gap-3">
            <h4 class="font-medium"><%= grade %>학년</h4>
            <% if session_deletion_allowed %>
              <%= button_to "#{grade}학년 등록해제",
                            destroy_grade_admin_election_election_sessions_path(election, grade: grade),
                            method: :delete,
                            data: { turbo_confirm: "#{grade}학년 학급 세션 #{grade_sessions.size}개를 등록 해제할까요?" },
                            class: "text-sm font-medium text-rose-700 underline" %>
            <% end %>
          </div>
          <% grade_sessions.each do |session| %>
            <% source = session.classroom || session.participant_group %>
            <% source_name = session.classroom ? "#{source.school_year}학년도 #{source.grade}학년 #{source.formatted_class_label}" : source.display_name %>
            <% voter_count = if session.draft?
              session.classroom ? source.students.count(&:active?) : source.participant_slots.size
            else
              session.election_voters.size
            end %>
            <% display_status = { "draft" => "준비", "in_progress" => "진행", "closed" => "종료", "stopped" => "중단" }.fetch(session.status, session.status) %>
            <% status_class =
              if session.draft?
                "border-amber-200 bg-amber-50 text-amber-700"
              elsif session.in_progress?
                "border-emerald-200 bg-emerald-50 text-emerald-700"
              elsif session.closed?
                "border-stone-300 bg-stone-100 text-stone-700"
              else
                "border-rose-200 bg-rose-50 text-rose-700"
              end %>
            <div class="flex flex-col gap-3 rounded-md border border-stone-200 bg-stone-50 p-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-medium"><%= source_name %></h3>
              <span class="rounded-md border px-2 py-1 text-xs font-medium <%= status_class %>"><%= display_status %></span>
            </div>
            <p class="text-sm text-stone-600">
              담당 교사 : <%= session.teacher.name.presence || session.teacher.email %>
              · 투표자 <%= voter_count %>명
              <% session_time_labels = election_session_status_time_labels(session) %>
              <% if session_time_labels.any? %>
                / <%= session_time_labels.join(" · ") %>
              <% end %>
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <%= link_to "상세",
                        elections_session_path(session),
                        class: "text-sm font-medium text-stone-700 underline" %>
            <% if session_deletion_allowed && session.draft? %>
              <%= button_to "배정 해제",
                            admin_election_election_session_path(election, session),
                            method: :delete,
                            class: "text-sm font-medium text-rose-700 underline" %>
            <% end %>
          </div>
            </div>
          <% end %>
        </section>
      <% end %>
    </div>
  <% elsif stopped_history_sessions.empty? %>
    <p class="rounded-md border border-dashed border-stone-300 bg-stone-50 p-3 text-sm text-stone-600">아직 배정된 학급 세션이 없습니다.</p>
  <% end %>

  <% if stopped_history_sessions.any? %>
    <div class="space-y-2">
      <h3 class="font-semibold">중단된 학급 세션 이력</h3>
      <% stopped_history_sessions.each do |session| %>
        <% source = session.classroom || session.participant_group %>
        <% source_name = session.classroom ? "#{source.school_year}학년도 #{source.grade}학년 #{source.formatted_class_label}" : source.display_name %>
        <% voter_count = session.election_voters.size %>
        <div class="flex flex-col gap-3 rounded-md border border-rose-100 bg-rose-50/40 p-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-medium"><%= source_name %></h3>
              <span class="rounded-md border border-rose-200 bg-rose-50 px-2 py-1 text-xs font-medium text-rose-700">중단</span>
            </div>
            <p class="text-sm text-stone-600">
              담당 교사 : <%= session.teacher.name.presence || session.teacher.email %>
              · 투표자 <%= voter_count %>명
              <% session_time_labels = election_session_status_time_labels(session) %>
              <% if session_time_labels.any? %>
                / <%= session_time_labels.join(" · ") %>
              <% end %>
            </p>
          </div>

          <%= link_to "상세",
                      elections_session_path(session),
                      class: "text-sm font-medium text-stone-700 underline" %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
