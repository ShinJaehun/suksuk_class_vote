<div class="space-y-6">
  <% status_label = { "draft" => "준비", "in_progress" => "진행", "closed" => "종료", "stopped" => "중단" }.fetch(@election.status, @election.status) %>
  <% status_class =
    if @election.draft?
      "border-amber-200 bg-amber-50 text-amber-700"
    elsif @election.in_progress?
      "border-emerald-200 bg-emerald-50 text-emerald-700"
    elsif @election.stopped?
      "border-rose-200 bg-rose-50 text-rose-700"
    else
      "border-stone-300 bg-stone-100 text-stone-700"
    end %>

  <div class="space-y-2">
    <p><%= link_to "선거 상세로 돌아가기", admin_election_path(@election), class: "text-sm font-medium text-stone-600 underline" %></p>
    <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-3xl font-semibold"><%= @election.title %> 결과 집계</h1>
          <%= election_kind_badge(@election) %>
          <span class="rounded-md border px-2 py-1 text-sm font-medium <%= status_class %>"><%= status_label %></span>
        </div>
      </div>
    </div>
  </div>

  <%= render "admin/elections/aggregate_results",
             aggregate_status_counts: @aggregate_status_counts,
             aggregate_results: @aggregate_results,
             aggregate_partial: @aggregate_partial %>

  <%= render "admin/elections/printable_aggregate_result_card",
             election: @election,
             aggregate_results: @aggregate_results,
             printable_aggregate_summary: @printable_aggregate_summary %>

  <%= render "admin/elections/session_results",
             session_result_summaries: @session_result_summaries %>
</div>
