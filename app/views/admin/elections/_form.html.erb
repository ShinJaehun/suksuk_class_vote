<% editable = election.new_record? || election.draft? %>

<% if election.errors.any? %>
  <section class="rounded-md border border-rose-200 bg-rose-50 p-4 text-rose-800">
    <h2 class="font-semibold"><%= error_heading %></h2>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
      <% election.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </section>
<% end %>

<section class="rounded-md border border-stone-200 bg-white p-4">
  <%= form_with model: [:admin, election], class: "space-y-4" do |form| %>
    <% if election.new_record? %>
      <%= form.hidden_field :kind, value: "school_council" %>
    <% end %>

    <div class="space-y-1">
      <%= form.label :title, "선거 이름", class: "text-sm font-medium text-stone-700" %>
      <%= form.text_field :title,
                          readonly: !editable,
                          class: "w-full rounded-md border border-stone-300 px-3 py-2 disabled:bg-stone-100 read-only:bg-stone-100" %>
    </div>

    <div class="space-y-1">
      <%= form.label :school_id, "대상 학교", class: "text-sm font-medium text-stone-700" %>
      <%= form.collection_select :school_id,
                                 schools,
                                 :id,
                                 :name,
                                 { prompt: "학교를 선택하세요" },
                                 disabled: !editable,
                                 class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
      <% if schools.blank? %>
        <p class="text-sm text-rose-700">등록된 학교가 없습니다.</p>
      <% end %>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= form.submit submit_label,
                      disabled: schools.blank? || !editable,
                      class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white disabled:cursor-not-allowed disabled:bg-stone-300" %>
      <%= link_to "취소", cancel_path, class: "inline-flex rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
    </div>
  <% end %>
</section>
