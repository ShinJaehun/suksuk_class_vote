<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-semibold">학급투표 운영 현황</h1>
    <p class="mt-1 text-sm text-stone-600">전체 학교의 일반 학급투표 운영 기록을 읽기 전용으로 확인합니다.</p>
  </div>

  <%= form_with url: admin_classroom_poll_sessions_path,
                method: :get,
                class: "grid items-end gap-3 rounded-md border border-stone-200 bg-white p-4 sm:grid-cols-2 lg:grid-cols-4",
                data: { controller: "autosubmit", turbo_action: "advance" } do |form| %>
    <div>
      <%= form.label :school_id, "학교", class: "block text-sm font-medium" %>
      <%= form.select :school_id,
                      options_for_select([["전체", "all"]] + @schools.map { |school| [school.name, school.id] }, @school&.id || "all"),
                      {},
                      class: "mt-1 w-full rounded-md border-stone-300",
                      data: { action: "change->autosubmit#submit" } %>
    </div>
    <div>
      <%= form.label :grade, "학년", class: "block text-sm font-medium" %>
      <%= form.select :grade,
                      options_for_select([["전체", "all"]] + (1..6).map { |grade| ["#{grade}학년", grade] }, @grade),
                      {},
                      class: "mt-1 w-full rounded-md border-stone-300",
                      data: { action: "change->autosubmit#submit" } %>
    </div>
    <div>
      <%= form.label :status, "상태", class: "block text-sm font-medium" %>
      <%= form.select :status,
                      options_for_select(
                        [["전체", "all"]] + %w[draft in_progress stopped closed].map { |value| [Poll::DISPLAY_STATUSES.fetch(value), value] },
                        @status
                      ),
                      {},
                      class: "mt-1 w-full rounded-md border-stone-300",
                      data: { action: "change->autosubmit#submit" } %>
    </div>
    <div>
      <%= form.label :poll_title, "투표 이름", class: "block text-sm font-medium" %>
      <div class="mt-1 flex gap-2">
        <%= form.text_field :poll_title,
                            value: @poll_title,
                            class: "min-w-0 flex-1 rounded-md border-stone-300" %>
        <%= form.submit "검색", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
      </div>
    </div>
  <% end %>

  <div class="overflow-x-auto rounded-md border border-stone-200 bg-white">
    <table class="min-w-full divide-y divide-stone-200 text-sm">
      <thead class="bg-stone-50 text-left text-stone-600">
        <tr>
          <th class="px-4 py-3 font-medium">상태</th>
          <th class="px-4 py-3 font-medium">학교 / 학급</th>
          <th class="px-4 py-3 font-medium">운영 선생님</th>
          <th class="px-4 py-3 font-medium">투표</th>
          <th class="px-4 py-3 font-medium">생성 시각</th>
          <th class="px-4 py-3 font-medium"><span class="sr-only">상세</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        <% @poll_sessions.each do |poll_session| %>
          <tr data-poll-session-id="<%= poll_session.id %>">
            <td class="whitespace-nowrap px-4 py-3">
              <%= poll_session_status_badge(poll_session) %>
              <% if classroom_poll_monitor_archived?(poll_session) %>
                <span class="ml-1 rounded-md border border-stone-300 bg-stone-100 px-2 py-1 text-xs font-medium">보관됨</span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <p class="font-medium"><%= poll_session.classroom.school.name %></p>
              <p class="text-stone-600"><%= poll_session_classroom_label(poll_session) %></p>
            </td>
            <td class="px-4 py-3"><%= classroom_poll_monitor_operator_name(poll_session) %></td>
            <td class="px-4 py-3">
              <p class="font-medium"><%= poll_session.poll.title %></p>
              <p class="text-stone-600"><%= poll_session.poll.activity_label %></p>
            </td>
            <td class="whitespace-nowrap px-4 py-3"><%= kst_datetime(poll_session.poll.created_at) %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to "상세", admin_classroom_poll_session_path(poll_session), class: "font-medium text-stone-700 underline" %>
            </td>
          </tr>
        <% end %>
        <% if @poll_sessions.empty? %>
          <tr>
            <td colspan="6" class="px-4 py-10 text-center text-stone-500">조건에 맞는 학급투표가 없습니다.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
