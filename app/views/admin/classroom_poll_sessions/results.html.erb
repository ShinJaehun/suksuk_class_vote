<div class="space-y-6">
  <%= link_to "학급투표 상세로 돌아가기",
              admin_classroom_poll_session_path(@poll_session),
              class: "inline-block text-sm font-medium text-stone-700 underline" %>

  <section class="space-y-3 rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
    <h1 class="text-2xl font-semibold"><%= @poll_session.poll.title %> 익명 결과</h1>
    <p class="text-sm text-stone-600">
      <%= @poll_session.classroom.school.name %> · <%= poll_session_classroom_label(@poll_session) %>
    </p>
    <p class="text-sm text-stone-700"><%= classroom_poll_monitor_counts(@poll_session, @participation_counts) %></p>
  </section>

  <section class="space-y-5" data-testid="admin-classroom-poll-results">
    <% @contest_results.each do |result| %>
      <article class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold"><%= result[:contest].title %></h2>
        <div class="mt-4 space-y-2">
          <% result[:options].each do |option_result| %>
            <div class="flex justify-between gap-4 rounded-md border border-stone-200 bg-stone-50 p-3">
              <span><%= option_result[:option].number %>번 <%= option_result[:option].name %></span>
              <span class="font-semibold"><%= option_result[:votes_count].nil? ? "-" : "#{option_result[:votes_count]}표" %></span>
            </div>
          <% end %>
          <% if result[:contest].referendum? %>
            <div class="flex justify-between gap-4 rounded-md border border-stone-200 bg-stone-50 p-3">
              <span>반대</span>
              <span class="font-semibold"><%= result[:tally] ? "#{result[:tally].rejections_count}표" : "-" %></span>
            </div>
          <% end %>
          <div class="flex justify-between gap-4 rounded-md border border-stone-200 bg-stone-50 p-3">
            <span>기권</span>
            <span class="font-semibold"><%= result[:tally] ? "#{result[:tally].abstentions_count}표" : "-" %></span>
          </div>
        </div>
      </article>
    <% end %>
  </section>
</div>
