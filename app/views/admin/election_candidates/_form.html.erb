<%= form_with model: [:admin, @election, @election_contest, @election_candidate], multipart: true do |form| %>
  <div>
    <%= form.label :number, "기호" %>
    <%= form.number_field :number %>
  </div>

  <div>
    <%= form.label :name, "후보 이름" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :affiliation_label, "소속" %>
    <%= form.text_field :affiliation_label %>
  </div>

  <div>
    <%= form.label :photo, "후보자 사진" %>
    <% if @election_candidate.photo.attached? %>
      <div>
        <%= image_tag rails_blob_path(@election_candidate.photo, only_path: true),
                      alt: "#{@election_candidate.name} 후보 사진",
                      style: "width: 120px; height: 120px; object-fit: cover;" %>
      </div>
      <div>
        <%= check_box_tag "election_candidate[remove_photo]", "1", false, id: "election_candidate_remove_photo" %>
        <%= label_tag "election_candidate_remove_photo", "현재 사진 삭제" %>
      </div>
    <% end %>
    <%= form.file_field :photo, accept: "image/png,image/jpeg,image/webp" %>
    <p>JPG, PNG, WebP 파일을 업로드할 수 있습니다. 최대 5MB</p>
  </div>

  <%= form.submit submit_label %>
<% end %>
