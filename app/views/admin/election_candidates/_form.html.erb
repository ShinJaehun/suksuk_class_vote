<%= form_with model: [:admin, @election, @election_contest, @election_candidate],
              multipart: true,
              class: "space-y-5 rounded-md border border-stone-200 bg-white p-5" do |form| %>
  <% if @election_candidate.errors.any? %>
    <div class="rounded-md border border-rose-200 bg-rose-50 p-4 text-rose-800">
      <h2 class="font-semibold"><%= error_title %></h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% @election_candidate.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="space-y-1">
      <%= form.label :number, "기호", class: "block text-sm font-medium text-stone-700" %>
      <%= form.number_field :number, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>

    <div class="space-y-1">
      <%= form.label :affiliation_label, "소속/학반", class: "block text-sm font-medium text-stone-700" %>
      <%= form.text_field :affiliation_label, class: "w-full rounded-md border border-stone-300 px-3 py-2", placeholder: "예: 6학년 1반" %>
    </div>
  </div>

  <div class="space-y-1">
    <%= form.label :name, "이름", class: "block text-sm font-medium text-stone-700" %>
    <%= form.text_field :name, class: "w-full rounded-md border border-stone-300 px-3 py-2", placeholder: "후보 이름" %>
  </div>

  <% persisted_photo = @election_candidate.persisted? &&
                       @election_candidate.photo.attached? &&
                       @election_candidate.photo.blob&.persisted? %>
  <div class="space-y-3 rounded-md border border-stone-200 bg-stone-50 p-4"
       data-controller="candidate-photo-preview">
    <div>
      <%= form.label :photo, "후보 사진", class: "block text-sm font-medium text-stone-700" %>
      <p class="mt-1 text-sm text-stone-600">JPG, PNG, WebP 파일을 업로드할 수 있습니다. 최대 15MB</p>
      <p class="mt-1 text-xs text-stone-500">저장 실패 시 사진 파일은 다시 선택해야 할 수 있습니다.</p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center"
         data-candidate-photo-preview-target="preview"
         <%= "hidden" unless persisted_photo %>>
      <% if persisted_photo %>
        <%= image_tag election_candidate_photo_source(@election_candidate, variant: :thumbnail),
                      alt: "#{@election_candidate.name.presence || '후보'} 후보 사진",
                      class: "h-28 w-28 rounded-md object-cover",
                      data: { candidate_photo_preview_target: "previewImage" } %>
      <% else %>
        <%= tag.img alt: "",
                    class: "h-28 w-28 rounded-md object-cover",
                    data: { candidate_photo_preview_target: "previewImage" } %>
      <% end %>
      <div class="space-y-2">
        <p class="text-sm font-medium text-stone-700" data-candidate-photo-preview-target="previewLabel">
          <%= persisted_photo ? "현재 사진" : "새로 선택한 사진" %>
        </p>
        <% if persisted_photo %>
          <div class="flex items-center gap-2">
            <%= check_box_tag "election_candidate[remove_photo]",
                              "1",
                              false,
                              id: "election_candidate_remove_photo",
                              class: "rounded border-stone-300",
                              data: {
                                candidate_photo_preview_target: "removeCheckbox",
                                action: "candidate-photo-preview#toggleRemove"
                              } %>
            <%= label_tag "election_candidate_remove_photo", "현재 사진 삭제", class: "text-sm text-stone-700" %>
          </div>
        <% end %>
        <p class="text-xs text-stone-500" data-candidate-photo-preview-target="removeMessage" hidden>저장하면 현재 사진이 삭제됩니다.</p>
      </div>
    </div>

    <%= form.file_field :photo,
                        accept: "image/png,image/jpeg,image/webp",
                        class: "block w-full text-sm text-stone-700",
                        data: {
                          candidate_photo_preview_target: "input",
                          action: "candidate-photo-preview#preview"
                        } %>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <%= link_to "취소", admin_election_path(@election), class: "text-sm font-medium text-stone-700 underline" %>
    <%= form.submit submit_label, class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  </div>
<% end %>
