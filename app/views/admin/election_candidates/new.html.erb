<div class="mx-auto max-w-3xl space-y-6">
  <div class="space-y-2">
    <p><%= link_to "선거 상세로 돌아가기", admin_election_path(@election), class: "text-sm font-medium text-stone-600 underline" %></p>
    <div class="space-y-1">
      <h1 class="text-3xl font-semibold">후보 등록</h1>
      <p class="text-sm text-stone-600"><%= @election.title %> / <%= @election_contest.title %></p>
    </div>
  </div>

  <%= render "form", submit_label: "후보 등록", error_title: "후보를 등록할 수 없습니다." %>
</div>
