<div class="space-y-6">
  <h1 class="text-2xl font-semibold">전교임원선거 학급 학년 단위 추가</h1>

  <% if @bulk_errors.present? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-4 text-red-800">
      <h2 class="font-medium">학년 단위로 학급을 추가할 수 없습니다.</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% @bulk_errors.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-md border border-indigo-100 bg-indigo-50/30 p-4">
    <p class="text-sm font-medium text-stone-700">학교</p>
    <p class="mt-1 rounded-md border border-stone-200 bg-white px-3 py-2 text-stone-900"><%= @school.name %></p>
  </div>

  <% if @step == "assign" && @class_rows.present? %>
    <%= form_with url: bulk_create_admin_election_rosters_path, class: "space-y-4 rounded-md border border-indigo-100 bg-indigo-50/30 p-4", data: { controller: "bulk-class-roster" } do |form| %>
      <%= hidden_field_tag :school_id, @school.id %>
      <%= hidden_field_tag :grade, @grade %>

      <div class="space-y-1">
        <p class="text-sm font-medium text-stone-700">학년</p>
        <p class="rounded-md border border-stone-200 bg-white px-3 py-2 text-stone-900"><%= @grade.to_i %>학년</p>
      </div>

      <div class="space-y-3">
        <% @class_rows.each_with_index do |class_row, index| %>
          <div class="space-y-3 rounded-md border border-stone-200 bg-white p-3" data-bulk-class-roster-target="card">
            <p class="text-sm font-semibold text-stone-900">
              <% if class_row["class_label"].present? %>
                <% label = class_row["class_label"].to_s.match?(/\A\d+\z/) ? "#{class_row["class_label"]}반" : class_row["class_label"] %>
                <%= @grade.to_i %>학년 <%= label %>
              <% else %>
                학급
              <% end %>
            </p>

            <div class="grid gap-3 sm:grid-cols-[8rem_1fr]">
              <div class="space-y-1">
                <%= label_tag "class_rows_#{index}_class_label", "반", class: "text-sm font-medium text-stone-700" %>
                <%= text_field_tag "class_rows[#{index}][class_label]",
                                   class_row["class_label"],
                                   id: "class_rows_#{index}_class_label",
                                   class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
              </div>

              <div class="space-y-1">
                <%= label_tag "class_rows_#{index}_teacher_id", "담당 교사", class: "sr-only" %>
                <%= select_tag "class_rows[#{index}][teacher_id]",
                               options_from_collection_for_select(@teachers, :id, ->(teacher) { "#{teacher.name}/#{teacher.email}" }, class_row["teacher_id"]),
                               id: "class_rows_#{index}_teacher_id",
                               prompt: "담당 교사를 선택하세요",
                               class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
              </div>
            </div>

            <button type="button"
                    class="text-sm font-medium text-rose-700 underline"
                    data-action="bulk-class-roster#removeCard">
              삭제
            </button>
          </div>
        <% end %>
      </div>

      <%= form.submit "학년 단위 추가", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  <% else %>
    <%= form_with url: new_bulk_admin_election_rosters_path, method: :get, class: "space-y-4 rounded-md border border-indigo-100 bg-indigo-50/30 p-4" do |form| %>
      <%= hidden_field_tag :school_id, @school.id %>
      <%= hidden_field_tag :step, "assign" %>

      <div class="space-y-1">
        <%= form.label :grade, "학년", class: "text-sm font-medium text-stone-700" %>
        <%= form.number_field :grade, value: @grade, min: 1, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
      </div>

      <div class="space-y-1">
        <%= form.label :class_count, "학급 수", class: "text-sm font-medium text-stone-700" %>
        <%= form.number_field :class_count, value: @class_count, min: 1, max: 30, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
      </div>

      <%= form.submit "다음", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  <% end %>

  <p><%= link_to "전교임원선거 투표자 목록으로 돌아가기", admin_election_rosters_path(school_id: @school.id), class: "text-sm font-medium text-stone-700 underline" %></p>
</div>
