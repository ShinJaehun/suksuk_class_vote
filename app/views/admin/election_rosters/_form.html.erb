<% if participant_group.errors.any? %>
  <div class="rounded-md border border-red-200 bg-red-50 p-4 text-red-800">
    <h2 class="font-medium">전교임원선거 학급 명단을 저장할 수 없습니다.</h2>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
      <% participant_group.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: participant_group, url: participant_group.persisted? ? admin_election_roster_path(participant_group) : admin_election_rosters_path, class: "space-y-4 rounded-md border border-indigo-100 bg-indigo-50/30 p-4" do |form| %>
  <div class="space-y-1">
    <p class="text-sm font-medium text-stone-700">학교</p>
    <p class="rounded-md border border-stone-200 bg-white px-3 py-2 text-stone-900"><%= school.name %></p>
    <%= form.hidden_field :school_id, value: school.id %>
  </div>

  <div class="space-y-1">
    <%= form.label :user_id, "담당 교사", class: "text-sm font-medium text-stone-700" %>
    <%= form.collection_select :user_id,
                               teachers,
                               :id,
                               ->(teacher) { "#{teacher.name}/#{teacher.email}" },
                               { prompt: "담당 교사를 선택하세요" },
                               class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="space-y-1">
      <%= form.label :grade, "학년", class: "text-sm font-medium text-stone-700" %>
      <%= form.number_field :grade, min: 1, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>

    <div class="space-y-1">
      <%= form.label :class_number, "반", class: "text-sm font-medium text-stone-700" %>
      <%= form.number_field :class_number, min: 1, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>
  </div>

  <div class="space-y-1">
    <%= form.label :name, "학급 이름", class: "text-sm font-medium text-stone-700" %>
    <%= form.text_field :name, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>

  <%= form.submit "저장", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
<% end %>
