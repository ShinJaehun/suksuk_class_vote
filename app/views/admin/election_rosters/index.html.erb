<div class="space-y-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <h1 class="text-2xl font-semibold">전교임원선거 투표자 목록</h1>

    <div class="flex flex-wrap items-center gap-2">
      <%= link_to "학교 추가",
                  new_admin_school_path,
                  class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
      <% if @school.present? %>
        <%= link_to "학급 추가",
                    new_admin_election_roster_path(school_id: @school.id),
                    class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
        <%= link_to "학년 단위 추가",
                    new_bulk_admin_election_rosters_path(school_id: @school.id),
                    class: "rounded-md border border-indigo-200 bg-indigo-50 px-4 py-2 text-sm font-medium text-indigo-700" %>
      <% end %>
    </div>
  </div>

  <% if @schools.any? %>
    <%= form_with url: admin_election_rosters_path, method: :get, class: "rounded-md border border-stone-200 bg-white p-4" do |form| %>
      <div class="space-y-1">
        <%= form.label :school_id, "학교 선택", class: "text-sm font-medium text-stone-700" %>
        <%= form.select :school_id,
                        @schools.map { |school| [school.name, school.id] },
                        { selected: @school&.id },
                        class: "w-full rounded-md border border-stone-300 px-3 py-2",
                        onchange: "this.form.requestSubmit()" %>
      </div>
    <% end %>
  <% else %>
    <p class="rounded-md border border-dashed border-stone-300 bg-stone-50 p-3 text-sm text-stone-600">등록된 학교가 없습니다.</p>
  <% end %>

  <% if @school.present? && @participant_groups.any? %>
    <div class="space-y-4">
      <% @participant_groups.group_by(&:grade).sort_by { |grade, _groups| grade.to_i }.each do |grade, grade_groups| %>
        <section class="space-y-2 rounded-md border border-stone-200 bg-white p-4">
          <h2 class="text-xl font-semibold"><%= grade %>학년</h2>

          <div class="space-y-2">
            <% grade_groups.each do |participant_group| %>
              <div class="flex flex-col gap-3 rounded-md border border-indigo-100 bg-indigo-50/30 p-4 sm:flex-row sm:items-center sm:justify-between">
                <div class="space-y-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="font-medium"><%= participant_group.school_election_short_label %></h3>
                    <% assigned_elections = @assigned_elections_by_participant_group_id.fetch(participant_group.id, []) %>
                    <% if assigned_elections.any? %>
                      <% assigned_elections.each do |election| %>
                        <%= election_kind_badge(election) %>
                      <% end %>
                    <% else %>
                      <span class="rounded-md border border-indigo-200 bg-indigo-50 px-2 py-1 text-sm font-medium text-indigo-700">전교임원선거</span>
                    <% end %>
                    <% if @assigned_participant_group_ids.include?(participant_group.id) %>
                      <span class="rounded-md border border-stone-200 bg-stone-100 px-2 py-1 text-xs font-medium text-stone-600">선거 배정됨</span>
                    <% end %>
                  </div>
                  <p class="text-sm text-stone-600">
                    <%= participant_group.school&.name || @school.name %> · 담당 교사 : <%= participant_group.school_election_short_label %>
                    · 투표자 <%= participant_group.participant_slots.size %>명
                  </p>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                  <%= link_to "상세",
                              participant_group_path(
                                participant_group,
                                return_to: admin_election_rosters_path(school_id: @school.id)
                              ),
                              class: "text-sm font-medium text-stone-700 underline" %>
                  <%= link_to "정보 수정",
                              edit_admin_election_roster_path(participant_group),
                              class: "text-sm font-medium text-stone-700 underline" %>
                  <% unless participant_group.used_by_draft_poll? || @assigned_participant_group_ids.include?(participant_group.id) %>
                    <%= button_to "삭제",
                                  admin_election_roster_path(participant_group),
                                  method: :delete,
                                  data: { turbo_confirm: "학급 명단을 삭제할까요?" },
                                  class: "text-sm font-medium text-rose-700 underline" %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% elsif @school.present? %>
    <p class="rounded-md border border-dashed border-stone-300 bg-stone-50 p-3 text-sm text-stone-600">선택한 학교에 등록된 학급 명단이 없습니다.</p>
  <% end %>
</div>
