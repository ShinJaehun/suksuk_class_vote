<h1><%= @school_election.title %></h1>

<p><%= link_to "전교학생회 선거 목록으로 돌아가기", admin_school_elections_path %></p>

<dl>
  <dt>상태</dt>
  <dd><%= @school_election.status %></dd>
</dl>

<section>
  <h2>선거 항목</h2>

  <% if @school_election_contests.any? %>
    <ul>
      <% @school_election_contests.each do |contest| %>
        <li>
          <%= contest.position %>. <%= contest.title %>
          - 후보 <%= contest.school_election_candidates.size %>명
          <%= link_to "후보 추가",
                      new_admin_school_election_school_election_contest_school_election_candidate_path(@school_election, contest) %>

          <% candidates = contest.school_election_candidates.sort_by(&:number) %>
          <% if candidates.any? %>
            <ul>
              <% candidates.each do |candidate| %>
                <li>
                  기호 <%= candidate.number %>번
                  <%= candidate.name %>
                  (<%= candidate.grade_class_label %>)
                  <%= link_to "수정",
                              edit_admin_school_election_school_election_contest_school_election_candidate_path(@school_election, contest, candidate) %>
                  <%= button_to "삭제",
                                admin_school_election_school_election_contest_school_election_candidate_path(@school_election, contest, candidate),
                                method: :delete,
                                data: { turbo_confirm: "후보를 삭제할까요?" } %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p>아직 등록된 후보가 없습니다.</p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>아직 선거 항목이 없습니다.</p>
  <% end %>
</section>

<section>
  <h2>학급별 결과 확인</h2>

  <p>먼저 각 학급 결과와 무결성 상태를 확인하세요. 전체 집계는 이후 관리자 개표 화면에서 합산합니다.</p>

  <% if @school_election_classroom_sessions.any? %>
    <table>
      <thead>
        <tr>
          <th>학급</th>
          <th>담당 교사</th>
          <th>Poll 상태</th>
          <th>무결성 상태</th>
          <th>학급별 결과</th>
        </tr>
      </thead>
      <tbody>
        <% @school_election_classroom_sessions.each do |classroom_session| %>
          <% poll = classroom_session.poll %>
          <% poll_status_label =
               if poll.blank?
                 "Poll 미생성"
               elsif poll.draft?
                 "준비 중"
               elsif poll.in_progress?
                 "진행 중"
               elsif poll.closed?
                 "마감됨"
               elsif poll.stopped?
                 "중단됨"
               else
                 poll.display_status
               end %>
          <% integrity_label =
               if poll.blank?
                 "Poll 미생성"
               elsif poll.closed?
                 @integrity_reports_by_poll_id.fetch(poll.id).ok? ? "무결성 OK" : "확인 필요"
               else
                 "마감 후 확인"
               end %>

          <tr>
            <td><%= classroom_session.participant_group.name %></td>
            <td><%= classroom_session.teacher.name.presence || classroom_session.teacher.email %></td>
            <td><%= poll_status_label %></td>
            <td><%= integrity_label %></td>
            <td>
              <% if poll.blank? %>
                Poll 미생성
              <% elsif poll.closed? %>
                <%= link_to "학급 결과 보기", poll_path(poll) %>
              <% else %>
                마감 후 확인
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>아직 확인할 학급 결과가 없습니다.</p>
  <% end %>
</section>

<section>
  <h2>전체 집계</h2>

  <p>모든 학급 결과가 마감되고 무결성 OK일 때 전체 집계를 확인할 수 있습니다.</p>

  <% if @school_election_result_summary.ready_for_final_count? %>
    <p>전체 집계 준비 완료</p>
    <p>모든 학급 결과가 마감되고 무결성 확인을 통과했습니다.</p>
    <p>이 집계는 각 학급 결과를 합산한 확인용 결과입니다. 최종 확정 절차는 이후 단계에서 진행합니다.</p>

    <% @school_election_result_summary.contest_results.each do |contest_result| %>
      <section>
        <h3><%= contest_result.school_election_contest.title %></h3>

        <% if contest_result.top_candidate_results.any? %>
          <p>
            최다 득표 후보:
            <%= contest_result.top_candidate_results.map { |result| "기호 #{result.school_election_candidate.number}번 #{result.school_election_candidate.name}" }.join(", ") %>
          </p>
        <% else %>
          <p>최다 득표 후보 없음</p>
        <% end %>

        <table>
          <thead>
            <tr>
              <th>후보 번호</th>
              <th>후보 이름</th>
              <th>전체 득표 수</th>
            </tr>
          </thead>
          <tbody>
            <% contest_result.candidate_results.each do |candidate_result| %>
              <tr>
                <td>기호 <%= candidate_result.school_election_candidate.number %>번</td>
                <td><%= candidate_result.school_election_candidate.name %></td>
                <td><%= candidate_result.votes_count %>표</td>
              </tr>
            <% end %>
            <tr>
              <td>-</td>
              <td>기권</td>
              <td><%= contest_result.abstentions_count %>표</td>
            </tr>
          </tbody>
        </table>
      </section>
    <% end %>
  <% else %>
    <p>전체 집계 준비 전</p>
    <p>아직 확인이 필요한 학급이 있습니다.</p>

    <% if @school_election_result_summary.missing_poll_sessions.any? %>
      <h3>Poll 미생성</h3>
      <ul>
        <% @school_election_result_summary.missing_poll_sessions.each do |classroom_session| %>
          <li>
            <%= classroom_session.participant_group.name %>
            /
            <%= classroom_session.teacher.name.presence || classroom_session.teacher.email %>
            /
            Poll 미생성
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if @school_election_result_summary.not_closed_sessions.any? %>
      <h3>마감 전</h3>
      <ul>
        <% @school_election_result_summary.not_closed_sessions.each do |classroom_session| %>
          <li>
            <%= classroom_session.participant_group.name %>
            /
            <%= classroom_session.teacher.name.presence || classroom_session.teacher.email %>
            /
            마감 전
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if @school_election_result_summary.integrity_issue_sessions.any? %>
      <h3>무결성 확인 필요</h3>
      <ul>
        <% @school_election_result_summary.integrity_issue_sessions.each do |classroom_session| %>
          <li>
            <%= classroom_session.participant_group.name %>
            /
            <%= classroom_session.teacher.name.presence || classroom_session.teacher.email %>
            /
            무결성 확인 필요
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</section>

<section>
  <h2>학급 세션</h2>

  <p><%= link_to "학급 세션 추가", new_admin_school_election_school_election_classroom_session_path(@school_election) %></p>

  <% if @school_election_classroom_sessions.any? %>
    <ul>
      <% @school_election_classroom_sessions.each do |classroom_session| %>
        <li>
          담임:
          <%= classroom_session.teacher.name.presence || classroom_session.teacher.email %>
          /
          명단:
          <%= classroom_session.participant_group.name %>
          /
          <% if classroom_session.poll.present? %>
            투표 세션: <%= classroom_session.poll.title %>
          <% else %>
            투표 세션 미생성
            <%= button_to "투표 세션 생성",
                          create_poll_admin_school_election_school_election_classroom_session_path(@school_election, classroom_session),
                          method: :post %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>아직 배정된 학급 세션이 없습니다.</p>
  <% end %>
</section>
