<h1>전교학생회 선거 만들기</h1>

<% if @school_election.errors.any? %>
  <h2>전교학생회 선거를 만들 수 없습니다.</h2>
  <ul>
    <% @school_election.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: [:admin, @school_election] do |form| %>
  <div>
    <%= form.label :title, "선거 이름" %>
    <%= form.text_field :title %>
  </div>

  <%= form.submit "전교학생회 선거 만들기" %>
<% end %>

<p><%= link_to "전교학생회 선거 목록으로 돌아가기", admin_school_elections_path %></p>
