<section class="space-y-4 rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
  <h2 class="text-xl font-semibold">재투표 이력</h2>
  <div class="space-y-3">
    <% history_sessions.each do |session| %>
      <div class="flex items-center justify-between gap-3 rounded-md border border-stone-200 p-4">
        <div>
          <span class="font-medium"><%= session.classroom_name_snapshot %></span>
          <%= poll_session_status_badge(session) %>
          <p class="mt-1 text-sm text-stone-600">담당 교사 <%= session.operator_name_snapshot %> · 투표자 <%= session.poll_participants.size %>명</p>
          <% session_time_labels = poll_session_status_time_labels(session) %>
          <% if session_time_labels.any? %>
            <p class="mt-1 text-sm text-stone-600"><%= session_time_labels.join(" · ") %></p>
          <% end %>
        </div>
        <%= link_to "상세", poll_poll_session_path(poll, session), class: "text-sm font-medium underline" %>
      </div>
    <% end %>
  </div>
</section>
