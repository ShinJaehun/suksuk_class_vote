<section class="school-poll-result-print-area space-y-5 rounded-md border border-stone-200 bg-white p-4" data-testid="school-poll-printable-results">
  <header class="space-y-2">
    <h2 class="text-2xl font-semibold text-stone-900"><%= @poll.title %> 투표 결과</h2>
    <p class="text-sm font-semibold text-stone-700"><%= [@poll.school.name, "#{school_poll_grade_label(@included_grades)} 대상", (@result_date ? "#{@result_date.month}월 #{@result_date.day}일 시행" : nil)].compact.join(" ") %></p>
  </header>

  <dl class="grid gap-2 text-sm sm:grid-cols-3">
    <% { "투표 대상자" => "#{@school_result_summary.total_count}명", "투표 완료" => "#{@school_result_summary.completed_count}명", "미참여" => "#{@school_result_summary.absent_count}명" }.each do |label, value| %>
      <div class="rounded-md border border-stone-200 bg-stone-50 p-3"><dt class="text-stone-500"><%= label %></dt><dd class="mt-1 font-semibold text-stone-900"><%= value %></dd></div>
    <% end %>
  </dl>

  <div class="school-poll-result-print-contests grid gap-3 lg:grid-cols-2">
    <% @school_result_summary.contest_results.each do |contest_result| %>
      <article class="rounded-md border border-stone-200 p-3">
        <h3 class="font-semibold"><%= contest_result.poll_contest.title %></h3>
        <p class="mt-1 text-sm font-medium">최다 득표: <%= contest_result.winners.any? ? contest_result.winners.map { |result| "#{@poll.choice_number_label} #{result.poll_option.number}번 #{result.poll_option.name}" }.join(", ") : "없음" %></p>
        <div class="school-poll-result-print-options mt-3 grid gap-2 sm:grid-cols-2">
          <% contest_result.option_results.each do |option_result| %>
            <div class="grid grid-cols-[max-content_minmax(0,1fr)_max-content] gap-2 rounded-md bg-stone-50 px-2 py-1 text-sm">
              <span><%= @poll.choice_number_label %> <%= option_result.poll_option.number %>번</span><span class="break-words"><%= option_result.poll_option.name %></span><strong><%= option_result.votes_count %>표</strong>
            </div>
          <% end %>
        </div>
        <p class="mt-2 text-sm">기권 <%= contest_result.abstentions_count %>표</p>
      </article>
    <% end %>
  </div>
</section>
