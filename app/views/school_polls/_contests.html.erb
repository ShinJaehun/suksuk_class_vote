<%= tag.section id: dom_id(poll, :contests),
                class: "rounded-xl border border-stone-200 bg-white p-6 shadow-sm" do %>
  <div class="flex items-center justify-between gap-4">
    <h2 class="text-xl font-semibold">투표 항목 관리</h2>
    <% if poll.definition_editable? %>
      <%= link_to "투표 항목 추가", new_school_poll_contest_path(poll),
                  data: { turbo_frame: "school_poll_modal" },
                  class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  </div>
  <% unless poll.definition_editable? %>
    <p class="mt-3 text-sm text-stone-600">
      <% if poll.test_run? %>
        테스트투표의 투표 정의는 생성 후 변경할 수 없습니다.
      <% else %>
        투표가 진행되어 투표 정의를 변경할 수 없습니다.
      <% end %>
    </p>
  <% end %>

  <% if poll_contests.any? %>
    <div class="mt-4 space-y-4">
      <% poll_contests.each do |contest| %>
        <%= render "school_polls/contest", poll: poll, contest: contest %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-3 text-stone-600">등록된 투표 항목이 없습니다.</p>
  <% end %>
<% end %>
