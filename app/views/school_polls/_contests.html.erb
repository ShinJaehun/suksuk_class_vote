<section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-semibold"><%= poll.contest_label %> 관리</h2>
      <p class="mt-1 text-sm text-stone-600">
        <%= poll.contest_label %>과 <%= poll.choice_label %>를 관리합니다.
      </p>
    </div>
    <% if poll.definition_editable? %>
      <%= link_to "#{poll.contest_label} 추가", new_school_poll_contest_path(poll),
                  class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  </div>
  <% unless poll.definition_editable? %>
    <p class="mt-3 text-sm text-stone-600">
      <% if poll.test_run? %>
        테스트투표의 투표 정의는 생성 후 변경할 수 없습니다.
      <% else %>
        투표가 진행되어 투표 정의를 변경할 수 없습니다.
      <% end %>
    </p>
  <% end %>

  <% if poll_contests.any? %>
    <div class="mt-4 space-y-4">
      <% poll_contests.each do |contest| %>
        <article class="rounded-md border border-stone-200 p-4">
          <div class="flex items-start justify-between gap-4">
            <h3 class="font-semibold"><%= contest.position %>. <%= contest.title %></h3>
            <% if poll.definition_editable? %>
              <div class="flex gap-3 text-sm">
                <%= link_to "수정", edit_school_poll_contest_path(poll, contest) %>
                <%= button_to "삭제", school_poll_contest_path(poll, contest), method: :delete,
                              form: { data: { turbo_confirm: "이 #{poll.contest_label}을 삭제하시겠습니까?" } },
                              class: "text-rose-700" %>
              </div>
            <% end %>
          </div>
          <% if contest.poll_options.any? %>
            <ul class="mt-3 grid gap-3 sm:grid-cols-2">
              <% contest.poll_options.sort_by { |option| [option.number, option.id] }.each do |option| %>
                <li class="flex items-center justify-between gap-3 rounded-md bg-stone-50 p-3">
                  <span class="flex items-center gap-3">
                    <% if poll.election? %>
                      <%= image_tag poll_option_photo_source(option, variant: :thumbnail),
                                    alt: option.photo.attached? ? "#{option.name} 후보 사진" : "",
                                    class: "h-12 w-12 rounded-md object-contain" %>
                    <% end %>
                    <span><%= poll.choice_number_label %> <%= option.number %>번 <%= option.name %></span>
                  </span>
                  <% if poll.definition_editable? %>
                    <span class="flex gap-2 text-sm">
                      <%= link_to "수정", edit_school_poll_contest_option_path(poll, contest, option) %>
                      <%= button_to "삭제", school_poll_contest_option_path(poll, contest, option), method: :delete,
                                    form: { data: { turbo_confirm: "이 #{poll.choice_label}를 삭제하시겠습니까?" } },
                                    class: "text-rose-700" %>
                    </span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="mt-3 text-sm text-stone-600">등록된 <%= poll.choice_label %>가 없습니다.</p>
          <% end %>
          <% if poll.definition_editable? %>
            <%= link_to "#{poll.choice_label} 추가", new_school_poll_contest_option_path(poll, contest),
                        class: "mt-3 inline-block text-sm font-medium underline" %>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="mt-3 text-stone-600">등록된 투표 항목이 없습니다.</p>
  <% end %>
</section>
