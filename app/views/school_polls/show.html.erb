<% contest_label = @poll.election? ? "선거 항목" : "투표 항목" %>
<% option_label = @poll.election? ? "후보자" : "선택지" %>

<section class="mx-auto mb-6 max-w-5xl rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
  <div class="flex items-center justify-between gap-4">
    <h2 class="text-xl font-semibold"><%= contest_label %> 관리</h2>
    <% if @poll.definition_editable? %>
      <%= link_to "#{contest_label} 추가",
                  new_school_poll_contest_path(@poll),
                  class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  </div>

  <% unless @poll.definition_editable? %>
    <p class="mt-3 text-sm text-stone-600">투표가 진행되어 투표 정의를 변경할 수 없습니다.</p>
  <% end %>

  <% if @poll_contests.any? %>
    <div class="mt-4 space-y-4">
      <% @poll_contests.each do |contest| %>
        <article class="rounded-md border border-stone-200 p-4">
          <div class="flex items-start justify-between gap-4">
            <h3 class="font-semibold"><%= contest.title %></h3>
            <% if @poll.definition_editable? %>
              <div class="flex gap-3 text-sm">
                <%= link_to "수정", edit_school_poll_contest_path(@poll, contest) %>
                <%= button_to "삭제",
                              school_poll_contest_path(@poll, contest),
                              method: :delete,
                              class: "text-red-700",
                              form: { data: { turbo_confirm: "이 #{contest_label}을 삭제하시겠습니까?" } } %>
              </div>
            <% end %>
          </div>

          <% if contest.poll_options.any? %>
            <ul class="mt-3 space-y-2">
              <% contest.poll_options.sort_by { |option| [option.number, option.id] }.each do |option| %>
                <li class="flex items-center justify-between gap-4 text-sm">
                  <span>기호 <%= option.number %>번 <%= option.name %></span>
                  <% if @poll.definition_editable? %>
                    <span class="flex gap-3">
                      <%= link_to "수정", edit_school_poll_contest_option_path(@poll, contest, option) %>
                      <%= button_to "삭제",
                                    school_poll_contest_option_path(@poll, contest, option),
                                    method: :delete,
                                    class: "text-red-700",
                                    form: { data: { turbo_confirm: "이 #{option_label}를 삭제하시겠습니까?" } } %>
                    </span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="mt-3 text-sm text-stone-600">등록된 <%= option_label %>가 없습니다.</p>
          <% end %>

          <% if @poll.definition_editable? %>
            <%= link_to "#{option_label} 추가",
                        new_school_poll_contest_option_path(@poll, contest),
                        class: "mt-3 inline-block text-sm font-medium underline" %>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="mt-3 text-stone-600">등록된 투표 항목이 없습니다.</p>
  <% end %>
</section>

<section class="mx-auto mb-6 max-w-5xl rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
  <h2 class="text-xl font-semibold">학급 배정</h2>

  <% if @assignable_classrooms.any? %>
    <%= form_with url: school_poll_poll_sessions_path(@poll), class: "mt-4 space-y-4" do %>
      <div class="space-y-2">
        <% @assignable_classrooms.each do |classroom| %>
          <label class="flex items-center gap-3 rounded-md border border-stone-200 p-3">
            <%= check_box_tag "classroom_ids[]", classroom.id, false, class: "rounded border-stone-300" %>
            <span>
              <span class="font-medium">
                <%= classroom.school_year %>학년도
                <%= classroom.grade %>학년
                <%= classroom.formatted_class_label %>
              </span>
              <span class="text-sm text-stone-600">
                · 담임 <%= classroom.teacher.name %>
                · 학생 <%= @assignable_classroom_student_counts.fetch(classroom.id, 0) %>명
              </span>
            </span>
          </label>
        <% end %>
      </div>

      <%= submit_tag "선택한 학급 배정",
                     class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  <% else %>
    <p class="mt-3 text-stone-600">추가로 배정할 수 있는 학급이 없습니다.</p>
  <% end %>
</section>

<%= render "polls/school_overview",
           poll: @poll,
           poll_contests: @poll_contests,
           poll_sessions: @poll_sessions,
           back_path: school_polls_path,
           back_label: "학교투표 목록으로 돌아가기" %>
