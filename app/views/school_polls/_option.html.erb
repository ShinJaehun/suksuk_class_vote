<%= turbo_frame_tag dom_id(option),
                    class: "flex items-center justify-between gap-3 rounded-md bg-stone-50 p-3" do %>
  <span class="flex items-center gap-3">
    <% if poll.school_managed? && poll.election? %>
      <%= image_tag poll_option_photo_source(option, variant: :thumbnail),
                    alt: option.photo.attached? ? "#{option.name} 후보 사진" : "",
                    class: "h-12 w-12 rounded-md object-contain" %>
    <% end %>
    <span><%= poll.choice_number_label %> <%= option.number %>번 <%= option.name %></span>
  </span>
  <% if poll.definition_editable? %>
    <span class="flex gap-2 text-sm">
      <%= link_to "수정", edit_school_poll_contest_option_path(poll, contest, option),
                  data: { turbo_frame: "school_poll_modal" } %>
      <%= button_to "삭제", school_poll_contest_option_path(poll, contest, option), method: :delete,
                    class: "text-rose-700" %>
    </span>
  <% end %>
<% end %>
