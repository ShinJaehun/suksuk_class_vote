<div class="mx-auto max-w-5xl space-y-6">
  <%= link_to "전교투표 상세로 돌아가기", school_poll_path(@poll), class: "text-sm font-medium text-stone-700 underline" %>
  <div class="flex flex-wrap items-center gap-2">
    <h1 class="text-3xl font-semibold"><%= @poll.title %> 결과 집계</h1>
    <%= poll_activity_badge(@poll) %><%= poll_status_badge(@poll) %>
  </div>

  <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold">전체 진행 현황</h2>
    <p class="mt-2 text-sm text-stone-600">종료된 학급만 전체 집계에 반영합니다.</p>
    <dl class="mt-4 grid gap-3 sm:grid-cols-2">
      <div class="rounded-md bg-stone-50 p-3"><dt class="text-sm text-stone-500">전체 반영 학급</dt><dd class="mt-1 text-2xl font-semibold"><%= @school_result_summary.closed_session_count %>개</dd></div>
      <div class="rounded-md bg-stone-50 p-3"><dt class="text-sm text-stone-500">완료 학급</dt><dd class="mt-1 text-2xl font-semibold"><%= @school_result_summary.closed_session_count %>/<%= @current_session_count %></dd></div>
    </dl>
  </section>

  <section class="space-y-4">
    <h2 class="text-xl font-semibold">전체 집계</h2>
    <% @school_result_summary.contest_results.each do |contest_result| %>
      <% total = contest_result.option_results.sum(&:votes_count) + contest_result.abstentions_count %>
      <% highest = contest_result.option_results.map(&:votes_count).max.to_i %>
      <% winners = highest.positive? ? contest_result.option_results.select { |result| result.votes_count == highest } : [] %>
      <article class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div><h3 class="text-lg font-semibold"><%= contest_result.poll_contest.title %></h3>
            <p class="mt-1 text-sm text-stone-600"><%= @poll.winner_label %>: <%= winners.any? ? winners.map { |result| "#{result.poll_option.number}번 #{result.poll_option.name}" }.join(", ") : "없음" %></p></div>
          <span class="rounded-md bg-stone-100 px-2 py-1 text-sm font-medium">전체 집계 <%= total %>표</span>
        </div>
        <div class="mt-4 space-y-3">
          <% contest_result.option_results.each do |option_result| %>
            <% percentage = poll_result_percentage(option_result.votes_count, total) %>
            <div class="rounded-md bg-stone-50 p-3">
              <div class="flex items-center gap-3">
                <% if @poll.election? %><%= image_tag poll_option_photo_source(option_result.poll_option, variant: :thumbnail), alt: "", class: "h-12 w-12 rounded-md object-contain" %><% end %>
                <div class="flex-1"><div class="flex justify-between gap-3">
                  <span class="font-medium"><%= option_result.poll_option.number %>번 <%= option_result.poll_option.name %></span>
                  <span class="font-semibold"><%= option_result.votes_count %>표</span>
                </div>
                  <div class="mt-2 h-2 overflow-hidden rounded-full bg-stone-200"><div class="h-full rounded-full bg-emerald-500" style="width: <%= percentage %>%"></div></div>
                  <p class="mt-1 text-xs text-stone-500"><%= percentage %>%</p></div>
              </div>
            </div>
          <% end %>
          <% abstention_percentage = poll_result_percentage(contest_result.abstentions_count, total) %>
          <div class="rounded-md bg-stone-50 p-3">
            <div class="flex justify-between">
              <span class="font-medium">기권:</span>
              <span class="font-semibold"><%= contest_result.abstentions_count %>표</span>              
            </div>
            <div class="mt-2 h-2 overflow-hidden rounded-full bg-stone-200"><div class="h-full rounded-full bg-stone-500" style="width: <%= abstention_percentage %>%"></div></div><p class="mt-1 text-xs text-stone-500"><%= abstention_percentage %>%</p></div>
        </div>
      </article>
    <% end %>
  </section>

  <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold">학급별 집계</h2>
    <div class="mt-4 space-y-3">
      <% @included_sessions.each do |session| %>
        <article class="rounded-md bg-stone-50 p-3"><div class="flex flex-wrap items-center justify-between gap-2"><h3 class="font-semibold"><%= session.classroom_name_snapshot %></h3><%= poll_session_status_badge(session) %></div>
          <p class="mt-1 text-sm text-stone-600">참여 <%= session.poll_participants.count { |participant| participant.poll_participation.present? } %>/<%= session.poll_participants.size %>명</p>
          <% @poll.poll_contests.order(:position, :id).each do |contest| %>
            <% tallies = session.poll_option_tallies.select { |tally| tally.poll_option.poll_contest_id == contest.id }.sort_by { |tally| tally.poll_option.number } %>
            <p class="mt-2 text-sm"><span class="font-medium"><%= contest.title %></span>: <%= tallies.map { |tally| "#{tally.poll_option.number}번 #{tally.votes_count}표" }.join(" · ") %>
              <% abstentions = session.poll_contest_tallies.find { |tally| tally.poll_contest_id == contest.id } %> · 기권 <%= abstentions&.abstentions_count.to_i %>표</p>
          <% end %>
        </article>
      <% end %>
    </div>
  </section>
</div>
