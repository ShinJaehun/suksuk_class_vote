<div class="space-y-6">
  <div class="flex items-center justify-between gap-4">
    <h1 class="text-2xl font-semibold">전교투표</h1>
    <% if policy(Poll).school_create? %>
      <%= link_to "새 전교투표",
                  new_school_poll_path,
                  class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  </div>

  <% if @polls.any? %>
    <ul class="space-y-3">
      <% @polls.each do |poll| %>
        <% session_counts = poll.poll_sessions.group_by(&:status).transform_values(&:size) %>
        <li class="rounded-md border border-stone-200 bg-white p-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="font-semibold"><%= poll.title %></h2>
                <%= poll_badges(poll: poll, status_record: poll) %>
              </div>
              <p class="text-sm text-stone-600">
                <%= poll.school.name %>
                · 담당 교사: <%= poll.user.name.presence || poll.user.email %>
                · 학급별 투표 <%= poll.poll_sessions.size %>개
              </p>
              <p class="text-sm text-stone-600">
                실행 전 <%= session_counts.fetch("draft", 0) %>
                · 진행 중 <%= session_counts.fetch("in_progress", 0) %>
                · 종료 <%= session_counts.fetch("closed", 0) %>
                · 중단 <%= session_counts.fetch("stopped", 0) %>
              </p>
              <% poll_time_labels = poll_status_time_labels(poll) %>
              <% if poll_time_labels.any? %>
                <p class="text-sm text-stone-600"><%= poll_time_labels.join(" · ") %></p>
              <% end %>
            </div>
            <%= link_to "상세 관리",
                        school_poll_path(poll),
                        class: "text-sm font-medium text-stone-700 underline" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="rounded-md border border-stone-200 bg-white p-5 text-stone-600">
      등록된 전교투표가 없습니다.
    </p>
  <% end %>
</div>
