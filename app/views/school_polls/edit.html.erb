<div class="mx-auto max-w-3xl space-y-6">
  <%= link_to "전교투표 상세로 돌아가기", school_poll_path(@poll),
              class: "text-sm font-medium text-stone-700 underline" %>
  <div class="flex flex-wrap items-center gap-2">
    <h1 class="text-3xl font-semibold">투표 설정</h1>
    <%= poll_badges(poll: @poll, status_record: @poll) %>
  </div>

  <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
    <% if @poll.errors.any? %>
      <div class="mb-4 rounded-md border border-rose-200 bg-rose-50 p-4 text-rose-800">
        <p class="font-medium">전교투표 정보를 수정할 수 없습니다.</p>
        <ul class="mt-2 list-disc pl-5 text-sm">
          <% @poll.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <% unless @poll.draft? %>
      <p class="mb-4 rounded-md bg-stone-50 p-3 text-sm text-stone-600">선거 시작 후에는 정보를 수정할 수 없습니다.</p>
    <% end %>
    <%= form_with model: @poll, url: school_poll_path(@poll), class: "space-y-4" do |form| %>
      <div><%= form.label :title, "투표 이름", class: "text-sm font-medium" %>
        <%= form.text_field :title, disabled: !@poll.draft?, class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %></div>
      <div><%= form.label :school_id, "대상 학교", class: "text-sm font-medium" %>
        <% school_change_allowed = current_user.admin? && @poll.draft? && @poll.poll_sessions.none? %>
        <%= form.collection_select :school_id, @available_schools, :id, :name, {},
                                   disabled: !school_change_allowed,
                                   class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2" %>
        <% if @poll.poll_sessions.exists? %>
          <p class="mt-1 text-sm text-stone-600">학급 Session이 배정되어 대상 학교를 변경할 수 없습니다.</p>
        <% end %>
      </div>
      <div class="flex gap-3">
        <%= form.submit "저장", disabled: !@poll.draft?, class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white disabled:cursor-not-allowed disabled:bg-stone-300" %>
        <%= link_to "취소", school_poll_path(@poll), class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-medium" %>
      </div>
    <% end %>
  </section>

  <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold">관리 편의</h2>
    <p class="mt-2 text-sm text-stone-600">테스트용 선거 항목 4개와 후보 50명을 사진 없이 생성합니다.</p>
    <% mock_available = policy(@poll).mock_candidates? && @poll.election? && @poll.draft? && @poll.definition_editable? && !@has_poll_definition %>
    <% if mock_available %>
      <%= button_to "테스트 후보 50명 만들기", mock_candidates_school_poll_path(@poll), method: :post,
                    data: { turbo_confirm: "테스트용 선거 항목 4개와 후보 50명을 만들까요?" },
                    class: "mt-4 rounded-md bg-amber-700 px-4 py-2 text-sm font-semibold text-white" %>
    <% else %>
      <button type="button" disabled class="mt-4 cursor-not-allowed rounded-md bg-stone-100 px-4 py-2 text-sm font-medium text-stone-400">테스트 후보 50명 만들기</button>
      <p class="mt-2 text-sm text-stone-600">global admin이 비어 있는 초안 전교 선거에서만 사용할 수 있습니다.</p>
    <% end %>
  </section>

  <% if policy(@poll).reset_schoolwide? %>
    <section class="rounded-xl border border-rose-300 bg-rose-50 p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-rose-900">전교투표 초기화</h2>
      <p class="mt-2 text-sm text-rose-800">
        모든 실행 기록, 결과, 재투표 이력을 삭제합니다. Poll 정의, 후보, 사진, 대상 학급은 보존됩니다.
      </p>
      <%= form_with url: reset_school_poll_path(@poll), method: :post,
                    data: { turbo_frame: "_top" }, class: "mt-4 space-y-3" do |form| %>
        <div>
          <%= form.label :confirmation_title, "확인을 위해 전교투표 이름을 입력하세요.",
                         class: "block text-sm font-medium text-rose-900" %>
          <%= form.text_field :confirmation_title, autocomplete: "off",
                              class: "mt-1 block w-full rounded-md border-rose-300" %>
        </div>
        <%= form.submit "전교투표 전체 초기화",
                        class: "rounded-md bg-rose-700 px-4 py-2 text-sm font-semibold text-white" %>
      <% end %>
    </section>
  <% end %>

  <% if policy(@poll).destroy_schoolwide? %>
    <section class="rounded-xl border border-rose-300 bg-rose-50 p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-rose-900">전교투표 삭제</h2>
      <p class="mt-2 text-sm text-rose-800">
        이 전교투표의 학급 Session, 재투표 이력, 실행 기록, 결과와 모든 테스트투표를 함께 영구 삭제합니다.
      </p>
      <% if policy(@poll).force_schoolwide_destroy_confirmation? %>
        <%= form_with url: school_poll_path(@poll), method: :delete,
                      data: { turbo_frame: "_top" }, class: "mt-4 space-y-3" do |form| %>
          <div>
            <%= form.label :confirmation_title, "확인을 위해 전교투표 이름을 입력하세요.",
                           class: "block text-sm font-medium text-rose-900" %>
            <%= form.text_field :confirmation_title, autocomplete: "off",
                                class: "mt-1 block w-full rounded-md border-rose-300" %>
          </div>
          <%= form.submit "영구 삭제",
                          class: "rounded-md bg-rose-800 px-4 py-2 text-sm font-semibold text-white" %>
        <% end %>
      <% else %>
        <%= button_to "전교투표 삭제", school_poll_path(@poll), method: :delete,
                      form: { data: { turbo_frame: "_top" } },
                      data: { turbo_confirm: "관련 학급 Session, 재투표와 결과를 모두 영구 삭제할까요?" },
                      class: "mt-4 rounded-md bg-rose-700 px-4 py-2 text-sm font-semibold text-white" %>
      <% end %>
    </section>
  <% elsif @poll.closed? || @poll.archived? %>
    <p class="text-sm text-stone-600">정상 종료된 전교투표는 보존되며 초기화하거나 삭제할 수 없습니다.</p>
  <% end %>
</div>
