<section class="space-y-4 rounded-xl border border-stone-200 bg-white p-6 shadow-sm"
         data-testid="schoolwide-status-check">
  <% issues = poll.draft? ? status_check.start_issues : status_check.close_issues %>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="text-xl font-semibold">상태점검</h2>
        <%= poll_status_badge(poll) %>
      </div>
      <p class="mt-2 text-sm text-stone-600">
        시작 <%= kst_datetime(poll.started_at) %> · 종료 <%= kst_datetime(poll.closed_at) %>
        <% if poll.lifecycle_duration_minutes.present? %>
          · 진행 시간 <%= poll.lifecycle_duration_minutes %>분
        <% end %>
      </p>
    </div>
    <% if poll.draft? && status_check.startable? %>
      <%= button_to "전교투표 시작", start_school_poll_path(poll), method: :post,
                    data: { turbo_confirm: "전교투표를 시작할까요? 시작 후 항목과 학급 배정을 변경할 수 없습니다." },
                    class: "rounded-md bg-emerald-600 px-5 py-3 text-sm font-semibold text-white" %>
    <% elsif poll.in_progress? && status_check.closable? %>
      <%= button_to "전교투표 종료", close_school_poll_path(poll), method: :post,
                    data: { turbo_confirm: "모든 학급 결과를 확인하고 전교투표를 종료할까요?" },
                    class: "rounded-md bg-stone-900 px-5 py-3 text-sm font-semibold text-white" %>
    <% end %>
  </div>

  <dl class="grid gap-3 text-sm sm:grid-cols-6">
    <% [["전체 학급", current_session_counts.values.sum],
        ["준비", current_session_counts.fetch("draft", 0)],
        ["진행 중", current_session_counts.fetch("in_progress", 0)],
        ["종료", current_session_counts.fetch("closed", 0)],
        ["중단", current_session_counts.fetch("stopped", 0)],
        ["재투표 이력", history_session_count]].each do |label, count| %>
      <div class="rounded-md bg-stone-50 p-3">
        <dt class="text-stone-500"><%= label %></dt>
        <dd class="mt-1 text-xl font-semibold"><%= count %></dd>
      </div>
    <% end %>
  </dl>

  <% if !poll.closed? && issues.any? %>
    <div class="rounded-md border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
      <p class="font-medium"><%= poll.draft? ? "시작 전 확인이 필요합니다." : "종료 전 확인이 필요합니다." %></p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% issues.each do |issue| %>
          <li><%= issue %></li>
        <% end %>
      </ul>
    </div>
  <% elsif poll.closed? %>
    <p class="font-medium text-emerald-700">전교투표가 종료되었습니다.</p>
  <% else %>
    <p class="font-medium text-emerald-700"><%= poll.draft? ? "전교투표를 시작할 수 있습니다." : "모든 학급 투표가 종료되었습니다." %></p>
  <% end %>
</section>
