<%= tag.section id: dom_id(poll, :status_report),
                class: "space-y-4 rounded-xl border border-stone-200 bg-white p-6 shadow-sm",
                data: { testid: "schoolwide-status-check" } do %>
  <%= render "school_polls/status_runtime",
             poll: poll,
             status_check: status_check,
             current_session_counts: current_session_counts,
             current_session_total: current_session_total,
             history_session_count: history_session_count %>
<% end %>
