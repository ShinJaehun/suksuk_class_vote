<div class="space-y-6">
  <div class="space-y-2">
    <% if @return_poll.present? %>
      <p><%= link_to "#{@return_poll.title} 투표로 돌아가기", poll_path(@return_poll), class: "text-sm font-medium text-stone-600 underline" %></p>
    <% elsif @safe_return_to.present? %>
      <p><%= link_to "전교임원선거 투표자 목록으로 돌아가기", @safe_return_to, class: "text-sm font-medium text-stone-600 underline" %></p>
    <% else %>
      <p><%= link_to "내 투표자 목록으로 돌아가기", participant_groups_path, class: "text-sm font-medium text-stone-600 underline" %></p>
    <% end %>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <% owner = @participant_group.user %>
      <% owner_label = owner&.name.presence || owner&.email.presence || "담당 교사 정보 없음" %>
      <div class="space-y-1">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-2xl font-semibold"><%= @participant_group.display_name %></h1>
          <% if @participant_group.school_election? %>
            <span class="rounded-md border border-indigo-200 bg-indigo-50 px-2 py-1 text-sm font-medium text-indigo-700">전교임원선거</span>
          <% end %>
        </div>
        <p class="text-sm text-stone-600">
          <% if @participant_group.school_election? %>
            <%= @participant_group.school&.name || "학교 정보 없음" %>
            · 담당 교사: <%= owner_label %>
          <% else %>
            담당 교사: <%= owner_label %>
          <% end %>
        </p>
      </div>

      <% if policy(@participant_group).update? || (current_user.admin? && policy(@participant_group).destroy?) %>
        <div class="flex flex-wrap items-center gap-2">
          <% if policy(@participant_group).update? %>
            <% if @participant_group.school_election? && current_user.admin? %>
              <%= link_to "정보 수정",
                          edit_admin_election_roster_path(@participant_group),
                          class: "rounded-md border border-stone-300 bg-white px-3 py-2 text-sm font-medium text-stone-700" %>
            <% else %>
              <%= link_to "정보 수정",
                          edit_participant_group_path(@participant_group, return_to_poll_id: @return_poll&.id),
                          class: "rounded-md border border-stone-300 bg-white px-3 py-2 text-sm font-medium text-stone-700" %>
            <% end %>
          <% end %>
          <% if current_user.admin? && policy(@participant_group).destroy? && !@participant_group.used_by_draft_poll? %>
            <% if @participant_group.school_election? %>
              <%= button_to "투표자 명단 삭제",
                            admin_election_roster_path(@participant_group),
                            method: :delete,
                            data: { turbo_confirm: "투표자 명단을 삭제할까요?" },
                            class: "rounded-md border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-medium text-rose-700 hover:bg-rose-100" %>
            <% else %>
              <%= button_to "투표자 명단 삭제",
                            participant_group_path(@participant_group),
                            method: :delete,
                            data: { turbo_confirm: "투표자 명단을 삭제할까요?" },
                            class: "rounded-md border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-medium text-rose-700 hover:bg-rose-100" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <section class="space-y-4 <%= @participant_group.school_election? ? "rounded-md border border-indigo-100 bg-indigo-50/30 p-4" : "rounded-md border border-stone-200 bg-white p-4" %>">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <h2 class="text-xl font-semibold">투표자</h2>

      <div class="flex flex-wrap items-center gap-2">
        <%= link_to "명단 수정",
                    edit_participant_group_roster_path(@participant_group, return_to: @safe_return_to),
                    class: "rounded-md border border-indigo-200 bg-indigo-50 px-3 py-2 text-sm font-medium text-indigo-700" %>
        <%= link_to "투표자 1명 추가",
                    new_participant_group_participant_slot_path(@participant_group, return_to_poll_id: @return_poll&.id, return_to: @safe_return_to),
                    class: "rounded-md bg-stone-900 px-3 py-2 text-sm font-medium text-white" %>
        <%= link_to "여러 명 추가",
                    new_participant_group_bulk_participant_slots_path(@participant_group, return_to_poll_id: @return_poll&.id, return_to: @safe_return_to),
                    class: "rounded-md border border-stone-300 bg-white px-3 py-2 text-sm font-medium text-stone-700" %>
      </div>
    </div>

    <% if @participant_group.participant_slots.any? %>
      <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        <% @participant_group.participant_slots.order(:number).each do |participant_slot| %>
          <li class="flex items-center gap-2 rounded-md border border-stone-200 bg-white px-3 py-2 text-sm">
            <span class="shrink-0 text-stone-500"><%= participant_slot.number %>번</span>
            <span class="font-medium text-stone-900"><%= participant_slot.name %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-stone-600">아직 등록된 투표자가 없습니다.</p>
    <% end %>
  </section>
</div>
