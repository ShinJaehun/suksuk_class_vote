<div class="flex items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold">투표자 명단</h1>

  <% if current_user.admin? %>
    <%= link_to "새 투표자 명단 만들기",
                new_participant_group_path,
                class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  <% end %>
</div>

<ul class="space-y-3">
  <% @participant_groups.each do |participant_group| %>
    <% owner = participant_group.user %>
    <% owner_label = owner&.name.presence || owner&.email.presence || "담당 교사 정보 없음" %>
    <li class="rounded-md border border-stone-200 bg-white p-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="space-y-1">
          <h2 class="font-medium"><%= participant_group.name %></h2>
          <p class="text-sm text-stone-600">담당 교사: <%= owner_label %> · 투표자 <%= participant_group.participant_slots.size %>명</p>
        </div>

        <%= link_to "상세",
                    participant_group_path(participant_group),
                    class: "text-sm font-medium text-stone-700 underline" %>
      </div>
    </li>
  <% end %>
</ul>
