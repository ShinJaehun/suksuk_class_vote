<div class="flex items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold">내 투표자 목록</h1>

  <% if current_user.admin? %>
    <%= link_to "새 투표자 목록 만들기",
                new_participant_group_path,
                class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  <% end %>
</div>

<% participant_groups = @participant_groups.to_a + @school_election_participant_groups.to_a %>
<% if participant_groups.any? %>
  <ul class="mt-6 space-y-3">
    <% participant_groups.each do |participant_group| %>
      <li class="<%= participant_group.school_election? ? "rounded-md border border-indigo-100 bg-indigo-50/30 p-4" : "rounded-md border border-stone-200 bg-white p-4" %>">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-medium"><%= participant_group.display_name %></h2>
              <% if participant_group.school_election? %>
                <span class="rounded-md border border-indigo-200 bg-indigo-50 px-2 py-1 text-sm font-medium text-indigo-700">전교임원선거</span>
              <% end %>
            </div>
            <% if participant_group.school_election? %>
              <% owner = participant_group.user %>
              <% owner_label = owner&.name.presence || owner&.email.presence || "담당 교사 정보 없음" %>
              <p class="text-sm text-stone-600">
                담당 교사 : <%= owner_label %> / 투표자 <%= participant_group.participant_slots.size %>명
              </p>
            <% else %>
              <p class="text-sm text-stone-600">
                투표자 <%= participant_group.participant_slots.size %>명
              </p>
            <% end %>
          </div>

          <%= link_to "상세",
                      participant_group_path(participant_group),
                      class: participant_group.school_election? ? "text-sm font-medium text-indigo-700 underline" : "text-sm font-medium text-stone-700 underline" %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="mt-6 rounded-md border border-dashed border-stone-300 bg-stone-50 p-3 text-sm text-stone-600">등록된 투표자 명단이 없습니다.</p>
<% end %>
