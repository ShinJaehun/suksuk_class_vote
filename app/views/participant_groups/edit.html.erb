<div class="space-y-6">
  <h1 class="text-2xl font-semibold">투표자 목록 정보 수정</h1>

  <% if @participant_group.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-4 text-red-800">
      <h2 class="font-medium">투표자 명단을 수정할 수 없습니다.</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% @participant_group.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @participant_group, url: participant_group_path(@participant_group, return_to_poll_id: @return_poll&.id), class: "space-y-4 rounded-md border border-stone-200 bg-white p-4" do |form| %>
    <div class="space-y-1">
      <%= form.label :name, "이름", class: "text-sm font-medium text-stone-700" %>
      <%= form.text_field :name, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>

    <%= form.submit "저장", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  <% end %>

  <p><%= link_to "투표자 명단으로 돌아가기", participant_group_path(@participant_group, return_to_poll_id: @return_poll&.id), class: "text-sm font-medium text-stone-700 underline" %></p>
</div>
