<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="mx-auto max-w-4xl space-y-6" data-controller="credential-list" data-credential-list-return-url-value="<%= @credentials_return_path %>">
  <div>
    <h1 class="text-3xl font-semibold"><%= @credentials_title %></h1>
    <p class="mt-2 text-sm text-rose-700">임시 비밀번호는 이 화면을 벗어나면 다시 확인할 수 없습니다. 분실하면 새 임시 비밀번호를 재발급해야 합니다.</p>
  </div>

  <div class="flex flex-wrap gap-2 print:hidden">
    <button type="button" class="rounded-md border border-stone-300 px-3 py-2 text-sm font-medium" data-action="credential-list#copyAll">전체 복사</button>
    <button type="button" class="rounded-md border border-stone-300 px-3 py-2 text-sm font-medium" data-action="credential-list#print">인쇄</button>
  </div>

  <div class="overflow-x-auto rounded-md border border-stone-200">
    <table class="min-w-full divide-y divide-stone-200 text-sm">
      <thead class="bg-stone-50"><tr><th class="p-3 text-left">이름</th><th class="p-3 text-left">로그인 ID</th><th class="p-3 text-left">임시 비밀번호</th><th class="p-3 text-left print:hidden">복사</th></tr></thead>
      <tbody class="divide-y divide-stone-100">
        <% @credentials.each do |credential| %>
          <tr data-credential-list-target="row" data-copy-text="<%= [credential[:name], credential[:login_id], credential[:temporary_password]].join("\t") %>">
            <td class="p-3"><%= credential[:name] %></td>
            <td class="p-3 font-mono"><%= credential[:login_id] %></td>
            <td class="p-3 font-mono font-semibold"><%= credential[:temporary_password] %></td>
            <td class="p-3 print:hidden"><button type="button" class="text-sm font-medium underline" data-action="credential-list#copyRow">복사</button></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= link_to "선생님 운영으로 돌아가기", @credentials_return_path, class: "inline-flex rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white print:hidden" %>
</div>
