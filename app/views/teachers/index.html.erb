<div class="space-y-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="space-y-1">
      <h1 class="text-3xl font-semibold">선생님</h1>
      <p class="text-sm text-stone-600">계정, 학교 소속과 현재 담당 교실을 확인합니다.</p>
    </div>
    <%= link_to "선생님 추가", new_teacher_path, class: "inline-flex justify-center rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  </div>

  <%= form_with url: teachers_path, method: :get, class: "grid gap-3 rounded-md border border-stone-200 bg-white p-4 sm:grid-cols-2 lg:grid-cols-4" do |form| %>
    <% if current_user.admin? %>
      <div class="space-y-1">
        <%= form.label :school_id, "학교", class: "text-sm font-medium" %>
        <%= form.select :school_id,
                        options_from_collection_for_select(@schools, :id, :name, @school_id),
                        { include_blank: "전체 학교" },
                        class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
      </div>
    <% end %>
    <div class="space-y-1">
      <%= form.label :grade, "학년", class: "text-sm font-medium" %>
      <%= form.select :grade,
                      options_for_select([["전체", "all"], *1.upto(6).map { |grade| ["#{grade}학년", grade] }, ["미배정", "unassigned"]], @grade),
                      {},
                      class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>
    <div class="space-y-1">
      <%= form.label :status, "상태", class: "text-sm font-medium" %>
      <%= form.select :status,
                      options_for_select([["활성", "active"], ["비활성", "inactive"], ["전체", "all"]], @status),
                      {},
                      class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>
    <div class="space-y-1">
      <%= form.label :query, "검색", class: "text-sm font-medium" %>
      <div class="flex gap-2">
        <%= form.text_field :query, value: @query, placeholder: "이름 또는 로그인 ID", class: "min-w-0 flex-1 rounded-md border border-stone-300 px-3 py-2" %>
        <%= form.submit "조회", class: "rounded-md bg-stone-800 px-4 py-2 text-sm font-medium text-white" %>
      </div>
    </div>
  <% end %>

  <% if @teachers.any? %>
    <ul class="space-y-3">
      <% @teachers.each do |teacher| %>
        <li class="rounded-md border border-stone-200 bg-white p-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-lg font-semibold"><%= teacher.name.presence || "이름 없음" %></h2>
                <span class="rounded-full px-2 py-0.5 text-xs font-medium <%= teacher.active? ? 'bg-emerald-100 text-emerald-800' : 'bg-stone-200 text-stone-700' %>"><%= teacher.active? ? "활성" : "비활성" %></span>
              </div>
              <p class="text-sm text-stone-600">로그인 ID <%= teacher.login_id %></p>
              <% if teacher.email.present? %>
                <p class="text-sm text-stone-600">이메일 <%= teacher.email %></p>
              <% end %>
              <p class="text-sm text-stone-600">소속 학교 <%= teacher.school&.name || "미소속" %> · 학교 역할 <%= teacher.school_membership&.manager? ? "대표 선생님" : (teacher.school_membership.present? ? "일반 선생님" : "-") %></p>
              <% classroom = teacher.active_classroom %>
              <p class="text-sm text-stone-600">현재 담당 교실 <%= classroom ? "#{classroom.grade}학년 #{classroom.formatted_class_label}" : "미배정" %></p>
            </div>
            <div class="text-right">
              <p class="text-sm text-stone-500">생성일 <%= teacher.created_at.to_date %></p>
              <% if teacher.school.present? %>
                <%= link_to "학교 소속 설정", school_teacher_memberships_path(teacher.school), class: "ml-2 text-sm font-medium underline" %>
              <% end %>
              <% if classroom %>
                <%= link_to "교실 설정", edit_classroom_path(classroom), class: "ml-2 text-sm font-medium underline" %>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="rounded-md border border-stone-200 bg-white p-4 text-stone-600">조건에 맞는 선생님 계정이 없습니다.</p>
  <% end %>
</div>
