<div class="space-y-4">
  <% unless current_user.admin? %>
    <p class="text-sm font-medium text-stone-600"><%= @school.name %></p>
  <% end %>

  <section class="rounded-md border border-stone-200 bg-white p-5">
    <div class="flex flex-wrap gap-2">
      <% [["전체", "all"], *1.upto(6).map { |grade| ["#{grade}학년", grade.to_s] }, ["미배정", "unassigned"]].each do |label, grade| %>
        <%= link_to label,
                    teachers_path(school_id: @school.id, grade: grade),
                    class: "rounded-md border px-3 py-2 text-sm font-medium #{@grade == grade ? 'border-stone-900 bg-stone-900 text-white' : 'border-stone-300 bg-white'}",
                    data: { turbo_frame: "teacher_management", turbo_action: "advance" } %>
      <% end %>
    </div>

    <%= render "teachers/bulk_edit_table" %>
  </section>
</div>
