<%= turbo_frame_tag "temporary_password_modal" do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-stone-900/40 p-4" data-controller="temporary-password-modal" <% if @credential %>data-temporary-password-modal-copy-text-value="<%= [@credential[:name], @credential[:login_id], @credential[:temporary_password]].join("\t") %>"<% end %>>
    <section class="w-full max-w-md rounded-lg bg-white p-6 shadow-xl">
      <% if @credential %>
        <h2 class="text-xl font-semibold">새 임시 비밀번호가 발급되었습니다.</h2>
        <p class="mt-2 text-sm text-rose-700">이 비밀번호는 창을 닫으면 다시 확인할 수 없습니다.</p>
        <dl class="mt-5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
          <dt class="font-medium">이름</dt><dd><%= @credential[:name] %></dd>
          <dt class="font-medium">로그인 ID</dt><dd class="font-mono"><%= @credential[:login_id] %></dd>
          <dt class="font-medium">임시 비밀번호</dt><dd class="font-mono font-semibold"><%= @credential[:temporary_password] %></dd>
        </dl>
        <div class="mt-6 flex justify-end gap-2">
          <button type="button" class="rounded-md border border-stone-300 px-4 py-2 text-sm font-medium" data-action="temporary-password-modal#copy">복사</button>
          <button type="button" class="rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" data-action="temporary-password-modal#close">닫기</button>
        </div>
      <% else %>
        <h2 class="text-xl font-semibold">임시 비밀번호 재발급</h2>
        <p class="mt-3 font-medium"><%= @teacher.name %> (<%= @teacher.login_id %>)</p>
        <p class="mt-3 text-sm text-stone-600">새 임시 비밀번호를 발급하면 현재 비밀번호는 더 이상 사용할 수 없습니다.</p>
        <div class="mt-6 flex justify-end gap-2">
          <button type="button" class="rounded-md border border-stone-300 px-4 py-2 text-sm font-medium" data-action="temporary-password-modal#close">취소</button>
          <%= button_to "재발급", issue_temporary_password_teacher_path(@teacher, teacher_grade: params[:teacher_grade]), method: :post, class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
        </div>
      <% end %>
    </section>
  </div>
<% end %>
