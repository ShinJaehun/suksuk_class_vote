<div id="<%= dom_id(teacher, :bulk_password_action) %>">
  <% if teacher.active? %>
    <%= link_to "재발급", temporary_password_teacher_path(teacher, teacher_grade: teacher_grade), class: "text-sm font-medium underline", data: { turbo_frame: "temporary_password_modal" } %>
  <% elsif teacher.school_membership&.grade.nil? && teacher.active_classroom.nil? %>
    <%= link_to "삭제", teacher_path(teacher, teacher_grade: teacher_grade), class: "text-sm font-medium text-rose-700 underline", data: { turbo_method: :delete, turbo_confirm: "#{teacher.name}(#{teacher.login_id}) 계정을 완전히 삭제합니다. 삭제한 계정은 복구할 수 없습니다. 계속하시겠습니까?" } %>
  <% else %>
    <span aria-hidden="true">—</span>
  <% end %>
</div>
