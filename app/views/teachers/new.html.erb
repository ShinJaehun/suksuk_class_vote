<div class="space-y-6">
  <div class="space-y-1">
    <p><%= link_to "돌아가기", @school_context ? teachers_path(school_id: @school.id, grade: params[:return_grade].presence || @grade || "unassigned") : teachers_path, class: "text-sm font-medium text-stone-600 underline" %></p>
    <h1 class="text-3xl font-semibold">선생님 추가</h1>
  </div>

  <% if @teacher.errors.any? %>
    <section class="rounded-md border border-rose-200 bg-rose-50 p-4 text-rose-800">
      <h2 class="font-semibold">선생님 계정을 생성할 수 없습니다.</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% @teacher.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="rounded-md border border-stone-200 bg-white p-4">
    <%= form_with model: @teacher, url: teachers_path, class: "space-y-4", data: { turbo: false, controller: "teacher-bulk" } do |form| %>
      <div data-teacher-bulk-target="row">
        <%= hidden_field_tag :school_context, true if @school_context %>
        <%= hidden_field_tag :school_id, @school.id if @school_context %>
        <%= hidden_field_tag :return_grade, params[:return_grade] if @school_context %>
        <% if current_user.admin? && !@school_context %>
          <div class="space-y-1">
            <%= label_tag :school_id, "소속 학교", class: "text-sm font-medium text-stone-700" %>
            <%= select_tag :school_id,
                           options_from_collection_for_select(@schools, :id, :name, @school&.id),
                           prompt: "학교 선택",
                           class: "w-full rounded-md border border-stone-300 px-3 py-2",
                           data: { teacher_bulk_target: "school", action: "change->teacher-bulk#filter" } %>
          </div>
        <% else %>
          <div class="space-y-1">
            <p class="text-sm font-medium text-stone-700">소속 학교</p>
            <p class="rounded-md bg-stone-100 px-3 py-2"><%= @school.name %></p>
          </div>
        <% end %>

        <% if @school_context %>
          <%= hidden_field_tag :grade, @grade || "unassigned", data: { teacher_bulk_target: "grade" } %>
          <p><span class="text-sm font-medium text-stone-700">학년</span><br><%= @grade ? "#{@grade}학년" : "미배정" %></p>
        <% else %>
          <div class="space-y-1">
            <%= label_tag :grade, "학년", class: "text-sm font-medium text-stone-700" %>
            <%= select_tag :grade, options_for_select([["미배정", ""], *1.upto(6).map { |grade| ["#{grade}학년", grade] }], @grade), class: "w-full rounded-md border border-stone-300 px-3 py-2", data: { teacher_bulk_target: "grade", action: "change->teacher-bulk#filter" } %>
          </div>
        <% end %>

        <div class="space-y-1">
          <%= label_tag :classroom_id, "담당 반", class: "text-sm font-medium text-stone-700" %>
          <select name="classroom_id" class="w-full rounded-md border border-stone-300 px-3 py-2" data-teacher-bulk-target="classroom">
            <option value="">미배정</option>
            <% @classrooms.each do |classroom| %>
              <option value="<%= classroom.id %>" data-school-id="<%= classroom.school_id %>" data-grade="<%= classroom.grade %>" <%= "selected" if classroom.id.to_s == params[:classroom_id].to_s %>><%= classroom.formatted_class_label %></option>
            <% end %>
          </select>
        </div>

        <div class="space-y-1">
          <%= form.label :name, "이름", class: "text-sm font-medium text-stone-700" %>
          <%= form.text_field :name, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
        </div>
        <div class="space-y-1">
          <%= form.label :login_id, "로그인 ID", class: "text-sm font-medium text-stone-700" %>
          <%= form.text_field :login_id, autocomplete: "username", class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
        </div>
        <p class="text-sm text-stone-600">임시 비밀번호는 계정 생성 시 자동으로 발급됩니다.</p>
        <div class="flex flex-wrap gap-2">
          <%= form.submit "선생님 계정 생성", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
          <%= link_to "취소", teachers_path, class: "inline-flex rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
        </div>
      </div>
    <% end %>
  </section>
</div>
