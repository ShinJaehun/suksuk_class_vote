<% membership = teacher.school_membership %>
<% classroom = teacher.active_classroom %>
<li id="<%= dom_id(teacher, :teacher_card) %>"
    class="grid gap-3 border-l-4 <%= school_teacher_row_classes(teacher.school) %> px-4 py-4 lg:grid-cols-[minmax(9rem,1fr)_minmax(7rem,0.8fr)_minmax(7rem,0.7fr)_minmax(10rem,1fr)_minmax(12rem,auto)] lg:items-center lg:gap-4 <%= 'opacity-60' unless teacher.active? %>"
    data-teacher-id="<%= teacher.id %>"
    data-active="<%= teacher.active? %>">
  <div>
    <p class="font-semibold"><%= teacher.name.presence || "이름 없음" %></p>
    <p class="text-sm text-stone-500"><%= teacher.login_id %></p>
  </div>
  <div>
    <p class="text-sm font-medium"><%= teacher.school&.name || "미소속" %></p>
    <p class="text-sm text-stone-500"><%= membership&.grade ? "#{membership.grade}학년" : "미배정" %></p>
  </div>
  <div>
    <% if membership&.manager? %>
      <span class="rounded-full border border-violet-200 bg-violet-50 px-2 py-0.5 text-xs font-medium text-violet-700">대표 선생님</span>
    <% elsif membership %>
      <span class="rounded-full border border-stone-200 bg-stone-50 px-2 py-0.5 text-xs font-medium text-stone-700">선생님</span>
    <% else %>
      <span class="text-sm text-stone-400">-</span>
    <% end %>
  </div>
  <div>
    <% if classroom %>
      <p class="text-sm font-medium"><%= classroom.grade %>학년 <%= classroom.formatted_class_label %></p>
      <p class="text-sm text-stone-500"><%= classroom.students.count(&:active?) %>명</p>
    <% else %>
      <p class="text-sm text-stone-500">미배정</p>
    <% end %>
  </div>
  <div class="space-y-2 lg:text-right">
    <p class="text-xs text-stone-500">생성일 <%= teacher.created_at.to_date %></p>
    <div class="flex flex-wrap gap-2 lg:justify-end">
      <%= link_to "설정", edit_teacher_path(teacher, return_to: "teachers"), class: "inline-flex rounded-md border border-stone-300 bg-white px-3 py-1.5 text-sm font-medium text-stone-700 hover:bg-stone-100" %>
      <% if teacher.active? && classroom %>
        <%= link_to "교실 바로가기", classroom_students_path(classroom), class: "inline-flex rounded-md border border-stone-300 bg-white px-3 py-1.5 text-sm font-medium text-stone-700 hover:bg-stone-100" %>
      <% end %>
      <% if teacher.active? && teacher.school && policy(teacher).deactivate? %>
        <%= link_to "비활성화", deactivate_teacher_path(teacher, school_id: teacher.school.id), class: "inline-flex rounded-md border border-rose-200 bg-rose-50 px-3 py-1.5 text-sm font-medium text-rose-700 hover:bg-rose-100", data: { turbo_method: :patch } %>
      <% elsif !teacher.active? && teacher.school && policy(teacher).reactivate? %>
        <%= link_to "활성화", reactivate_teacher_path(teacher, school_id: teacher.school.id), class: "inline-flex rounded-md border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-sm font-medium text-emerald-700 hover:bg-emerald-100", data: { turbo_method: :patch } %>
        <% if policy(teacher).destroy? && membership&.grade.nil? && classroom.nil? %>
          <%= link_to "삭제", teacher_path(teacher, return_to: "teachers"), class: "inline-flex rounded-md border border-rose-300 bg-white px-3 py-1.5 text-sm font-medium text-rose-700 hover:bg-rose-50", data: { turbo_method: :delete, turbo_confirm: "#{teacher.name}(#{teacher.login_id}) 계정을 완전히 삭제합니다. 삭제한 계정은 복구할 수 없습니다. 계속하시겠습니까?" } %>
        <% end %>
      <% end %>
    </div>
  </div>
</li>
