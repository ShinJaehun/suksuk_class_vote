<div class="mx-auto max-w-xl space-y-6">
  <div>
    <% if @return_context == "teachers" %>
      <%= link_to "선생님 목록으로 돌아가기", @return_path, class: "text-sm underline" %>
    <% elsif @return_context == "school" %>
      <%= link_to "학교 운영으로 돌아가기", @return_path, class: "text-sm underline" %>
    <% end %>
    <h1 class="mt-2 text-3xl font-semibold">선생님 설정</h1>
    <p class="mt-1 text-sm text-stone-600">
      소속 학교<br>
      <%= @teacher.school ? "#{@teacher.school.name} · #{@teacher.school_membership&.grade ? "#{@teacher.school_membership.grade}학년" : "미배정"}" : "미소속" %>
    </p>
  </div>

  <% if @teacher.errors.any? %>
    <div class="rounded-md border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800"><%= @teacher.errors.full_messages.to_sentence %></div>
  <% end %>

  <%= form_with model: @teacher,
                url: teacher_path(@teacher),
                method: :patch,
                class: "space-y-4 rounded-md border border-stone-200 bg-white p-5" do |form| %>
    <%= hidden_field_tag :teacher_grade, params[:teacher_grade] %>
    <%= hidden_field_tag :return_to, @return_context %>
    <div>
      <%= form.label :name, "이름", class: "text-sm font-medium" %>
      <%= form.text_field :name, class: "mt-1 w-full rounded-md border border-stone-400 bg-white px-3 py-2 shadow-sm focus:border-stone-700 focus:ring-stone-700", required: true %>
    </div>
    <div>
      <%= form.label :login_id, "로그인 ID", class: "text-sm font-medium" %>
      <%= form.text_field :login_id, class: "mt-1 w-full rounded-md border border-stone-400 bg-white px-3 py-2 shadow-sm focus:border-stone-700 focus:ring-stone-700", required: true %>
    </div>
    <div>
      <%= form.label :email, "이메일 (선택)", class: "text-sm font-medium" %>
      <%= form.email_field :email, class: "mt-1 w-full rounded-md border border-stone-400 bg-white px-3 py-2 shadow-sm focus:border-stone-700 focus:ring-stone-700" %>
    </div>
    <%= form.submit "저장", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  <% end %>

  <% if current_user == @teacher %>
    <%= form_with scope: :user, url: password_change_path, method: :patch, class: "space-y-4 rounded-md border border-stone-200 bg-white p-5" do |form| %>
      <h2 class="font-semibold">로그인 비밀번호</h2>
      <p class="mt-1 text-sm text-stone-600">현재 비밀번호를 확인한 뒤 새 비밀번호로 변경합니다.</p>
      <div>
        <%= form.label :current_password, "현재 비밀번호", class: "text-sm font-medium" %>
        <%= form.password_field :current_password, autocomplete: "current-password", class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2", required: true %>
      </div>
      <div>
        <%= form.label :password, "새 비밀번호", class: "text-sm font-medium" %>
        <%= form.password_field :password, autocomplete: "new-password", class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2", required: true %>
      </div>
      <div>
        <%= form.label :password_confirmation, "새 비밀번호 확인", class: "text-sm font-medium" %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 w-full rounded-md border border-stone-300 px-3 py-2", required: true %>
      </div>
      <%= form.submit "비밀번호 변경", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  <% elsif @teacher.active? %>
    <section class="rounded-md border border-stone-200 bg-white p-5">
      <h2 class="font-semibold">로그인 비밀번호</h2>
      <%= link_to "임시 비밀번호 재발급", temporary_password_teacher_path(@teacher), class: "mt-4 inline-flex rounded-md border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-100", data: { turbo_frame: "temporary_password_modal" } %>
    </section>
    <%= turbo_frame_tag "temporary_password_modal" %>
  <% end %>
</div>
