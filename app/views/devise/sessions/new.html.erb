<div class="flex min-h-[70vh] items-center justify-center">
  <section class="w-full max-w-md rounded-md border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
    <div class="mb-6 text-center">
      <%= image_tag "suksuk_logo.png", alt: "", class: "mx-auto h-16 w-16 object-contain" %>
      <h1 class="mt-3 text-3xl font-semibold text-stone-900">쑥쑥교실투표</h1>
      <p class="mt-2 text-sm text-stone-600">교사·관리자 로그인</p>
    </div>

    <% if alert.present? %>
      <p class="mb-4 rounded-md border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-800"><%= alert %></p>
    <% end %>

    <% if notice.present? %>
      <p class="mb-4 rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-800"><%= notice %></p>
    <% end %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |form| %>
      <div class="space-y-1">
        <%= form.label :email, "이메일", class: "text-sm font-medium text-stone-700" %>
        <%= form.email_field :email,
                             autofocus: true,
                             autocomplete: "email",
                             class: "w-full rounded-md border border-stone-300 px-3 py-2 text-stone-900 shadow-sm focus:border-stone-500 focus:outline-none focus:ring-2 focus:ring-stone-200" %>
      </div>

      <div class="space-y-1">
        <%= form.label :password, "비밀번호", class: "text-sm font-medium text-stone-700" %>
        <%= form.password_field :password,
                                autocomplete: "current-password",
                                class: "w-full rounded-md border border-stone-300 px-3 py-2 text-stone-900 shadow-sm focus:border-stone-500 focus:outline-none focus:ring-2 focus:ring-stone-200" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2">
          <%= form.check_box :remember_me, class: "h-4 w-4 rounded border-stone-300 text-stone-900" %>
          <%= form.label :remember_me, "로그인 상태 유지", class: "text-sm text-stone-700" %>
        </div>
      <% end %>

      <%= form.submit "로그인", class: "w-full rounded-md bg-stone-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-stone-800" %>
    <% end %>
  </section>
</div>
