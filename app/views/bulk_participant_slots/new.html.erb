<div class="space-y-6">
  <div class="space-y-2">
    <p><%= link_to "투표자 명단으로 돌아가기", participant_group_path(@participant_group, return_to_poll_id: params[:return_to_poll_id]), class: "text-sm font-medium text-stone-600 underline" %></p>

    <h1 class="text-2xl font-semibold">여러 명 추가</h1>
  </div>

  <% if @errors.present? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-4 text-red-800">
      <h2 class="font-medium">투표자 명단을 저장할 수 없습니다.</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% @errors.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
    <% if @count.blank? %>
      <%= form_with url: new_participant_group_bulk_participant_slots_path(@participant_group, return_to_poll_id: params[:return_to_poll_id]), method: :get, class: "space-y-4" do |form| %>
        <div class="space-y-1">
          <%= form.label :count, "추가할 투표자 수", class: "text-sm font-medium text-stone-700" %>
          <%= form.number_field :count,
                                min: 1,
                                max: BulkParticipantSlotsController::MAX_COUNT,
                                class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
        </div>

        <%= form.submit "입력칸 만들기", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
      <% end %>
    <% else %>
      <%= form_with url: participant_group_bulk_participant_slots_path(@participant_group, return_to_poll_id: params[:return_to_poll_id]), class: "space-y-4" do |form| %>
        <% start_number = @participant_group.participant_slots.maximum(:number).to_i + 1 %>

        <div class="space-y-3">
          <% @count.times do |index| %>
            <div class="grid gap-3 sm:grid-cols-[8rem_1fr]">
              <div class="space-y-1">
                <span class="text-sm font-medium text-stone-700">번호</span>
                <div class="rounded-md border border-stone-200 bg-stone-50 px-3 py-2 text-stone-700"><%= start_number + index %></div>
              </div>

              <div class="space-y-1">
                <%= label_tag "bulk_participant_slots_names_#{index}", "이름", class: "text-sm font-medium text-stone-700" %>
                <%= text_field_tag "bulk_participant_slots[names][]",
                                   @names&.[](index),
                                   id: "bulk_participant_slots_names_#{index}",
                                   class: "w-full rounded-md border border-stone-300 px-3 py-2",
                                   placeholder: "이름" %>
              </div>
            </div>
          <% end %>
        </div>

        <%= form.submit "투표자 추가", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
      <% end %>
    <% end %>
  </div>
</div>
