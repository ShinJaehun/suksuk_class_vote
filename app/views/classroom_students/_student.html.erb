<%= turbo_frame_tag dom_id(student), class: "block" do %>
  <div class="flex flex-col gap-3 rounded-md border border-stone-300 p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between <%= student.active? ? 'bg-white' : 'bg-stone-50 text-stone-500' %>">
    <div class="<%= 'opacity-60' unless student.active? %>" data-student-summary>
      <p class="font-medium"><%= student.number %>번 <%= student.name %></p>
      <p class="mt-1 text-sm <%= student.active? ? 'text-emerald-700' : 'text-stone-500' %>"><%= student.active? ? "활성" : "비활성" %></p>
    </div>
    <% if policy(@classroom).manage_students? %>
      <div class="flex flex-wrap gap-3 text-sm font-medium">
        <%= link_to "수정", edit_classroom_student_path(@classroom, student, **student_status_context_params(@status), **student_return_context_params), class: "underline" %>
        <% if student.active? %>
          <%= button_to "비활성화", deactivate_classroom_student_path(@classroom, student, **student_status_context_params(@status), **student_return_context_params), method: :patch, class: "text-rose-700 underline" %>
        <% else %>
          <%= button_to "복구", reactivate_classroom_student_path(@classroom, student, **student_status_context_params(@status), **student_return_context_params), method: :patch, class: "text-emerald-700 underline" %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
