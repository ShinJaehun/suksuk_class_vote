<%= form_with model: [classroom, student], class: "rounded-md border border-stone-300 bg-white p-4 shadow-sm" do |form| %>
  <% number_error_records = student.errors.where(:number) %>
  <% number_error_records = number_error_records.select { |error| error.type == :taken } if number_error_records.any? { |error| error.type == :taken } %>
  <% number_errors = number_error_records.map do |error|
       case error.type
       when :taken
         "이미 사용 중인 번호입니다."
       when :blank, :not_a_number, :not_an_integer, :greater_than
         "번호는 1 이상의 자연수여야 합니다."
       else
         error.full_message
       end
     end.uniq %>
  <% name_errors = student.errors.full_messages_for(:name) %>
  <div class="grid gap-3 sm:grid-cols-[7rem_1fr_auto] sm:items-end">
    <div>
      <%= form.label :number, "번호", class: "block text-xs font-medium text-stone-600" %>
      <div class="mt-1 flex items-center gap-1">
        <%= form.number_field :number, min: 1, class: "w-full rounded-md border bg-white px-3 py-2 shadow-sm focus:border-stone-700 focus:ring-stone-700 #{number_errors.any? ? 'border-rose-400' : 'border-stone-400'}" %><span>번</span>
      </div>
      <% number_errors.each do |message| %><p class="mt-1 text-xs text-rose-700" data-field-error="number"><%= message %></p><% end %>
    </div>
    <div>
      <%= form.label :name, "이름", class: "block text-xs font-medium text-stone-600" %>
      <%= form.text_field :name, class: "mt-1 w-full rounded-md border bg-white px-3 py-2 shadow-sm focus:border-stone-700 focus:ring-stone-700 #{name_errors.any? ? 'border-rose-400' : 'border-stone-400'}" %>
      <% name_errors.each do |message| %><p class="mt-1 text-xs text-rose-700" data-field-error="name"><%= message %></p><% end %>
    </div>
    <div class="flex gap-2">
      <%= form.submit student.new_record? ? "등록" : "저장", class: "rounded-md bg-stone-900 px-3 py-2 text-sm font-medium text-white" %>
      <%= link_to "취소", classroom_students_path(classroom, **student_status_context_params(params[:status]), **student_return_context_params), class: "rounded-md border border-stone-300 bg-white px-3 py-2 text-sm font-medium text-stone-700 hover:bg-stone-100" %>
    </div>
  </div>
  <%= hidden_field_tag :status, params[:status] if student.persisted? %>
  <% student_return_context_params.each do |key, value| %><%= hidden_field_tag key, value %><% end %>
<% end %>
