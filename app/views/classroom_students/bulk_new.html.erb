<div><h1 class="text-2xl font-semibold">여러 학생 추가</h1><p class="mt-1 text-stone-600"><%= @classroom.school_year %>학년도 <%= @classroom.grade %>학년 <%= @classroom.formatted_class_label %></p><%= link_to "학생 관리로 돌아가기", classroom_students_path(@classroom), class: "text-sm underline" %></div>

<%= form_with url: bulk_create_classroom_students_path(@classroom), method: :post, class: "space-y-5 rounded-md border border-stone-200 bg-white p-6" do |form| %>
  <% if @bulk_errors.any? %><div class="rounded-md border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800"><ul class="list-disc pl-5"><% @bulk_errors.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div><%= form.label :students, "학생 명단", class: "block text-sm font-medium" %><p class="mt-1 text-sm text-stone-600">한 줄에 학생 한 명을 번호와 이름으로 입력하세요. 쉼표나 탭도 사용할 수 있습니다.</p><%= form.text_area :students, value: @bulk_input, rows: 12, placeholder: "1 김민수\n2 이서준\n3 박하은", class: "mt-3 w-full rounded-md border-stone-300 font-mono" %></div>
  <%= form.submit "여러 학생 등록", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
<% end %>
