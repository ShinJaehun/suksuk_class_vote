<div class="space-y-6">
  <div>
    <%= link_to "학생 관리로 돌아가기", classroom_students_path(@classroom, **student_status_context_params(@status), **student_return_context_params), class: "text-sm underline" %>
    <h1 class="mt-2 text-2xl font-semibold">학생 정보 편집</h1>
    <p class="mt-1 text-stone-600"><%= @classroom.grade %>학년 <%= @classroom.formatted_class_label %> · <%= { "active" => "활성", "inactive" => "비활성", "all" => "전체" }.fetch(@status) %> 학생</p>
  </div>

  <% if @student_rows.any? %>
    <%= form_with url: bulk_update_classroom_students_path(@classroom), method: :patch, class: "space-y-5 rounded-md border border-stone-200 bg-white p-6", data: { controller: "student-rows" } do |form| %>
      <%= hidden_field_tag :status, @status %>
      <% student_return_context_params.each do |key, value| %><%= hidden_field_tag key, value %><% end %>
      <div class="space-y-2" data-student-rows-target="list">
        <% @student_rows.each_with_index do |row, index| %>
          <% number_errors = @row_errors.dig(index, :number) || [] %>
          <% name_errors = @row_errors.dig(index, :name) || [] %>
          <div class="grid gap-3 rounded-md border border-stone-300 bg-white p-3 shadow-sm sm:grid-cols-[5rem_1fr_auto] sm:items-center" data-student-rows-target="row">
            <%= hidden_field_tag "students[rows][#{index}][id]", row["id"] %>
            <%= hidden_field_tag "students[rows][#{index}][position]", index, data: { student_rows_target: "position" } %>
            <div>
              <%= label_tag "students_edit_rows_#{index}_number", "번호", class: "text-xs text-stone-500 sm:hidden" %>
              <%= number_field_tag "students[rows][#{index}][number]", row["number"], id: "students_edit_rows_#{index}_number", min: 1, step: 1, class: "w-full rounded-md border bg-white px-3 py-2 shadow-sm focus:border-stone-700 focus:ring-stone-700 #{number_errors.any? ? 'border-rose-400' : 'border-stone-400'}", data: { student_rows_target: "number" } %>
              <% number_errors.each do |message| %><p class="mt-1 text-xs text-rose-700" data-row-error="<%= index %>" data-field-error="number"><%= message %></p><% end %>
            </div>
            <div>
              <%= label_tag "students_edit_rows_#{index}_name", "이름", class: "text-xs text-stone-500 sm:hidden" %>
              <%= text_field_tag "students[rows][#{index}][name]", row["name"], id: "students_edit_rows_#{index}_name", class: "w-full rounded-md border bg-white px-3 py-2 shadow-sm focus:border-stone-700 focus:ring-stone-700 #{name_errors.any? ? 'border-rose-400' : 'border-stone-400'}" %>
              <% name_errors.each do |message| %><p class="mt-1 text-xs text-rose-700" data-row-error="<%= index %>" data-field-error="name"><%= message %></p><% end %>
            </div>
            <div class="flex gap-2">
              <button type="button" class="rounded-md border border-stone-300 bg-white px-3 py-2 text-sm font-medium text-stone-700 hover:bg-stone-100 disabled:cursor-not-allowed disabled:opacity-50" data-action="student-rows#up" data-student-rows-target="up">↑</button>
              <button type="button" class="rounded-md border border-stone-300 bg-white px-3 py-2 text-sm font-medium text-stone-700 hover:bg-stone-100 disabled:cursor-not-allowed disabled:opacity-50" data-action="student-rows#down" data-student-rows-target="down">↓</button>
              <button type="button" class="rounded-md border border-stone-300 bg-stone-50 px-3 py-2 text-sm font-medium text-stone-600 hover:bg-stone-100" data-action="student-rows#remove">제외</button>
            </div>
          </div>
        <% end %>
      </div>
      <%= form.submit "변경 저장", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  <% else %>
    <p class="rounded-md border border-dashed border-stone-300 bg-white p-8 text-center text-sm text-stone-600">편집할 학생이 없습니다.</p>
  <% end %>
</div>
