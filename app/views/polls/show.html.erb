<div class="space-y-6">
  <% if @poll.in_progress? %>
    <%= turbo_stream_from @poll, :operation_screen %>
  <% end %>

  <% activity_badge_class =
    case @poll.kind
    when "election" then "border-indigo-200 bg-indigo-50 text-indigo-700"
    when "discussion" then "border-sky-200 bg-sky-50 text-sky-700"
    when "debate" then "border-violet-200 bg-violet-50 text-violet-700"
    else "border-stone-200 bg-stone-50 text-stone-700"
    end %>
  <% status_badge_class =
    if @poll.draft?
      "border-amber-200 bg-amber-50 text-amber-700"
    elsif @poll.in_progress?
      "border-emerald-200 bg-emerald-50 text-emerald-700"
    elsif @poll.closed?
      "border-stone-300 bg-stone-100 text-stone-700"
    else
      "border-stone-200 bg-stone-50 text-stone-700"
    end %>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="space-y-2">
      <p><%= link_to "투표 목록으로 돌아가기", polls_path, class: "text-sm font-medium text-stone-600 underline" %></p>

      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-3xl font-semibold"><%= @poll.title %></h1>
        <span class="rounded-md border px-2 py-1 text-sm font-medium <%= activity_badge_class %>"><%= @poll.activity_label %></span>
        <span class="rounded-md border px-2 py-1 text-sm font-medium <%= status_badge_class %>"><%= @poll.display_status %></span>
      </div>
    </div>

    <% if @poll.in_progress? %>
      <%= link_to "투표 화면 열기",
                  ballot_poll_path(@poll),
                  target: "_blank",
                  rel: "noopener",
                  class: "inline-flex rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  </div>

  <%= render "poll_options", poll: @poll unless @poll.closed? %>
  <% if @poll.closed? %>
    <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
      <%= render "closed_result", result_summary: @result_summary %>
    </section>
  <% else %>
    <%= render "progress", poll: @poll %>
  <% end %>
  <%= render "event_log", poll: @poll, poll_events: @poll_events unless @poll.draft? %>
  <% if @poll.draft? %>
    <%= render "readiness", poll: @poll, integrity_report: @integrity_report %>
  <% else %>
    <%= render "integrity_report", poll: @poll, integrity_report: @integrity_report %>
  <% end %>
  <%= render "poll_participants", poll: @poll %>
</div>
