<% if @school_based_poll %>
  <%= render "school_overview",
             poll: @poll,
             poll_contests: @poll_contests,
             poll_sessions: @poll_sessions %>
<% else %>
<div class="space-y-6">
  <% if @poll.in_progress? %>
    <%= turbo_stream_from @poll, :operation_screen %>
  <% end %>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="space-y-2">
      <p><%= link_to "내 투표 목록으로 돌아가기", polls_path, class: "text-sm font-medium text-stone-600 underline" %></p>

      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-3xl font-semibold"><%= @poll.title %></h1>
        <%= poll_activity_badge(@poll) %>
        <%= poll_status_badge(@poll) %>
      </div>
      <% owner = @poll.user %>
      <% owner_label = owner&.name.presence || "미지정" %>
      <p class="text-sm text-stone-600">담당 교사: <%= owner_label %></p>
    </div>

    <div class="flex flex-wrap gap-2">
      <% if @poll.in_progress? %>
        <%= link_to "투표 화면 열기",
                    ballot_poll_path(@poll),
                    target: "_blank",
                    rel: "noopener",
                    class: "inline-flex rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
      <% elsif @poll.closed? && @poll.archived_at.blank? %>
        <%= button_to "보관",
                      archive_poll_path(@poll),
                      method: :post,
                      data: { turbo_confirm: "종료된 투표를 보관할까요?" },
                      class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
      <% end %>

      <% if @poll.destroyable_by_status? %>
        <%= button_to "투표 삭제",
                      poll_path(@poll),
                      method: :delete,
                      data: { turbo_confirm: "투표를 삭제할까요?" },
                      class: "rounded-md border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-medium text-rose-700" %>
      <% end %>
    </div>
  </div>

  <%= render "poll_options", poll: @poll if @poll.draft? || @poll.in_progress? %>
  <% if @poll.closed? %>
    <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
      <%= render "closed_result", result_summary: @result_summary %>
    </section>
  <% elsif @poll.stopped? %>
    <section class="space-y-2 rounded-md border border-stone-200 bg-white p-4">
      <h2 class="text-xl font-semibold">투표가 중단되었습니다.</h2>
      <p class="text-sm text-stone-600">중단된 투표는 다시 시작할 수 없습니다.</p>
    </section>
  <% else %>
    <%= render "progress", poll: @poll %>
  <% end %>
  <%= render "event_log", poll: @poll, poll_events: @poll_events unless @poll.draft? %>
  <% if @poll.draft? %>
    <%= render "readiness", poll: @poll, integrity_report: @integrity_report %>
  <% elsif @poll.in_progress? || @poll.closed? %>
    <%= render "integrity_report", poll: @poll, integrity_report: @integrity_report %>
  <% end %>
  <%= render "poll_participants", poll: @poll %>
</div>
<% end %>
