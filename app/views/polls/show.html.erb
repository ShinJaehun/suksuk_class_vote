<div class="space-y-6">
  <% if @poll.in_progress? %>
    <%= turbo_stream_from @poll, :operation_screen %>
  <% end %>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="space-y-2">
      <p><%= link_to "투표 목록으로 돌아가기", polls_path, class: "text-sm font-medium text-stone-600 underline" %></p>

      <h1 class="text-3xl font-semibold"><%= @poll.title %></h1>
    </div>

    <% if @poll.in_progress? %>
      <%= link_to "투표 화면 열기",
                  ballot_poll_path(@poll),
                  target: "_blank",
                  rel: "noopener",
                  class: "inline-flex rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  </div>

  <dl class="grid gap-4 rounded-md border border-stone-200 bg-white p-4 sm:grid-cols-4">
    <div class="space-y-1">
      <dt class="text-sm font-medium text-stone-500">활동 유형</dt>
      <dd class="font-medium"><%= @poll.activity_label %></dd>
    </div>

    <div class="space-y-1">
      <dt class="text-sm font-medium text-stone-500">상태</dt>
      <dd class="font-medium"><%= @poll.display_status %></dd>
    </div>

    <div class="space-y-1">
      <dt class="text-sm font-medium text-stone-500">참여자 그룹</dt>
      <dd class="font-medium"><%= @poll.voter_group_display_name || "-" %></dd>
    </div>

    <div class="space-y-1">
      <dt class="text-sm font-medium text-stone-500">학생 수</dt>
      <dd class="font-medium">
        <%= @poll.poll_participants.exists? ? @poll.poll_participants.count : @poll.readiness_voter_count %>명
      </dd>
    </div>
  </dl>

  <% if @poll.draft? %>
    <%= render "readiness", poll: @poll %>
  <% end %>

  <%= render "integrity_report", poll: @poll, integrity_report: @integrity_report %>
  <%= render "poll_options", poll: @poll unless @poll.closed? %>
  <% if @poll.closed? %>
    <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
      <%= render "closed_result", result_summary: @result_summary %>
    </section>
  <% else %>
    <%= render "progress", poll: @poll %>
  <% end %>
  <%= render "poll_participants", poll: @poll %>
  <%= render "event_log", poll: @poll, poll_events: @poll_events %>
</div>
