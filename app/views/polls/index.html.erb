<div class="flex items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold">내 투표</h1>

  <div class="flex items-center gap-3">
    <%= link_to "보관된 투표",
                archived_polls_path,
                class: "text-sm font-medium text-stone-700 underline" %>
    <% if policy(Poll).create? %>
      <%= link_to "새 투표",
                  new_poll_path,
                  class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  </div>
</div>

<% if @poll_sessions.any? || @assigned_election_sessions.any? %>
  <ul class="space-y-3">
    <% @poll_sessions.each do |poll_session| %>
      <% poll = poll_session.poll %>
      <% card_classes = poll.school_managed? ? "border-violet-200 bg-violet-50/60" : "border-stone-200 bg-white" %>
      <li class="rounded-md border p-4 <%= card_classes %>" data-school-managed-session="<%= poll.school_managed? %>">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-medium"><%= poll_session_display_title(poll_session) %></h2>
              <%= poll_badges(poll: poll, status_record: poll_session) %>
            </div>
            <% classroom_label = poll_session.classroom_name_snapshot.to_s.sub(/\A\d{4}학년도\s+/, "").presence || (poll_session.classroom&.grade.present? && poll_session.classroom&.class_label.present? ? "#{poll_session.classroom.grade}학년 #{poll_session.classroom.class_label}반" : nil) %>
            <% operator_name = poll_session.operator_name_snapshot.presence || poll_session.operator&.name.presence || poll_session.operator&.email %>
            <% participation_count = poll_session.poll_participants.count { |participant| participant.poll_participation&.completed? || participant.poll_participation&.abstained? } %>
            <p class="text-sm text-stone-700"><%= classroom_label %> (<%= participation_count %>명) 담당: <%= operator_name %></p>
            <% session_time_labels = poll_session_status_time_labels(poll_session).map { |label| label.sub(/\A(?:재투표|투표) /, "") } %>
            <% if session_time_labels.any? %>
              <p class="text-sm text-stone-600"><%= session_time_labels.join(" · ") %></p>
            <% end %>
          </div>

          <%= link_to "상세",
                      poll_poll_session_path(poll, poll_session),
                      class: "text-sm font-medium text-stone-700 underline" %>
        </div>
      </li>
    <% end %>

    <% @assigned_election_sessions.each do |election_session| %>
      <% display_status = { "draft" => "준비", "in_progress" => "진행", "closed" => "종료", "stopped" => "중단" }.fetch(election_session.status, election_session.status) %>
      <% status_class =
        if election_session.draft?
          "border-amber-200 bg-amber-50 text-amber-700"
        elsif election_session.in_progress?
          "border-emerald-200 bg-emerald-50 text-emerald-700"
        elsif election_session.closed?
          "border-stone-300 bg-stone-100 text-stone-700"
        elsif election_session.stopped?
          "border-rose-200 bg-rose-50 text-rose-700"
        else
          "border-stone-200 bg-stone-50 text-stone-700"
        end %>
      <li class="rounded-md border border-indigo-100 bg-indigo-50/30 p-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-medium"><%= election_session.election.title %></h2>
              <%= election_kind_badge(election_session.election) %>
              <span class="rounded-md border px-2 py-1 text-sm font-medium <%= status_class %>"><%= display_status %></span>
            </div>
            <p class="text-sm text-stone-600">
              <%= election_session_roster_label(
                    election_session,
                    voter_count: @election_session_voter_counts.fetch(election_session.id, 0)
                  ) %>
              <% session_time_labels = election_session_status_time_labels(election_session) %>
              <% if session_time_labels.any? %>
                / <%= session_time_labels.join(" · ") %>
              <% end %>
            </p>
          </div>

          <%= link_to "상세",
                      elections_session_path(election_session),
                      class: "text-sm font-medium text-stone-700 underline" %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="rounded-md border border-stone-200 bg-white p-4 text-stone-600">운영할 투표가 없습니다.</p>
<% end %>
