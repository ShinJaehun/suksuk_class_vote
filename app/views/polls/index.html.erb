<div class="flex items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold">투표</h1>

  <div class="flex items-center gap-3">
    <%= link_to "보관된 투표",
                archived_polls_path,
                class: "text-sm font-medium text-stone-700 underline" %>
    <%= link_to "새 투표",
                new_poll_path,
                class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  </div>
</div>

<% if @polls.any? || @assigned_election_sessions.any? %>
  <ul class="space-y-3">
    <% @polls.each do |poll| %>
      <li class="rounded-md border border-stone-200 bg-white p-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-medium"><%= poll.title %></h2>
              <% if poll.school_election_poll? %>
                <span class="rounded-full bg-sky-50 px-2 py-1 text-xs font-medium text-sky-700">전교학생회 선거</span>
              <% end %>
              <%= poll_activity_badge(poll) %>
              <%= poll_status_badge(poll) %>
            </div>
            <p class="text-sm text-stone-600">
              <%= poll.participant_group_display_name || "-" %>
              · 투표자 <%= @poll_voter_counts.fetch(poll.id, 0) %>명
            </p>
          </div>

          <%= link_to "상세",
                      poll_path(poll),
                      class: "text-sm font-medium text-stone-700 underline" %>
        </div>
      </li>
    <% end %>

    <% @assigned_election_sessions.each do |election_session| %>
      <% display_status = { "draft" => "시작 전", "in_progress" => "진행 중", "closed" => "종료됨", "stopped" => "중단됨" }.fetch(election_session.status, election_session.status) %>
      <li class="rounded-md border border-stone-200 bg-white p-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-medium"><%= election_session.election.title %></h2>
              <span class="rounded-full bg-sky-50 px-2 py-1 text-xs font-medium text-sky-700">선거</span>
              <span class="rounded-full bg-stone-100 px-2 py-1 text-xs font-medium text-stone-700"><%= display_status %></span>
            </div>
            <p class="text-sm text-stone-600">
              <%= election_session.participant_group&.name || "-" %>
              · 투표자 <%= @election_session_voter_counts.fetch(election_session.id, 0) %>명
            </p>
          </div>

          <%= link_to "상세",
                      elections_session_path(election_session),
                      class: "text-sm font-medium text-stone-700 underline" %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="rounded-md border border-stone-200 bg-white p-4 text-stone-600">아직 만든 투표가 없습니다.</p>
<% end %>
