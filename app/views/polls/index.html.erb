<div class="flex items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold">내 투표</h1>

  <div class="flex items-center gap-3">
    <%= link_to "보관된 투표",
                archived_polls_path,
                class: "text-sm font-medium text-stone-700 underline" %>
    <%= link_to "새 투표",
                new_poll_path,
                class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  </div>
</div>

<% if @polls.any? || @assigned_election_sessions.any? %>
  <ul class="space-y-3">
    <% @polls.each do |poll| %>
      <li class="rounded-md border border-stone-200 bg-white p-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-medium"><%= poll.title %></h2>
              <%= poll_activity_badge(poll) %>
              <%= poll_status_badge(poll) %>
            </div>
            <p class="text-sm text-stone-600">
              <% if poll.participant_group.present? %>
                <%= poll.participant_group_display_name || "-" %>(투표자 <%= @poll_voter_counts.fetch(poll.id, 0) %>명)
                <% if poll.poll_progress&.started_at.present? %>
                  / 투표시작 <%= kst_datetime(poll.poll_progress.started_at) %>
                  <% if poll.poll_progress.closed_at.present? %>
                    · 투표종료 <%= kst_datetime(poll.poll_progress.closed_at) %>
                  <% end %>
                <% end %>
              <% else %>
                재사용 가능한 투표 정의
              <% end %>
            </p>

            <% unless poll.participant_group.present? %>
              <% poll_sessions = poll.poll_sessions.sort_by(&:created_at) %>
              <% if poll_sessions.any? %>
                <ul class="mt-3 space-y-2">
                  <% poll_sessions.each do |poll_session| %>
                    <li class="rounded-md border border-stone-200 bg-stone-50 p-3 text-sm">
                      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                        <div class="space-y-1">
                          <p class="font-medium"><%= poll_session.classroom_name_snapshot %></p>
                          <p class="text-stone-600">
                            운영자 <%= poll_session.operator_name_snapshot %>
                            · 상태: <%= poll_session_status_label(poll_session) %>
                          </p>
                          <% if poll_session.in_progress? %>
                            <p class="font-medium text-emerald-700">투표 진행 중</p>
                          <% end %>
                        </div>

                        <% if poll_session.draft? && policy(poll_session).start? %>
                          <%= button_to "투표 시작",
                                        start_poll_poll_session_path(poll, poll_session),
                                        method: :post,
                                        data: {
                                          turbo_confirm: "이 학급의 현재 활성 학생 명단으로 투표를 시작합니다. 시작 후 명단은 snapshot으로 고정됩니다. 계속하시겠습니까?"
                                        },
                                        class: "rounded-md bg-stone-900 px-3 py-2 font-medium text-white" %>
                        <% end %>
                      </div>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <p class="mt-3 text-sm text-stone-600">학급 실행이 없습니다.</p>
              <% end %>
            <% end %>
          </div>

          <% if poll.participant_group.present? %>
            <%= link_to "상세",
                        poll_path(poll),
                        class: "text-sm font-medium text-stone-700 underline" %>
          <% else %>
            <span class="text-sm font-medium text-stone-600">학급별 실행</span>
          <% end %>
        </div>
      </li>
    <% end %>

    <% @assigned_election_sessions.each do |election_session| %>
      <% display_status = { "draft" => "준비", "in_progress" => "진행", "closed" => "종료", "stopped" => "중단" }.fetch(election_session.status, election_session.status) %>
      <% status_class =
        if election_session.draft?
          "border-amber-200 bg-amber-50 text-amber-700"
        elsif election_session.in_progress?
          "border-emerald-200 bg-emerald-50 text-emerald-700"
        elsif election_session.closed?
          "border-stone-300 bg-stone-100 text-stone-700"
        elsif election_session.stopped?
          "border-rose-200 bg-rose-50 text-rose-700"
        else
          "border-stone-200 bg-stone-50 text-stone-700"
        end %>
      <li class="rounded-md border border-indigo-100 bg-indigo-50/30 p-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-medium"><%= election_session.election.title %></h2>
              <%= election_kind_badge(election_session.election) %>
              <span class="rounded-md border px-2 py-1 text-sm font-medium <%= status_class %>"><%= display_status %></span>
            </div>
            <p class="text-sm text-stone-600">
              <%= election_session_roster_label(
                    election_session,
                    voter_count: @election_session_voter_counts.fetch(election_session.id, 0)
                  ) %>
              <% session_time_labels = election_session_status_time_labels(election_session) %>
              <% if session_time_labels.any? %>
                / <%= session_time_labels.join(" · ") %>
              <% end %>
            </p>
          </div>

          <%= link_to "상세",
                      elections_session_path(election_session),
                      class: "text-sm font-medium text-stone-700 underline" %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="rounded-md border border-stone-200 bg-white p-4 text-stone-600">아직 만든 투표가 없습니다.</p>
<% end %>
