<%= turbo_frame_tag dom_id(poll, :progress), class: "block" do %>
  <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
    <h2 class="text-xl font-semibold">투표 진행</h2>

    <% if poll.draft? %>
      <% if poll.school_election_poll? %>
        <p class="text-stone-600">전교학생회 선거 투표는 아직 일반 투표 화면에서 시작할 수 없습니다.</p>
      <% elsif poll.startable_by_configuration? %>
        <%= button_to "투표 시작",
                      start_poll_path(poll),
                      method: :post,
                      data: { turbo_frame: "_top" },
                      class: "rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
      <% else %>
        <p class="text-stone-600">투표를 시작할 수 없습니다.</p>
      <% end %>
    <% elsif poll.in_progress? %>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-stone-600">투표가 진행 중입니다.</p>
        <%= button_to "투표 중단",
                      stop_poll_path(poll),
                      method: :post,
                      data: { turbo_frame: "_top", turbo_confirm: "투표를 중단할까요? 중단된 투표는 다시 시작할 수 없습니다." },
                      class: "rounded-md bg-rose-600 px-4 py-2 text-sm font-medium text-white hover:bg-rose-700" %>
      </div>
      <% if poll.poll_progress.present? %>
        <% current_participant = poll.poll_progress.current_poll_participant %>
        <% if current_participant.present? %>
          <% current_participant_label = [("#{current_participant.number}번" if current_participant.number.present?), current_participant.name.presence].compact.join(" ").presence || "현재 투표자" %>
          <% participation = current_participant.poll_participation %>
          <% if participation.blank? && poll.poll_progress.ballot_open? %>
            <div class="rounded-md border border-stone-200 bg-stone-50 p-5">
              <p class="text-sm font-medium text-stone-500">현재 투표자</p>
              <p class="mt-2 text-3xl font-semibold text-stone-900"><%= current_participant_label %></p>
            </div>
          <% end %>
          <% if participation.present? %>
            <div class="rounded-md border border-stone-200 bg-white p-4">
              <% if participation.completed? || participation.abstained? %>
                <p class="text-lg font-medium text-stone-800"><%= current_participant_label %>은 투표를 완료했습니다.</p>
              <% elsif participation.absent? %>
                <p class="text-lg font-medium text-stone-800"><%= current_participant_label %>은 미참여 처리되었습니다.</p>
              <% end %>
              <% next_participant = poll.poll_participants.where("number > ?", current_participant.number).order(:number).first %>
              <% if next_participant.present? %>
                <% next_participant_label = [("#{next_participant.number}번" if next_participant.number.present?), next_participant.name.presence].compact.join(" ").presence || "다음 투표자" %>
                <div class="mt-4 flex flex-wrap gap-2">
                  <%= button_to "다음 투표자는 #{next_participant_label}입니다.",
                                advance_current_participant_poll_path(poll),
                                method: :post,
                                params: { current_poll_participant_id: current_participant.id },
                                data: { turbo_frame: "_top", turbo_submits_with: "여는 중..." },
                                class: "rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
                  <%= button_to "미참여 처리",
                                record_next_participant_absent_poll_path(poll),
                                method: :post,
                                params: { current_poll_participant_id: current_participant.id },
                                data: { turbo_frame: "_top", turbo_submits_with: "처리 중..." },
                                class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
                </div>
              <% else %>
                <%= button_to "투표 종료",
                              close_poll_path(poll),
                              method: :post,
                              params: { current_poll_participant_id: current_participant.id },
                              data: { turbo_frame: "_top", turbo_confirm: "투표를 종료할까요?", turbo_submits_with: "종료 중..." },
                              class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
              <% end %>
            </div>
          <% else %>
            <div class="space-y-3 rounded-md border border-stone-200 bg-white p-4">
              <% if poll.poll_progress.ballot_open? %>
                <p class="text-lg font-medium text-stone-800"><%= current_participant.name %> 학생이 투표중입니다.</p>
              <% else %>
                <p class="text-lg font-medium text-stone-800">투표를 시작합니다.</p>
                <div class="flex flex-wrap gap-2">
                  <%= button_to "다음 투표자는 #{current_participant_label}입니다.",
                                open_current_participant_ballot_poll_path(poll),
                                method: :post,
                                params: { current_poll_participant_id: current_participant.id },
                                data: { turbo_frame: "_top", turbo_submits_with: "여는 중..." },
                                class: "rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700" %>
                  <%= button_to "미참여 처리",
                                record_participation_outcome_poll_path(poll),
                                method: :post,
                                params: { status: "absent", current_poll_participant_id: current_participant.id },
                                data: { turbo_frame: "_top", turbo_submits_with: "처리 중..." },
                                class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p class="text-stone-600">현재 투표자를 찾을 수 없습니다.</p>
        <% end %>
      <% else %>
        <p class="text-stone-600">투표 진행 정보를 찾을 수 없습니다.</p>
      <% end %>
    <% end %>
  </section>
<% end %>
