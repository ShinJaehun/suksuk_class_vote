<div class="mx-auto max-w-3xl space-y-6">
  <%= link_to "내 투표 목록으로 돌아가기", polls_path, class: "text-sm font-medium text-stone-700 underline" %>
  <h1 class="text-2xl font-semibold">새 학급투표</h1>

  <% if @poll.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-4 text-red-800">
      <h2 class="font-medium">투표를 생성할 수 없습니다.</h2>
      <ul class="mt-2 list-disc pl-5 text-sm">
        <% @poll.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @classroom.blank? %>
    <div class="rounded-md border border-amber-200 bg-amber-50 p-4 text-amber-800">
      <p class="font-medium">활성 교실이 없어 학급투표를 만들 수 없습니다.</p>
    </div>
  <% elsif @active_students.empty? %>
    <div class="rounded-md border border-amber-200 bg-amber-50 p-4 text-amber-800">
      <p class="font-medium">활성 학생이 있는 교실을 먼저 준비해 주세요.</p>
    </div>
  <% else %>
    <section class="rounded-md border border-stone-200 bg-white p-4">
      <h2 class="font-semibold">대상 학급</h2>
      <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-3">
        <div>
          <dt class="text-stone-500">대상 학급</dt>
          <dd class="font-medium"><%= @classroom.grade %>학년 <%= @classroom.formatted_class_label %></dd>
        </div>
        <div>
          <dt class="text-stone-500">담당</dt>
          <dd class="font-medium"><%= @classroom.teacher&.name %></dd>
        </div>
        <div>
          <dt class="text-stone-500">현재 학생</dt>
          <dd class="font-medium"><%= @active_students.size %>명</dd>
        </div>
      </dl>
    </section>

    <%= form_with model: @poll, url: polls_path, class: "space-y-4 rounded-md border border-stone-200 bg-white p-4" do |form| %>
      <div class="space-y-1">
        <%= form.label :title, "투표 이름", class: "text-sm font-medium text-stone-700" %>
        <%= form.text_field :title, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
      </div>
      <%= render "poll_definitions/kind_selector", form: form, poll: @poll %>
      <%= form.submit "학급투표 초안 만들기", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  <% end %>
</div>
