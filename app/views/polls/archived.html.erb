<div class="space-y-6">
  <div class="flex items-center justify-between gap-4">
    <div class="space-y-1">
      <p><%= link_to "투표 목록으로 돌아가기", polls_path, class: "text-sm font-medium text-stone-600 underline" %></p>
      <h1 class="text-2xl font-semibold">보관된 투표</h1>
    </div>
  </div>

  <% if @polls.any? || @closed_election_sessions.any? %>
    <ul class="space-y-3">
      <% @polls.each do |poll| %>
        <li class="rounded-md border border-stone-200 bg-white p-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="font-medium"><%= poll.title %></h2>
                <%= poll_activity_badge(poll) %>
                <%= poll_status_badge(poll) %>
              </div>
              <p class="text-sm text-stone-600">
                <%= poll.participant_group_display_name || "-" %>
                · 투표자 <%= @poll_voter_counts.fetch(poll.id, 0) %>명
              </p>
            </div>

            <%= link_to "상세",
                        poll_path(poll),
                        class: "text-sm font-medium text-stone-700 underline" %>
          </div>
        </li>
      <% end %>

      <% @closed_election_sessions.each do |election_session| %>
        <li class="rounded-md border border-stone-200 bg-white p-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="font-medium"><%= election_session.election.title %></h2>
                <span class="rounded-full bg-sky-50 px-2 py-1 text-xs font-medium text-sky-700">선거</span>
                <span class="rounded-full bg-stone-100 px-2 py-1 text-xs font-medium text-stone-700">종료됨</span>
              </div>
              <p class="text-sm text-stone-600">
                <%= election_session.participant_group&.name || "-" %>
                · 종료 <%= election_session.closed_at || "기록 없음" %>
              </p>
            </div>

            <%= link_to "결과 보기",
                        elections_session_path(election_session),
                        class: "text-sm font-medium text-stone-700 underline" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="rounded-md border border-stone-200 bg-white p-4 text-stone-600">보관된 투표가 없습니다.</p>
  <% end %>
</div>
