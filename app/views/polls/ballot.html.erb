<% content_for :hide_navigation, true %>

<div class="mx-auto max-w-2xl space-y-6">
  <%= turbo_stream_from @poll, :ballot_screen %>

  <div class="space-y-2">
    <h1 class="text-3xl font-semibold"><%= @poll.title %></h1>
    <p class="text-stone-600">투표 화면</p>
  </div>

  <%= render "ballot_content", poll: @poll, current_poll_participant: @current_poll_participant %>
</div>
