<% content_for :hide_navigation, true %>

<div class="mx-auto max-w-2xl space-y-6">
  <div class="space-y-2">
    <h1 class="text-3xl font-semibold"><%= @poll.title %></h1>
    <p class="text-stone-600">투표 화면</p>
  </div>

  <% if @current_poll_participant.present? %>
    <section class="space-y-5 rounded-md border border-stone-200 bg-white p-5">
      <div class="rounded-md border border-stone-200 bg-stone-50 p-5">
        <p class="text-sm font-medium text-stone-500">현재 참여자</p>
        <p class="mt-2 text-4xl font-semibold"><%= @current_poll_participant.number %>번 <%= @current_poll_participant.name %></p>
      </div>

      <% if @current_poll_participant.poll_participation.present? %>
        <p class="text-stone-600">현재 참여자는 이미 처리되었습니다.</p>
        <% if @next_poll_participant.present? %>
          <%= button_to "다음 참여자는 #{@next_poll_participant.number}번 #{@next_poll_participant.name}입니다",
                        advance_current_participant_poll_path(@poll),
                        method: :post,
                        params: { return_to: "ballot" },
                        class: "rounded-md bg-stone-900 px-4 py-3 text-sm font-medium text-white" %>
        <% else %>
          <div class="rounded-md border border-stone-200 bg-stone-50 p-5">
            <p class="text-lg font-medium text-stone-800">모든 참여자가 처리되었습니다. 창을 닫아주세요.</p>
          </div>
        <% end %>
      <% else %>
        <div class="space-y-4">
          <h2 class="text-xl font-semibold"><%= @poll.choice_label %> 선택</h2>
          <div class="<%= @poll.election? ? "grid gap-3 sm:grid-cols-2" : "space-y-3" %>">
            <% @poll.poll_options.order(:number).each do |poll_option| %>
              <%= button_to "#{poll_option.number}번 #{poll_option.name}",
                            submit_vote_poll_path(@poll),
                            method: :post,
                            params: { poll_option_id: poll_option.id, return_to: "ballot" },
                            class: @poll.election? ? "rounded-md bg-stone-900 px-4 py-5 text-xl font-medium text-white" : "w-full rounded-md bg-stone-900 px-5 py-4 text-left text-lg font-medium text-white" %>
            <% end %>
          </div>

          <div class="border-t border-stone-200 pt-4">
            <div class="flex flex-wrap gap-2">
              <%= button_to "기권 처리",
                            record_participation_outcome_poll_path(@poll),
                            method: :post,
                            params: { status: "abstained", return_to: "ballot" },
                            class: "rounded-md border border-stone-300 px-4 py-3 text-sm font-medium text-stone-700" %>
              <%= button_to "미참여 처리",
                            record_participation_outcome_poll_path(@poll),
                            method: :post,
                            params: { status: "absent", return_to: "ballot" },
                            class: "rounded-md border border-stone-300 px-4 py-3 text-sm font-medium text-stone-700" %>
            </div>
          </div>
        </div>
      <% end %>
    </section>
  <% else %>
    <section class="rounded-md border border-stone-200 bg-white p-4">
      <p class="text-stone-600">현재 참여자를 찾을 수 없습니다.</p>
    </section>
  <% end %>
</div>
