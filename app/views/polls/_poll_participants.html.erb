<% participant_rows = poll.poll_participants.exists? ? poll.poll_participants.order(:number) : poll.participant_group&.participant_slots&.order(:number) %>

<section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
  <div class="space-y-1">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <h2 class="text-xl font-semibold"><%= poll.closed? ? "투표 당시 투표자 명단" : "투표자 명단" %></h2>
      <% if poll.draft? && poll.participant_group.present? %>
        <%= link_to "투표자 명단 수정",
                    participant_group_path(poll.participant_group, return_to_poll_id: poll.id),
                    class: "text-sm font-medium text-stone-700 underline" %>
      <% end %>
    </div>
    <p class="text-sm text-stone-600">
      <%= poll.participant_group_display_name || "선택된 투표자 명단이 없습니다." %>(투표자 <%= participant_rows&.size.to_i %>명)
    </p>
  </div>

  <% if participant_rows.present? %>
    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="border-b border-stone-200 text-stone-500">
        <tr>
          <th class="px-3 py-2 font-medium">번호</th>
          <th class="px-3 py-2 font-medium">이름</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% participant_rows.each do |participant| %>
            <tr>
              <td class="px-3 py-3"><%= participant.number %>번</td>
              <td class="px-3 py-3 font-medium"><%= participant.name %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-stone-600">표시할 투표자가 없습니다.</p>
  <% end %>
</section>
