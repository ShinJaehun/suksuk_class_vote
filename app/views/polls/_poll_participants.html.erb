<% if poll.poll_participants.exists? %>
  <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
    <h2 class="text-xl font-semibold"><%= poll.closed? ? "선거 당시 투표자 명단" : "선거용 명단" %></h2>

    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="border-b border-stone-200 text-stone-500">
        <tr>
          <th class="px-3 py-2 font-medium">번호</th>
          <th class="px-3 py-2 font-medium">이름</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% poll.poll_participants.order(:number).each do |poll_participant| %>
            <tr>
              <td class="px-3 py-3"><%= poll_participant.number %>번</td>
              <td class="px-3 py-3 font-medium"><%= poll_participant.name %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
