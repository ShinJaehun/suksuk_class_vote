<%= turbo_frame_tag dom_id(poll, :event_log), class: "block" do %>
  <section class="space-y-4 rounded-md border border-stone-200 bg-white p-4" data-testid="poll-event-log">
    <h2 class="text-xl font-semibold">운영 기록</h2>

    <% if poll_events.any? %>
      <ul class="divide-y divide-stone-200">
        <% poll_events.each do |event| %>
          <% target =
            if event.election_level_event?
              event.actor&.name.presence || event.actor&.email
            elsif event.voter_level_event? && event.poll_participant.present?
              "#{event.poll_participant.number}번 #{event.poll_participant.name}"
            end
          %>

          <li class="grid gap-2 py-4 text-base sm:grid-cols-[11rem_1fr_1fr]">
            <time class="text-stone-500" datetime="<%= event.occurred_at.iso8601 %>">
              <%= l(event.occurred_at, format: :short) %>
            </time>
            <span class="text-stone-600"><%= target %></span>
            <span class="font-medium"><%= event.display_label %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-stone-600">아직 운영 기록이 없습니다.</p>
    <% end %>
  </section>
<% end %>
