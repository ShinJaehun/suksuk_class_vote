<section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
  <% choice_label = poll.election? ? "후보자" : (poll.discussion? || poll.debate? ? "의견" : poll.choice_label.presence || "선택지") %>
  <% choice_subject_label = poll.election? ? "후보자는" : "#{choice_label}은" %>
  <% choice_unit = poll.election? ? "명" : "개" %>
  <% readiness_issues = [] %>
  <% readiness_issues << "투표자 명단을 선택해야 합니다." if poll.participant_group.blank? %>
  <% readiness_issues << "투표자가 1명 이상 필요합니다." if poll.participant_group.present? && poll.readiness_voter_count.zero? %>
  <% readiness_issues << "#{choice_subject_label} 2#{choice_unit} 이상이어야 합니다." if poll.readiness_poll_option_count < 2 %>
  <% readiness_ok = local_assigns[:integrity_report].present? ? integrity_report.ok? && readiness_issues.empty? : readiness_issues.empty? %>

  <% if local_assigns[:integrity_report].present? %>
    <div class="space-y-2">
      <% if readiness_ok %>
        <h2 class="text-lg font-semibold">상태 점검: 이상 없음</h2>
      <% else %>
        <h2 class="text-lg font-semibold">상태 점검: 확인 필요</h2>
      <% end %>

      <p class="text-sm text-stone-600">
        <%= poll.school_election_poll? ? "전교학생회 선거 투표는 아직 일반 투표 화면에서 시작할 수 없습니다." : (poll.startable_by_configuration? ? "투표를 시작할 수 있습니다." : "투표를 시작할 수 없습니다.") %>
      </p>

      <% unless readiness_ok %>
        <ul class="list-disc space-y-1 pl-5 text-sm text-stone-700">
          <% readiness_issues.each do |message| %>
            <li><%= message %></li>
          <% end %>
          <% integrity_report.issues.each do |issue| %>
            <li><%= issue.message %></li>
          <% end %>
        </ul>
      <% end %>

      <% if integrity_report.resumable_current_participant? %>
        <div class="space-y-2">
          <%= button_to "첫 미처리 투표자로 재개",
                        resume_current_participant_poll_path(poll),
                        method: :post,
                        class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
          <p class="text-sm text-stone-600">현재 투표자 정보가 비어 있을 때만 사용할 수 있습니다. 제출된 표 수와 참여 기록은 변경하지 않습니다.</p>
        </div>
      <% end %>
    </div>
  <% else %>
    <h2 class="text-lg font-semibold">준비 점검</h2>
  <% end %>

  <dl class="grid gap-2 text-sm sm:grid-cols-3">
    <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
      <dt class="text-stone-500">투표자</dt>
      <dd class="mt-1 font-semibold"><%= poll.readiness_voter_count %>명</dd>
    </div>

    <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
      <dt class="text-stone-500"><%= choice_label %></dt>
      <dd class="mt-1 font-semibold"><%= poll.readiness_poll_option_count %><%= choice_unit %></dd>
    </div>

    <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
      <dt class="text-stone-500">시작 가능 여부</dt>
      <dd class="mt-1 font-semibold"><%= poll.school_election_poll? ? "운영 준비 중" : (poll.startable_by_configuration? ? "시작 가능" : "시작 불가") %></dd>
    </div>
  </dl>
</section>
