<section class="space-y-4 rounded-md border border-stone-200 bg-white p-4">
  <% if local_assigns[:integrity_report].present? %>
    <div class="space-y-2">
      <% if integrity_report.ok? %>
        <h2 class="text-lg font-semibold">상태 점검: 이상 없음</h2>
      <% else %>
        <h2 class="text-lg font-semibold">상태 점검: 확인 필요</h2>
        <ul class="list-disc space-y-1 pl-5 text-sm text-stone-700">
          <% integrity_report.issues.each do |issue| %>
            <li><%= issue.message %></li>
          <% end %>
        </ul>
      <% end %>

      <% if integrity_report.guidance_message.present? %>
        <p class="text-sm text-stone-600"><%= integrity_report.guidance_message %></p>
      <% end %>

      <% if integrity_report.resumable_current_participant? %>
        <div class="space-y-2">
          <%= button_to "첫 미처리 투표자로 재개",
                        resume_current_participant_poll_path(poll),
                        method: :post,
                        class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
          <p class="text-sm text-stone-600">현재 투표자 정보가 비어 있을 때만 사용할 수 있습니다. 제출된 표 수와 참여 기록은 변경하지 않습니다.</p>
        </div>
      <% end %>
    </div>
  <% else %>
    <h2 class="text-lg font-semibold">준비 점검</h2>
  <% end %>

  <dl class="grid gap-3 text-sm sm:grid-cols-3">
    <div>
      <dt class="font-medium text-stone-500">투표자</dt>
      <dd class="mt-1 font-semibold"><%= poll.readiness_voter_count %>명</dd>
    </div>

    <div>
      <dt class="font-medium text-stone-500">후보자</dt>
      <dd class="mt-1 font-semibold"><%= poll.readiness_poll_option_count %>명</dd>
    </div>

    <div>
      <dt class="font-medium text-stone-500">시작 가능 여부</dt>
      <dd class="mt-1 font-semibold"><%= poll.startable_by_configuration? ? "시작 가능" : "시작 불가" %></dd>
    </div>
  </dl>
</section>
