<section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm" data-testid="poll-session-candidates">
  <%= turbo_frame_tag "school_poll_modal" %>
  <div class="flex items-center justify-between gap-3">
    <h2 class="text-lg font-semibold"><%= poll_session.poll.contest_label %> 관리</h2>
    <%= link_to "#{poll_session.poll.contest_label} 추가",
                new_poll_poll_session_contest_path(poll_session.poll, poll_session),
                data: { turbo_frame: "school_poll_modal" },
                class: "rounded-md bg-stone-900 px-3 py-2 text-sm font-medium text-white" %>
  </div>

  <%= turbo_frame_tag dom_id(poll_session, :contest_list), class: "mt-4 block space-y-5" do %>
    <% visible_contests = poll_session.poll.poll_contests.reject { |contest| contest == poll_session.poll.automatic_empty_default_contest } %>
    <% visible_contests.sort_by { |contest| [contest.position, contest.id] }.each do |contest| %>
      <%= render "poll_sessions/contest_card", poll_session: poll_session, contest: contest %>
    <% end %>
  <% end %>

</section>
