<header data-testid="poll-session-header">
  <%= link_to "내 투표 목록으로 돌아가기",
              polls_path,
              data: { turbo_frame: "_top" },
              class: "text-sm font-medium text-stone-700 underline" %>
  <h1 class="mt-3 text-2xl font-semibold">투표 결과</h1>
  <p class="mt-1 text-lg font-medium"><%= @poll_session.poll.title %></p>
  <p class="mt-2 text-sm font-medium text-stone-600"><%= poll_session_status_label(@poll_session) %></p>
</header>

<section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm"
         data-testid="poll-session-closed-summary">
  <h2 class="text-lg font-semibold">세션 정보</h2>
  <dl class="mt-4 grid gap-4 sm:grid-cols-2">
    <div>
      <dt class="text-sm text-stone-500">학급</dt>
      <dd class="font-medium"><%= @poll_session.classroom_name_snapshot %></dd>
    </div>
    <div>
      <dt class="text-sm text-stone-500">운영자</dt>
      <dd class="font-medium"><%= @poll_session.operator_name_snapshot %></dd>
    </div>
    <div>
      <dt class="text-sm text-stone-500">상태</dt>
      <dd class="font-medium"><%= poll_session_status_label(@poll_session) %></dd>
    </div>
    <div>
      <dt class="text-sm text-stone-500">시작 시각</dt>
      <dd class="font-medium">
        <%= @poll_session.started_at.present? ? kst_datetime(@poll_session.started_at) : "기록 없음" %>
      </dd>
    </div>
    <div>
      <dt class="text-sm text-stone-500">종료 시각</dt>
      <dd class="font-medium">
        <%= @poll_session.closed_at.present? ? kst_datetime(@poll_session.closed_at) : "기록 없음" %>
      </dd>
    </div>
  </dl>

  <div class="mt-6 grid gap-3 sm:grid-cols-5">
    <% {
         "전체 인원" => @total_count,
         "투표 완료" => @completed_count,
         "미참여" => @absent_count,
         "기권" => @abstained_count,
         "대기" => @pending_count
       }.each do |label, count| %>
      <div class="rounded-md bg-stone-50 p-4 text-center">
        <p class="text-sm text-stone-500"><%= label %></p>
        <p class="mt-1 text-2xl font-semibold"><%= count %>명</p>
      </div>
    <% end %>
  </div>
</section>

<section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm"
         data-testid="poll-session-results">
  <h2 class="text-lg font-semibold">학급 선거 결과</h2>

  <div class="mt-5 space-y-8">
    <% @contest_results.each do |result| %>
      <section>
        <h3 class="text-base font-semibold"><%= result[:contest].title %></h3>

        <% if result[:tally_complete] %>
          <% if result[:winners].empty? %>
            <p class="mt-2 text-sm text-stone-600">득표 기록이 없습니다.</p>
          <% else %>
            <% winner_label = result[:winners].one? ? "최다 득표 후보" : "공동 최다 득표 후보" %>
            <p class="mt-2 text-sm font-medium text-stone-700">
              <%= winner_label %>:
              <%= result[:winners].map { |option| "#{option.number}번 #{option.name}" }.join(", ") %>
            </p>
          <% end %>

          <div class="mt-4 overflow-x-auto">
            <table class="min-w-full divide-y divide-stone-200 text-sm">
              <thead>
                <tr class="text-left text-stone-500">
                  <th class="py-2 pr-4 font-medium">기호</th>
                  <th class="py-2 pr-4 font-medium">후보자</th>
                  <th class="py-2 font-medium">득표수</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-stone-100">
                <% result[:option_results].each do |option_result| %>
                  <tr>
                    <td class="py-3 pr-4"><%= option_result[:option].number %>번</td>
                    <td class="py-3 pr-4 font-medium"><%= option_result[:option].name %></td>
                    <td class="py-3"><%= option_result[:tally].votes_count %>표</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <p class="mt-3 text-sm text-stone-600">
            기권: <%= result[:contest_tally].abstentions_count %>표
          </p>
        <% else %>
          <p class="mt-3 text-sm text-amber-700">이 투표 세션의 집계 정보를 확인할 수 없습니다.</p>
        <% end %>
      </section>
    <% end %>
  </div>
</section>

<section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm"
         data-testid="poll-session-integrity-report">
  <% if @integrity_issues.empty? %>
    <h2 class="text-lg font-semibold">상태 점검: 이상 없음</h2>
    <p class="mt-2 text-sm text-stone-600">종료된 투표의 결과 상태가 정상입니다.</p>
  <% else %>
    <h2 class="text-lg font-semibold">상태 점검: 확인 필요</h2>
    <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-amber-700">
      <% @integrity_issues.each do |issue| %>
        <li><%= issue %></li>
      <% end %>
    </ul>
  <% end %>

  <dl class="mt-5 grid gap-3 sm:grid-cols-5">
    <% {
         "전체 투표자" => @total_count,
         "투표 완료" => @completed_count,
         "미참여" => @absent_count,
         "기권" => @abstained_count,
         "대기" => @pending_count
       }.each do |label, count| %>
      <div class="rounded-md bg-stone-50 p-3 text-center">
        <dt class="text-sm text-stone-500"><%= label %></dt>
        <dd class="mt-1 font-semibold"><%= count %>명</dd>
      </div>
    <% end %>
  </dl>
</section>

<section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm"
         data-testid="poll-session-roster">
  <h2 class="text-lg font-semibold">투표자 명단</h2>
  <p class="mt-2 text-sm text-stone-600">투표 시작 당시 확정된 투표자 명단입니다.</p>

  <% if @participants.any? %>
    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full divide-y divide-stone-200 text-sm">
        <thead>
          <tr class="text-left text-stone-500">
            <th class="py-2 pr-4 font-medium">번호</th>
            <th class="py-2 pr-4 font-medium">이름</th>
            <th class="py-2 font-medium">처리 상태</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% @participants.each do |participant| %>
            <tr>
              <td class="py-3 pr-4"><%= participant.number %>번</td>
              <td class="py-3 pr-4 font-medium"><%= participant.name %></td>
              <td class="py-3 text-stone-600">
                <%= poll_participation_status_label(participant.poll_participation) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-4 text-stone-600">투표자 명단이 없습니다.</p>
  <% end %>
</section>

<%= render "poll_sessions/event_log", poll_events: @poll_events %>
