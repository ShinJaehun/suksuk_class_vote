<% vote_date = @poll_session.closed_at&.in_time_zone("Asia/Seoul")&.strftime("%-m/%-d") || "-" %>
<section class="poll-session-result-print-area space-y-5 rounded-md border border-stone-200 bg-white p-4"
         data-testid="poll-session-printable-results">
  <header class="space-y-2">
    <h2 class="text-2xl font-semibold text-stone-900"><%= @poll_session.poll.title %> 투표 결과</h2>
    <p class="text-lg font-semibold text-stone-700">
      <%= @poll_session.classroom_name_snapshot %> · <%= vote_date %> 시행
    </p>
  </header>

  <dl class="grid gap-2 text-sm sm:grid-cols-3">
    <% {
         "투표 대상자" => @total_count,
         "투표 완료" => @completed_count + @abstained_count,
         "미참여" => @absent_count
       }.each do |label, count| %>
      <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
        <dt class="text-stone-500"><%= label %></dt>
        <dd class="mt-1 font-semibold text-stone-900"><%= count %>명</dd>
      </div>
    <% end %>
  </dl>

  <div class="poll-session-result-print-contests grid gap-3 lg:grid-cols-2">
    <% @contest_results.each do |result| %>
      <article class="rounded-md border border-stone-200 p-3">
        <h3 class="font-semibold"><%= result[:contest].title %></h3>
        <% if result[:tally_complete] %>
          <% if result[:contest].referendum? %><p class="mt-2 font-medium"><%= result[:option_results].first[:option].name %></p><% end %>
          <div class="poll-session-result-print-options mt-3 grid gap-2 sm:grid-cols-2">
            <% result[:option_results].each do |option_result| %>
              <div class="rounded-md bg-stone-50 px-2 py-1 text-sm" data-testid="printable-option-result">
                <% unless result[:contest].referendum? %><p class="text-xs text-stone-500"><%= @poll_session.poll.choice_number_label %> <%= option_result[:option].number %>번</p><% end %>
                <div class="mt-0.5 grid grid-cols-[minmax(0,1fr)_max-content] gap-2">
                  <span class="break-words"><%= result[:contest].referendum? ? "찬성" : option_result[:option].name %></span>
                  <strong class="whitespace-nowrap"><%= option_result[:votes_count] %>표</strong>
                </div>
              </div>
            <% end %>
          </div>
          <% if result[:contest].referendum? %><p class="mt-2 text-sm">반대 <%= result[:rejections_count] %>표</p><% end %>
          <% if !result[:contest].referendum? || result[:abstentions_count].to_i.positive? %><p class="mt-2 text-sm">기권 <%= result[:abstentions_count] %>표</p><% end %>
        <% else %>
          <p class="mt-2 text-sm">이 투표 세션의 집계 정보를 확인할 수 없습니다.</p>
        <% end %>
      </article>
    <% end %>
  </div>
</section>
