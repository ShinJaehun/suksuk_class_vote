<% content_for :hide_navigation, true %>
<% schoolwide_election_ballot = @poll_session.poll.school_managed? && @poll_session.poll.election? %>
<% content_for :ballot_screen_layout, true if schoolwide_election_ballot %>

<%= turbo_stream_from @poll_session, :ballot_screen %>

<div class="<%= schoolwide_election_ballot ? "w-full space-y-3" : "mx-auto max-w-2xl space-y-6" %>"
     data-controller="poll-session-ballot-screen"
     data-poll-session-ballot-screen-close-url-value="<%= close_ballot_screen_poll_poll_session_path(
       @poll_session.poll,
       @poll_session
     ) %>">
  <% if schoolwide_election_ballot %>
    <header class="mx-auto flex max-w-6xl items-end justify-between gap-4 rounded-md border border-stone-200 bg-white px-3 py-2">
      <section>
        <p class="text-sm font-medium text-stone-600">학생 투표 화면</p>
        <h1 class="text-3xl font-semibold text-stone-900"><%= @poll_session.poll.title %></h1>
      </section>
      <section class="shrink-0 text-right">
        <p class="text-xs font-medium text-stone-600">현재 투표자</p>
        <p class="text-2xl font-semibold text-stone-900">
          <% if @current_participant %>
            <%= @current_participant.number %>번 <%= @current_participant.name %>
          <% end %>
        </p>
      </section>
    </header>
  <% else %>
    <div class="space-y-2">
      <h1 class="text-3xl font-semibold"><%= @poll_session.poll.title %></h1>
      <p class="text-stone-600">학생 투표 화면</p>
    </div>
  <% end %>

  <%= render "ballot_content",
             poll_session: @poll_session,
             progress: @poll_session.poll_progress,
             current_participant: @current_participant %>
</div>
