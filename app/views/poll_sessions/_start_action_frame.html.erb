<%= turbo_frame_tag dom_id(poll_session, :start_action) do %>
  <% parent_allows_start = !poll_session.poll.school_managed? || poll_session.poll.in_progress? %>
  <% if parent_allows_start && status_check.startable? && policy(poll_session).operate? %>
    <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
      <p class="font-medium text-stone-700">투표를 시작할 수 있습니다.</p>
      <%= button_to "투표 시작",
                    start_poll_poll_session_path(poll_session.poll, poll_session),
                    method: :post,
                    form: {
                      data: {
                        turbo_frame: dom_id(poll_session, :teacher_progress)
                      }
                    },
                    data: {
                      turbo_confirm: poll_session.replacement? ?
                        "현재 투표자 명단으로 투표를 시작할까요?" :
                        "현재 활성 학생 명단으로 투표를 시작할까요?"
                    },
                    class: "mt-5 rounded-md bg-stone-900 px-5 py-3 text-sm font-medium text-white" %>
    </section>
  <% end %>
<% end %>
