<section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm"
         data-testid="poll-session-event-log">
  <h2 class="text-lg font-semibold">투표 진행 상황</h2>

  <% if poll_events.any? %>
    <ul class="mt-4 divide-y divide-stone-200">
      <% poll_events.each do |event| %>
        <li class="grid gap-2 py-4 sm:grid-cols-[11rem_1fr_1fr]">
          <time class="text-sm text-stone-500" datetime="<%= event.occurred_at.iso8601 %>">
            <%= kst_datetime(event.occurred_at) %>
          </time>
          <span class="text-stone-600"><%= poll_session_event_target_label(event) %></span>
          <span class="font-medium"><%= poll_session_event_description(event) %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-sm text-stone-600">아직 투표 진행 상황이 없습니다.</p>
  <% end %>
</section>
