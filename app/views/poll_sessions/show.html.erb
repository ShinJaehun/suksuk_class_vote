<% polling_data = if @poll_session.in_progress?
                    {
                      controller: "poll-session-progress",
                      poll_session_progress_interval_value: 2500,
                      poll_session_progress_url_value: poll_poll_session_path(
                        @poll_session.poll,
                        @poll_session
                      )
                    }
                  else
                    {}
                  end %>
<%= turbo_frame_tag dom_id(@poll_session, :teacher_progress), data: polling_data do %>
  <div class="mx-auto max-w-5xl space-y-6">
    <% if @poll_session.in_progress? %>
      <%= turbo_stream_from @poll_session, :operation_screen %>
      <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
              data-testid="poll-session-header">
        <div>
          <%= link_to "내 투표 목록으로 돌아가기",
                      polls_path,
                      data: { turbo_frame: "_top" },
                      class: "text-sm font-medium text-stone-700 underline" %>
          <h1 class="mt-3 text-2xl font-semibold">투표 운영 현황</h1>
          <p class="mt-1 text-lg font-medium"><%= @poll_session.poll.title %></p>
          <p class="mt-2 text-sm text-stone-600">
            <%= @poll_session.classroom_name_snapshot %>
            · 담당 교사: <%= @poll_session.operator_name_snapshot %>
            · <%= poll_session_status_label(@poll_session) %>
          </p>
        </div>

        <% if @poll_session.archived_at.blank? &&
              @current_participant.present? &&
              @status_check.progress_valid? &&
              policy(@poll_session).operate? %>
          <div data-controller="ballot-window"
               data-testid="poll-session-ballot-window"
               data-ballot-window-name-value="poll_session_<%= @poll_session.id %>_ballot">
            <%= link_to "학생 투표 화면 열기",
                        ballot_poll_poll_session_path(@poll_session.poll, @poll_session),
                        target: "poll_session_#{@poll_session.id}_ballot",
                        data: {
                          turbo: false,
                          action: "click->ballot-window#open"
                        },
                        class: "inline-flex rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
          </div>
        <% end %>
      </header>

      <%= render "operation",
                 poll_session: @poll_session,
                 current_participant: @current_participant,
                 current_participation: @current_participation,
                 next_pending_participant: @next_pending_participant,
                 pending_participants: @pending_participants,
                 poll_events: @poll_events,
                 can_operate: policy(@poll_session).operate?,
                 status_check: @status_check %>
    <% elsif @poll_session.draft? %>
      <header data-testid="poll-session-header">
        <%= link_to "내 투표 목록으로 돌아가기",
                    polls_path,
                    data: { turbo_frame: "_top" },
                    class: "text-sm font-medium text-stone-700 underline" %>
        <h1 class="mt-3 text-2xl font-semibold">투표 운영 현황</h1>
        <p class="mt-1 text-lg font-medium"><%= @poll_session.poll.title %></p>
        <% if @poll_session.poll.school_managed? %>
          <p class="mt-1 text-sm font-medium text-stone-600">전교투표 학급 운영</p>
        <% end %>
        <p class="mt-1 text-sm text-stone-600"><%= @poll_session.poll.activity_label %></p>
        <p class="mt-2 text-sm text-stone-600">
          <%= @poll_session.classroom_name_snapshot %>
          · 담당 교사: <%= @poll_session.operator_name_snapshot %>
          · <%= poll_session_status_label(@poll_session) %>
        </p>
      </header>

      <% if @poll_session.poll.school_managed? && @poll_session.poll.draft? %>
        <section class="rounded-md border border-amber-200 bg-amber-50 p-4 text-amber-800"
                 data-testid="poll-session-status-check">
          <h2 class="font-semibold">상태 점검: 시작 대기</h2>
          <p class="mt-2 text-sm">전교투표가 시작되면 이 학급 투표를 시작할 수 있습니다.</p>
        </section>
      <% else %>
        <%= render "poll_sessions/status_check", status_check: @status_check %>
      <% end %>

      <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm"
               data-testid="poll-session-candidates">
        <h2 class="text-lg font-semibold"><%= @poll_session.poll.choice_label %></h2>
        <div class="mt-4 space-y-5">
          <% @poll_session.poll.poll_contests.sort_by { |contest| [contest.position, contest.id] }.each do |contest| %>
            <div>
              <h3 class="font-semibold"><%= contest.title %></h3>
              <ul class="mt-2 space-y-1 text-stone-700">
                <% contest.poll_options.sort_by { |option| [option.number, option.id] }.each do |option| %>
                  <li><%= @poll_session.poll.choice_number_label %> <%= option.number %>번 <%= option.name %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      </section>

      <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm"
               data-testid="poll-session-roster">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-lg font-semibold">투표자 명단</h2>
          <span class="text-sm text-stone-600">전체 <%= @active_students.size %>명</span>
        </div>
        <% if @active_students.any? %>
          <ul class="mt-4 divide-y divide-stone-200">
            <% @active_students.each do |student| %>
              <li class="flex gap-4 py-3">
                <span class="w-16 font-medium"><%= student.number %>번</span>
                <span><%= student.name %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-4 text-stone-600">투표 대상 학생이 없습니다.</p>
        <% end %>
      </section>
      <% parent_allows_start = !@poll_session.poll.school_managed? || @poll_session.poll.in_progress? %>
      <% if parent_allows_start && @status_check.startable? && policy(@poll_session).operate? %>
        <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
          <p class="font-medium text-stone-700">투표를 시작할 수 있습니다.</p>
          <%= button_to "투표 시작",
                        start_poll_poll_session_path(@poll_session.poll, @poll_session),
                        method: :post,
                        data: {
                          turbo_confirm: "현재 활성 학생 명단으로 투표를 시작할까요?"
                        },
                        class: "mt-5 rounded-md bg-stone-900 px-5 py-3 text-sm font-medium text-white" %>
        </section>
      <% end %>
      <%= render "event_log", poll_events: @poll_events %>
    <% elsif @poll_session.closed? %>
      <%= render "poll_sessions/closed_summary" %>
    <% else %>
      <header>
        <%= link_to "내 투표 목록으로 돌아가기",
                    polls_path,
                    data: { turbo_frame: "_top" },
                    class: "text-sm font-medium text-stone-700 underline" %>
        <h1 class="mt-3 text-2xl font-semibold">투표 운영 현황</h1>
        <p class="mt-1 text-lg font-medium"><%= @poll_session.poll.title %></p>
        <p class="mt-2 text-sm font-medium text-stone-600"><%= poll_session_status_label(@poll_session) %></p>
      </header>
    <% end %>
  </div>
<% end %>
