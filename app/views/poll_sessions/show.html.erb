<%= turbo_stream_from @poll_session, :operation_screen if @poll_session.in_progress? && policy(@poll_session).operate? %>
<% if @poll_session.poll.school_managed? && @poll_session.draft? %>
  <div data-controller="poll-session-recovery"
       data-poll-session-recovery-interval-value="10000"
       data-poll-session-recovery-target-id-value="<%= dom_id(@poll_session, :status_check) %>"
       data-poll-session-recovery-url-value="<%= runtime_recovery_poll_poll_session_path(
         @poll_session.poll,
         @poll_session,
         presentation: :teacher,
         recovery_token: poll_session_recovery_token(@poll_session)
       ) %>"></div>
<% end %>
<div class="contents">
  <div class="mx-auto max-w-5xl space-y-6">
    <% visible_voters = @poll_session.draft? && !@poll_session.replacement? ? @active_students : @participants %>

    <div class="flex flex-wrap items-center justify-between gap-3">
      <%= link_to poll_session_back_label(@poll_session, from: params[:from]),
                  poll_session_back_path(@poll_session, from: params[:from]),
                  data: { turbo_frame: "_top" },
                  class: "text-sm font-medium text-stone-700 underline" %>
      <% if @poll_session.closed? && !@poll_session.poll.school_managed? && policy(@poll_session).archive_poll? %>
        <%= button_to "보관", archive_poll_path(@poll_session.poll), method: :post,
                      form: { data: { turbo_frame: "_top" } },
                      data: { turbo_confirm: "종료된 투표와 모든 실행 이력을 보관할까요?" },
                      class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-semibold text-white" %>
      <% end %>
    </div>

    <section class="space-y-4 rounded-xl border border-stone-200 bg-white p-6 shadow-sm"
             data-testid="poll-session-header">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-3xl font-semibold"><%= poll_session_display_title(@poll_session) %></h1>
          <%= poll_badges(poll: @poll_session.poll, status_record: @poll_session) %>
        </div>
        <% if (!@poll_session.poll.school_managed? && policy(@poll_session).show?) || @poll_session.closed? %>
          <div class="flex flex-wrap gap-2">
            <% unless @poll_session.poll.school_managed? %>
              <%= link_to "투표 설정", edit_poll_path(@poll_session.poll),
                          data: { turbo_frame: "_top" },
                          class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
            <% end %>
            <% if @poll_session.closed? %>
              <%= link_to "결과 집계 보기",
                          results_poll_poll_session_path(
                            @poll_session.poll,
                            @poll_session,
                            poll_session_context_params(@poll_session, from: params[:from])
                          ),
                          data: { turbo_frame: "_top" },
                          class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
            <% end %>
          </div>
        <% end %>
      </div>
      <dl class="grid gap-3 sm:grid-cols-3">
        <% {
             "대상 학급" => poll_session_classroom_label(@poll_session),
             "담당" => @poll_session.operator_name_snapshot,
             "전체 투표자" => "#{@completed_count + @abstained_count}명 / #{visible_voters.size}명"
           }.each do |label, value| %>
          <div class="rounded-md border border-stone-200 bg-stone-50 p-3">
            <dt class="text-xs font-medium text-stone-500"><%= label %></dt>
            <dd class="mt-1 font-semibold"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </section>

    <% unless @poll_session.in_progress? %>
      <%= render "poll_sessions/status_check_frame",
                 poll_session: @poll_session,
                 status_check: @status_check,
                 can_operate: @can_operate,
                 can_stop: @can_stop,
                 can_revote: @can_revote,
                 navigation_context: params[:from] %>
    <% end %>

    <% unless @poll_session.in_progress? %>
      <% if policy(@poll_session).edit_definition? %>
        <%= render "poll_sessions/definition_management", poll_session: @poll_session %>
      <% else %>
        <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm"
                data-testid="poll-session-candidates">
          <h2 class="text-lg font-semibold"><%= @poll_session.poll.contest_label %> 관리</h2>
          <div class="mt-4 space-y-5">
            <% visible_contests = @poll_session.poll.poll_contests.reject { |contest| contest == @poll_session.poll.automatic_empty_default_contest } %>
            <% visible_contests.sort_by { |contest| [contest.position, contest.id] }.each do |contest| %>
              <article class="rounded-md border border-stone-200 p-4">
                <h3 class="font-semibold"><%= contest.position %>. <%= contest.title %></h3>
                <div class="mt-3 <%= @poll_session.poll.election? ? "grid gap-3 sm:grid-cols-2" : "space-y-1" %>">
                  <% contest.poll_options.sort_by { |option| [option.number, option.id] }.each do |option| %>
                    <div class="flex items-center gap-3 py-1">
                    <% if @poll_session.poll.school_managed? && @poll_session.poll.election? %>
                        <%= image_tag poll_option_photo_source(option, variant: :thumbnail),
                                      alt: option.photo.attached? ? "#{option.name} 후보 사진" : "",
                                      class: "h-12 w-12 rounded-md object-contain" %>
                      <% end %>
                      <span><%= @poll_session.poll.choice_number_label %> <%= option.number %>번 · <%= option.name %></span>
                    </div>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>

      <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm"
              data-testid="poll-session-roster">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-semibold">투표자 명단</h2>
          <div class="flex items-center gap-3">
            <span class="text-sm text-stone-600">전체 <%= visible_voters.size %>명</span>
            <% if policy(@poll_session).edit_replacement_roster? %>
              <%= link_to "투표자 명단 수정", edit_poll_poll_session_roster_path(@poll_session.poll, @poll_session),
                          data: { turbo_frame: "_top" },
                          class: "rounded-md border border-stone-300 px-3 py-2 text-sm font-medium" %>
            <% elsif @poll_session.draft? && !@poll_session.replacement? && policy(@poll_session.classroom).manage_students? %>
              <%= link_to "투표자 명단 수정",
                          classroom_students_path(@poll_session.classroom,
                            return_poll_session_id: @poll_session.id),
                          data: { turbo_frame: "_top" },
                          class: "rounded-md border border-stone-300 px-3 py-2 text-sm font-medium" %>
            <% end %>
          </div>
        </div>
        <% if @poll_session.draft? && !@poll_session.replacement? %>
          <p class="mt-2 text-sm text-stone-600">투표를 시작할 때 이 학급의 활성 학생 명단이 투표자로 확정됩니다.</p>
        <% end %>
        <% if visible_voters.any? %>
          <% voter_columns = visible_voters.each_slice((visible_voters.size / 2.0).ceil).to_a %>
          <div class="mt-4 grid gap-x-8 sm:grid-cols-2">
            <% voter_columns.each do |voters| %>
              <ul>
                <% voters.each do |voter| %>
                  <li class="flex gap-3 border-b border-stone-100 py-2">
                    <span class="w-14 font-medium"><%= voter.number %>번</span>
                    <span><%= voter.name %></span>
                    <% if @poll_session.closed? %>
                      <span class="text-sm text-stone-500">· <%= poll_participation_status_label(voter.poll_participation) %></span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>
        <% else %>
          <p class="mt-4 text-stone-600">투표 대상 학생이 없습니다.</p>
        <% end %>
      </section>
    <% end %>

    <% if @poll_session.started_at.present? %>
      <% if @poll_session.in_progress? %>
        <%= render "teacher_progress",
                   poll_session: @poll_session,
                   status_check: @status_check,
                   current_participant: @current_participant,
                   current_participation: @current_participation,
                   next_pending_participant: @next_pending_participant,
                   pending_participants: @pending_participants,
                   can_operate: @can_operate,
                   can_stop: @can_stop,
                   can_revote: @can_revote,
                   navigation_context: params[:from] %>
      <% end %>
      <%= render "event_log", poll_session: @poll_session, poll_events: @poll_events %>
    <% end %>
  </div>
</div>
