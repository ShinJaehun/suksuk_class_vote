<%= form_with model: contest, url: form_url, data: { turbo_stream: true }, class: "rounded-md border border-stone-200 bg-stone-50 p-4" do |form| %>
  <% if contest.errors.any? %>
    <ul class="mb-3 list-disc pl-5 text-sm text-red-700">
      <% contest.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
    <div class="flex-1">
      <%= form.label :title, "#{poll_session.poll.contest_label} 이름", class: "block text-sm font-medium" %>
      <%= form.text_field :title, class: "mt-1 w-full rounded-md border-stone-300" %>
    </div>
    <div class="flex gap-3">
      <%= form.submit submit_label, class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
      <%= link_to "취소", cancel_path, data: { turbo_frame: frame_id }, class: "px-2 py-2 text-sm underline" %>
    </div>
  </div>
<% end %>
