<%= turbo_frame_tag frame_id do %>
  <% if presentation == :teacher %>
    <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm"
             data-testid="poll-session-status-check"
             data-poll-session-terminal>
      <h2 class="text-xl font-semibold">상태점검</h2>
      <p class="mt-4 font-medium text-rose-700"><%= message %></p>
      <%= link_to "내 투표 목록으로 돌아가기", polls_path,
                  data: { turbo_frame: "_top" },
                  class: "mt-2 inline-block text-sm font-medium text-stone-700 underline" %>
    </section>
  <% else %>
    <section class="mx-auto max-w-6xl rounded-md border border-rose-200 bg-rose-50 p-5"
             data-poll-session-terminal>
      <p class="text-lg font-medium text-rose-800"><%= message %></p>
    </section>
  <% end %>
<% end %>
