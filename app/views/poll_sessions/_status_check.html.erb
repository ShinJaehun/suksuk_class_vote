<section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm"
         data-testid="poll-session-status-check">
  <% if status_check.valid? %>
    <% if status_check.phase == :closed %>
      <h2 class="text-lg font-semibold">상태 점검: 종료됨</h2>
      <p class="mt-2 text-sm text-stone-600">이 학급 투표는 완료되었습니다.</p>
    <% else %>
      <h2 class="text-lg font-semibold">상태 점검: 이상 없음</h2>
      <p class="mt-2 text-sm text-stone-600">
        <%= status_check.phase == :draft ? "투표를 시작할 수 있습니다." : "진행 상태가 정상입니다." %>
      </p>
    <% end %>
  <% else %>
    <h2 class="text-lg font-semibold">상태 점검: 확인 필요</h2>
    <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-amber-700">
      <% status_check.issues.each do |issue| %>
        <li><%= issue %></li>
      <% end %>
    </ul>
  <% end %>

  <% unless status_check.phase == :draft %>
    <dl class="mt-5 grid gap-3 sm:grid-cols-5">
      <% {
           "전체 투표자" => status_check.total_count,
           "투표 완료" => status_check.completed_count,
           "미참여" => status_check.absent_count,
           "기권" => status_check.abstained_count,
           "대기" => status_check.pending_count
         }.each do |label, count| %>
        <div class="rounded-md bg-stone-50 p-3 text-center">
          <dt class="text-sm text-stone-500"><%= label %></dt>
          <dd class="mt-1 font-semibold"><%= count %>명</dd>
        </div>
      <% end %>
    </dl>
  <% end %>
</section>
