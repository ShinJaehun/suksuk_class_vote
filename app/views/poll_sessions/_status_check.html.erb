<section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm"
         data-testid="poll-session-status-check">
  <% parent_allows_start = !poll_session.poll.school_managed? || poll_session.poll.in_progress? %>
  <% start_action_available = parent_allows_start && status_check.startable? && can_operate %>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="text-xl font-semibold">상태점검</h2>
        <% if !poll_session.draft? || start_action_available %>
          <%= poll_session_status_badge(poll_session) %>
        <% end %>
      </div>
      <% session_time_labels = poll_session_status_time_labels(poll_session).map { |label| label.sub(/\A(?:재투표|투표) /, "") } %>
      <% if session_time_labels.any? %>
        <p class="mt-2 text-sm text-stone-600"><%= session_time_labels.join(" · ") %></p>
      <% end %>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <% if start_action_available %>
        <%= button_to "투표 시작", start_poll_poll_session_path(poll_session.poll, poll_session),
                      method: :post,
                      params: poll_session_context_params(poll_session, from: local_assigns[:navigation_context]),
                      form: { data: { turbo_frame: "_top" } },
                      data: { turbo_confirm: poll_session.replacement? ?
                        "현재 투표자 명단으로 투표를 시작할까요?" :
                        "현재 활성 학생 명단으로 투표를 시작할까요?" },
                      class: "rounded-md bg-emerald-600 px-5 py-3 text-sm font-semibold text-white" %>
      <% end %>
      <% if can_stop %>
        <%= button_to "투표 중단", stop_poll_poll_session_path(poll_session.poll, poll_session),
                      method: :patch, form: { data: { turbo_frame: "_top" } },
                      data: { turbo_confirm: "현재 투표 실행을 중단할까요? 지금까지의 진행 기록은 보존되며 이 실행에서는 더 이상 투표를 계속할 수 없습니다." },
                      class: "rounded-md bg-rose-700 px-4 py-2 text-sm font-semibold text-white" %>
      <% end %>
      <% if can_revote %>
        <%= button_to "재투표 시작 준비", revote_poll_poll_session_path(poll_session.poll, poll_session),
                      method: :post, form: { data: { turbo_frame: "_top" } },
                      data: { turbo_confirm: "기존 진행 기록과 결과를 보존하고 같은 투표자 명단으로 새 재투표 실행을 만들까요?" },
                      class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-semibold text-white" %>
      <% end %>
    </div>
  </div>

  <% if poll_session.stopped? %>
    <p class="mt-4 font-medium text-rose-700">이 학급 투표는 중단되었으며 진행 기록은 보존됩니다.</p>
  <% elsif !status_check.valid? %>
    <div class="mt-4 rounded-md border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
      <p class="font-medium"><%= status_check.phase == :draft ? "시작 전 확인이 필요합니다." : "진행 상태 확인이 필요합니다." %></p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% status_check.issues.each do |issue| %>
          <li><%= issue %></li>
        <% end %>
      </ul>
    </div>
  <% elsif status_check.phase == :closed %>
    <p class="mt-4 font-medium text-emerald-700">이 학급 투표는 완료되었습니다.</p>
  <% elsif status_check.phase == :in_progress %>
    <p class="mt-4 font-medium text-emerald-700">투표가 정상적으로 진행 중입니다.</p>
  <% elsif poll_session.poll.school_managed? && poll_session.poll.draft? %>
    <p class="mt-4 font-medium text-emerald-700">전교투표가 시작되면 이 학급 투표를 시작할 수 있습니다.</p>
  <% else %>
    <p class="mt-4 font-medium text-emerald-700">투표를 시작할 수 있습니다.</p>
  <% end %>

  <% unless status_check.phase == :draft %>
    <% counts = {
         "투표 대상자" => status_check.total_count,
         "투표 완료" => status_check.completed_count + status_check.abstained_count,
         "미참여" => status_check.absent_count,
         "대기" => status_check.pending_count
       } %>
    <dl class="mt-5 grid gap-3 text-sm sm:grid-cols-4">
      <% counts.each do |label, count| %>
        <div class="rounded-md bg-stone-50 p-3">
          <dt class="text-stone-500"><%= label %></dt>
          <dd class="mt-1 text-xl font-semibold"><%= count %>명</dd>
        </div>
      <% end %>
    </dl>
  <% end %>

</section>
