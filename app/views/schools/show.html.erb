<section class="rounded-md border border-stone-200 bg-white p-5">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-stone-500">학교 운영 현황</p>
      <div class="mt-1 flex flex-wrap items-center gap-2">
        <h1 class="text-2xl font-semibold"><%= @school.name %></h1>
        <span class="rounded-full px-2.5 py-1 text-xs font-medium <%= @school.active? ? 'bg-emerald-50 text-emerald-700' : 'bg-stone-100 text-stone-600' %>"><%= @school.active? ? "활성" : "비활성" %></span>
      </div>
    </div>
    <div class="flex gap-3 text-sm font-medium">
      <%= link_to "학교 목록", schools_path, class: "underline" %>
      <% if policy(@school).edit? %>
        <%= link_to "학교 정보 수정", edit_school_path(@school), class: "underline" %>
      <% end %>
    </div>
  </div>
  <dl class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-md bg-stone-50 p-4">
      <dt class="text-sm text-stone-500">선생님</dt>
      <dd class="mt-1 text-lg font-semibold"><%= @active_teacher_count %>명</dd>
    </div>
    <div class="rounded-md bg-stone-50 p-4">
      <dt class="text-sm text-stone-500">교실</dt>
      <dd class="mt-1 text-lg font-semibold"><%= @active_classroom_count %>학급</dd>
    </div>
    <div class="rounded-md bg-stone-50 p-4">
      <dt class="text-sm text-stone-500">학생</dt>
      <dd class="mt-1 text-lg font-semibold"><%= @active_student_count %>명</dd>
    </div>
    <div class="rounded-md bg-stone-50 p-4">
      <dt class="text-sm text-stone-500">대표 선생님</dt>
      <dd class="mt-1 text-lg font-semibold"><%= @manager&.name || "미지정" %></dd>
    </div>
  </dl>
</section>

<section class="rounded-md border border-stone-200 bg-white p-5">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="text-lg font-semibold">선생님</h2>
      <p class="mt-1 text-sm text-stone-500">학교별 선생님 현황을 확인합니다.</p>
    </div>
    <% if policy(User).index? %>
      <%= link_to "선생님 관리",
                  teachers_path(school_id: @school.id, grade: @teacher_grade),
                  class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  </div>
  <div class="mt-4 flex flex-wrap gap-2">
    <% [["전체", "all"], *1.upto(6).map { |grade| ["#{grade}학년", grade.to_s] }, ["미배정", "unassigned"]].each do |label, grade| %>
      <%= link_to label,
                  school_path(@school, teacher_grade: grade, classroom_grade: @classroom_grade),
                  class: "rounded-md border px-3 py-2 text-sm font-medium #{@teacher_grade == grade ? 'border-stone-900 bg-stone-900 text-white' : 'border-stone-300 bg-white'}" %>
    <% end %>
  </div>
  <%= render "teachers/school_overview", teachers: @teachers %>
</section>

<section class="rounded-md border border-stone-200 bg-white p-5">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="text-lg font-semibold">교실</h2>
      <p class="mt-1 text-sm text-stone-500">학교별 교실 현황을 확인합니다.</p>
    </div>
    <%= link_to "교실 관리",
                classrooms_path(school_id: @school.id, grade: @classroom_grade),
                class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  </div>
  <div class="mt-4 flex flex-wrap gap-2">
    <% [["전체", "all"], *1.upto(6).map { |grade| ["#{grade}학년", grade.to_s] }].each do |label, grade| %>
      <%= link_to label,
                  school_path(@school, teacher_grade: @teacher_grade, classroom_grade: grade),
                  class: "rounded-md border px-3 py-2 text-sm font-medium #{@classroom_grade == grade ? 'border-stone-900 bg-stone-900 text-white' : 'border-stone-300 bg-white'}" %>
    <% end %>
  </div>
  <%= render "classrooms/school_overview", classrooms: @classrooms, active_student_counts: @active_student_counts %>
</section>
