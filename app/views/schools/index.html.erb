<div class="flex items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold">학교</h1>
    <p class="mt-1 text-sm text-stone-600">학교에서 교실과 선생님 관리를 시작합니다.</p>
  </div>
  <% if policy(School).create? %>
    <%= link_to "학교 생성",
                new_school_path,
                class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  <% end %>
</div>

<% if @schools.any? %>
  <ul class="space-y-3">
    <% @schools.each do |school| %>
      <% managers = school.school_memberships.select(&:manager?) %>
      <li class="rounded-md border border-stone-200 bg-white p-5">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="font-semibold"><%= school.name %></h2>
            <p class="mt-1 text-sm text-stone-600"><%= school.classrooms.size %>학급(<%= @school_student_counts.fetch(school.id, 0) %>명) · 소속 선생님 <%= school.school_memberships.size %>명</p>
            <p class="mt-1 text-sm text-stone-500">대표 선생님: <%= managers.any? ? managers.map { |membership| membership.user.name }.join(", ") : "없음" %></p>
          </div>
          <%= link_to "학교 상세", school_path(school), class: "text-sm font-medium underline" %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="rounded-md border border-dashed border-stone-300 bg-white p-8 text-center">등록된 학교가 없습니다.</div>
<% end %>
