<div class="mx-auto max-w-3xl space-y-6">
  <div>
    <%= link_to "전교투표로 돌아가기", school_poll_path(@source_poll),
                class: "text-sm font-medium text-stone-600 underline" %>
    <h1 class="mt-3 text-2xl font-bold">테스트투표 만들기</h1>
  </div>

  <section class="space-y-4 rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center gap-2">
      <h2 class="text-xl font-semibold"><%= @source_poll.title %></h2>
      <%= poll_badges(poll: @source_poll, status_record: @source_poll) %>
    </div>
    <p class="text-sm text-stone-600">
      원본 전교투표는 준비 상태로 유지됩니다. 테스트할 학급을 선택하세요.
    </p>

    <% if @error_message.present? %>
      <p class="rounded-md border border-rose-200 bg-rose-50 p-3 text-sm text-rose-800"><%= @error_message %></p>
    <% end %>

    <%= form_with url: school_poll_test_polls_path(@source_poll), class: "space-y-4" do %>
      <div class="space-y-3">
        <% @source_sessions.each do |session| %>
          <label class="flex items-center gap-3 rounded-md border border-stone-200 p-3">
            <%= check_box_tag "classroom_ids[]", session.classroom_id, false,
                              class: "rounded border-stone-300" %>
            <span><%= session.classroom_name_snapshot %> · 담임 <%= session.operator_name_snapshot %></span>
          </label>
        <% end %>
      </div>
      <div class="flex flex-wrap justify-end gap-3">
        <%= link_to "취소", school_poll_path(@source_poll),
                    class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-700" %>
        <%= submit_tag "테스트투표 만들기",
                       class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-semibold text-white" %>
      </div>
    <% end %>
  </section>
</div>
