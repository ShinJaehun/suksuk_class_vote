<div class="mt-5 overflow-x-auto rounded-md border border-stone-200">
  <table class="min-w-full divide-y divide-stone-200 text-sm">
    <thead class="bg-stone-50">
      <tr>
        <th class="p-3 text-left">학년</th>
        <th class="p-3 text-left">반</th>
        <th class="p-3 text-left">담임</th>
        <th class="p-3 text-left">학생</th>
        <th class="p-3 text-left">상태</th>
        <th class="p-3 text-left">관리</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-stone-100">
      <% classrooms.each do |classroom| %>
        <tr id="<%= dom_id(classroom, :overview_row) %>">
          <td class="p-3"><%= classroom.grade %>학년</td>
          <td class="p-3"><%= classroom.formatted_class_label %></td>
          <td class="p-3"><%= classroom.teacher&.name || "미배정" %></td>
          <td class="p-3"><%= active_student_counts.fetch(classroom.id, 0) %>명</td>
          <td class="p-3"><%= classroom.active? ? "활성" : "비활성" %></td>
          <td class="p-3">
            <div class="flex flex-wrap gap-3 font-medium">
              <% if policy(classroom).edit? %>
                <%= link_to "교실 설정", edit_classroom_path(classroom), class: "underline" %>
              <% end %>
              <% if policy(classroom).manage_students? %>
                <%= link_to "교실 바로가기", classroom_students_path(classroom), class: "underline" %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
    <tfoot class="border-t border-stone-200 bg-stone-50">
      <tr>
        <td colspan="6" class="p-3 text-right text-sm font-medium text-stone-600">
          총 <%= classrooms.size %>학급 · 학생 <%= classrooms.sum { |classroom| active_student_counts.fetch(classroom.id, 0) } %>명
        </td>
      </tr>
    </tfoot>
  </table>
</div>
<% unless classrooms.any? %>
  <p class="mt-3 text-sm text-stone-600">등록된 교실이 없습니다.</p>
<% end %>
