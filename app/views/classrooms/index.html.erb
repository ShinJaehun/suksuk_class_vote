<div class="space-y-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold">교실 관리</h1>
      <p class="mt-1 text-sm text-stone-600">학교 교실 정보를 관리합니다.</p>
    </div>

    <% if policy(Classroom).create? %>
      <div class="flex flex-wrap gap-2">
        <%= link_to "교실 생성", new_classroom_path, class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
        <%= link_to "여러 교실 생성", bulk_setup_classrooms_path, class: "rounded-md border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-700" %>
      </div>
    <% end %>
  </div>

  <% if current_user.admin? %>
    <%= form_with url: classrooms_path,
                  method: :get,
                  class: "flex max-w-xl items-end gap-3 rounded-md border border-stone-200 bg-white p-4",
                  data: { controller: "autosubmit", turbo_frame: "classroom_management", turbo_action: "advance", action: "change->autosubmit#submit" } do |form| %>
      <%= hidden_field_tag :grade, "all" %>
      <div class="flex-1">
        <%= form.label :school_id, "학교 필터", class: "block text-sm font-medium" %>
        <%= form.select :school_id,
                        options_from_collection_for_select(@schools, :id, :name, @school&.id),
                        { prompt: "학교를 선택하세요" },
                        class: "mt-1 w-full rounded-md border-stone-300" %>
      </div>
    <% end %>
  <% end %>

  <%= turbo_frame_tag "classroom_management", data: { turbo_action: "advance" } do %>
    <% if @school %>
      <%= render "classrooms/management" %>
    <% elsif current_user.teacher? && !current_user.school_membership&.manager? %>
      <p class="rounded-md border border-dashed border-stone-300 bg-white p-8 text-center text-sm text-stone-600">배정된 교실이 없습니다.</p>
    <% else %>
      <p class="rounded-md border border-dashed border-stone-300 bg-white p-8 text-center text-sm text-stone-600">관리할 학교를 선택해 주세요.</p>
    <% end %>
  <% end %>
</div>
