<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div><h1 class="text-2xl font-semibold">교실</h1><p class="mt-1 text-sm text-stone-600">학급과 학생 명단을 관리합니다.</p></div>
  <% if policy(Classroom).create? %>
    <%= link_to "교실 생성", new_classroom_path, class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
  <% end %>
</div>

<% if current_user.admin? %>
  <%= form_with url: classrooms_path, method: :get, class: "flex items-end gap-3 rounded-md border border-stone-200 bg-white p-4" do |form| %>
    <div class="flex-1"><%= form.label :school_id, "학교 필터", class: "block text-sm font-medium" %><%= form.collection_select :school_id, @schools, :id, :name, { include_blank: "전체 학교", selected: params[:school_id] }, class: "mt-1 w-full rounded-md border-stone-300" %></div>
    <%= form.submit "적용", class: "rounded-md border border-stone-300 px-4 py-2 text-sm font-medium" %>
  <% end %>
<% end %>

<% if @classrooms.any? %>
  <ul class="space-y-3">
    <% @classrooms.each do |classroom| %>
      <li class="rounded-md border border-stone-200 bg-white p-5">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="space-y-1">
            <p class="text-sm text-stone-500"><%= classroom.school.name %></p>
            <h2 class="font-semibold"><%= classroom.school_year %>학년도 <%= classroom.grade %>학년 <%= classroom.formatted_class_label %></h2>
            <p class="text-sm text-stone-600">담임 <%= classroom.teacher&.name.presence || "미지정" %> · 학생 <%= @classroom_active_student_counts.fetch(classroom.id, 0) %>/<%= @classroom_student_counts.fetch(classroom.id, 0) %>명</p>
            <span class="inline-flex rounded px-2 py-1 text-xs font-medium <%= classroom.active? ? "bg-emerald-100 text-emerald-700" : "bg-stone-200 text-stone-600" %>"><%= classroom.active? ? "활성" : "비활성" %></span>
          </div>
          <div class="flex gap-3 text-sm font-medium">
            <% if policy(classroom).manage_students? %><%= link_to "학생 관리", classroom_students_path(classroom), class: "underline" %><% end %>
            <% if policy(classroom).edit? %><%= link_to "교실 설정", edit_classroom_path(classroom), class: "underline" %><% end %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="rounded-md border border-dashed border-stone-300 bg-white p-8 text-center">
    <% if current_user.teacher? && !current_user.school_membership&.manager? %>
      <p class="font-medium">배정된 교실이 없습니다.</p><p class="mt-1 text-sm text-stone-600">학교 관리자에게 담임 배정을 요청해 주세요.</p>
    <% else %>
      <p class="font-medium">등록된 교실이 없습니다.</p><p class="mt-1 text-sm text-stone-600">교실을 만들어 학생 명단을 준비해 주세요.</p>
    <% end %>
  </div>
<% end %>
